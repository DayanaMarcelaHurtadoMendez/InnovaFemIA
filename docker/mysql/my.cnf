# ==============================================================================
# InnovaFemIA - Configuración Personalizada de MySQL 8.0
# ==============================================================================
# Este archivo es montado en /etc/mysql/conf.d/custom.cnf en modo solo lectura (:ro).
# Optimiza el motor para el almacenamiento de medios en BD (LONGBLOB) y codificación UTF-8.

[mysqld]
# Autenticación compatible con drivers MySqlConnector / Pomelo EF Core
default-authentication-plugin = mysql_native_password

# Soporte completo para emojis, caracteres especiales y tildes en español
character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_ci

# Límite máximo de paquetes (512 MB) para soportar subidas de videos y archivos pesados
max_allowed_packet            = 536870912

# Timeouts ampliados para conexiones de larga duración durante procesamiento
wait_timeout                  = 28800
interactive_timeout           = 28800

# Ajustes de rendimiento InnoDB
innodb_buffer_pool_size       = 536870912
innodb_file_per_table         = 1

# Modo SQL estándar y seguro
sql_mode                      = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

[client]
default-character-set         = utf8mb4

[mysql]
default-character-set         = utf8mb4
