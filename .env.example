# ==============================================================================
# InnovaFemIA - Archivo de Configuración de Entorno (.env)
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env': cp .env.example .env
# 2. Defina contraseñas seguras para la base de datos y el administrador.
# 3. Ajuste los puertos según la disponibilidad y el proxy inverso del servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUERTOS DEL SISTEMA (HOST)
# ------------------------------------------------------------------------------
# Puerto en el servidor host donde responderá la aplicación Web (.NET 9)
# Si usa Nginx/Traefik/Cloudflare como Proxy Inverso, apunte a este puerto.
APP_PORT=8080

# Puerto en el servidor host para la base de datos MySQL 8.0
# RECOMENDACIÓN DE SEGURIDAD: Usar '127.0.0.1:3306' para no exponer la BD a internet,
# o dejar '3306' si requiere conexión externa remota directa (ej. DBeaver, Workbench).
DB_PORT=127.0.0.1:3306

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS MYSQL 8.0
# ------------------------------------------------------------------------------
DB_DATABASE=InnovaFemIA
DB_USER=innovafemia_user
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_SEGURA_DB_2026!
DB_ROOT_PASSWORD=CAMBIAR_ESTA_CONTRASENA_ROOT_SEGURA_2026!

# ------------------------------------------------------------------------------
# 3. ENTORNO DE ASP.NET CORE
# ------------------------------------------------------------------------------
# Opciones: 'Production' (Recomendado para servidores) o 'Development'
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------------------------
# 4. ADMINISTRADOR POR DEFECTO DEL SISTEMA (SEED AUTOMÁTICO)
# ------------------------------------------------------------------------------
# Credenciales iniciales creadas en el primer arranque si no existen en la BD.
ADMIN_USER=admin
ADMIN_PASSWORD=CambiarEstaContrasena123!
ADMIN_EMAIL=admin@innovafemia.local
