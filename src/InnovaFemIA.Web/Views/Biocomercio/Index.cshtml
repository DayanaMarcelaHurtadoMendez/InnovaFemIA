@model InnovaFemIA.Web.Features.Biocomercio.ObtenerPrecios.PreciosSipsaViewModel
@{
    ViewData["Title"] = "Portal de Biocomercio — InnovaFemIA";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Encabezado de Bienvenida al Portal de Biocomercio -->
    <div class="bg-gradient-to-r from-emerald-900 via-verde to-teal-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm text-xs font-bold text-emerald-200 mb-2">
                    <span>🌿</span> Portal de Biocomercio y Saberes Campesinos
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                    Herramientas Productivas para Familias de Caldono
                </h1>
                <p class="text-xs sm:text-sm text-emerald-100 max-w-2xl mt-1 leading-relaxed">
                    Planifica tus labores agrícolas, mantén al día la disponibilidad de tus cosechas para el mapa territorial y diagnostica la salud de tus plantas de café mediante visión artificial.
                </p>
            </div>
            <div class="shrink-0 flex items-center gap-2">
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/15 backdrop-blur-md text-xs sm:text-sm font-bold text-white border border-white/20">
                    <span>👩‍🌾</span>
                    <span>@(User.Identity?.Name ?? "Familia Productora")</span>
                </span>
            </div>
        </div>
    </div>

    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <!-- SECCIÓN 1: MÓDULOS Y HERRAMIENTAS (UBICADAS POR FUERA DEL BLOQUE DE PRECIOS) -->
    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-lg font-black text-gray-900 flex items-center gap-2">
                    <span>🚀</span> Módulos y Acciones Principales
                </h2>
                <p class="text-xs text-gray-500">Selecciona la herramienta que deseas utilizar en tu jornada</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <!-- Botón / Card 1: Calculadoras -->
            <a href="~/biocomercio/calculadoras" class="group bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl hover:border-emerald-300 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-verde flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                        🧮
                    </div>
                    <div>
                        <h3 class="font-black text-gray-900 text-base group-hover:text-verde transition-colors">
                            Calculadoras y Guías
                        </h3>
                        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                            Calcula rendimientos de café (factor de rendimiento, mermas), costos de producción y tiempos óptimos de cosecha basados en Cenicafé y Agrosavia.
                        </p>
                    </div>
                </div>
                <div class="pt-4 mt-4 border-t border-gray-50 flex items-center justify-between text-xs font-bold text-verde">
                    <span>Ingresar a Calculadoras</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
            </a>

            <!-- Botón / Card 2: Mi Stock -->
            <a href="~/biocomercio/mi-stock" class="group bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl hover:border-amber-300 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                        📦
                    </div>
                    <div>
                        <h3 class="font-black text-gray-900 text-base group-hover:text-amber-700 transition-colors">
                            Mi Stock de Productos
                        </h3>
                        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                            Actualiza los cultivos y cosechas que tu familia tiene disponibles para la venta. Esta información alimenta los pines del mapa interactivo territorial.
                        </p>
                    </div>
                </div>
                <div class="pt-4 mt-4 border-t border-gray-50 flex items-center justify-between text-xs font-bold text-amber-700">
                    <span>Administrar Mi Stock</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
            </a>

            <!-- Botón / Card 3: Detección de Enfermedades -->
            <a href="~/biocomercio/deteccion-enfermedades" class="group bg-gradient-to-br from-white to-purple-50/40 p-6 rounded-3xl border border-purple-100 shadow-sm hover:shadow-xl hover:border-purple-300 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
                <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-purple-100 text-purple-700 border border-purple-200 shadow-xs">
                        🍃 Sanidad Vegetal
                    </span>
                </div>
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                        🔬
                    </div>
                    <div>
                        <h3 class="font-black text-gray-900 text-base group-hover:text-purple-700 transition-colors">
                            Detección de Enfermedades
                        </h3>
                        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                            Toma una fotografía con tu cámara o sube una imagen de hojas de café para analizar si presenta signos de roya, minador u otras afectaciones en tu cultivo.
                        </p>
                    </div>
                </div>
                <div class="pt-4 mt-4 border-t border-purple-100/60 flex items-center justify-between text-xs font-bold text-purple-700">
                    <span>Analizar hojas de café</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
            </a>
        </div>
    </div>

    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <!-- SECCIÓN 2: BLOQUE INDEPENDIENTE DE PRECIOS DE MERCADO                         -->
    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <div class="space-y-4 pt-4 border-t border-gray-200">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xl">📊</span>
                    <h2 class="text-xl font-black text-gray-900">Precios de Mercado de Referencia</h2>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-50 text-verde border border-emerald-200">DANE SIPSA</span>
                </div>
                <p class="text-xs text-gray-500 mt-1">
                    Última actualización de boletín mayorista: <strong>@Model.UltimaActualizacion.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong>
                </p>
            </div>
            <div class="text-xs text-gray-400 font-medium">
                Mercados de referencia: Popayán / Cali (Cavasa)
            </div>
        </div>

        @if (Model.BoletinActual == null || !Model.BoletinActual.EsReciente)
        {
            <div class="bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 rounded-2xl text-xs sm:text-sm flex gap-3 shadow-sm">
                <div class="text-xl shrink-0">⚠️</div>
                <div>
                    <strong>Aviso de actualización:</strong> 
                    La información de precios mostrada podría presentar desfase respecto a la última semana debido a la disponibilidad de boletines en el portal oficial del DANE SIPSA.
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (Model.PreciosCultivos.Any())
            {
                @foreach(var p in Model.PreciosCultivos)
                {
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-2xl bg-gray-50 flex items-center justify-center text-2xl border border-gray-100">
                                    @p.IconoCultivo
                                </div>
                                <div>
                                    <h3 class="font-black text-gray-900 text-lg">@p.NombreCultivo</h3>
                                    <p class="text-xs font-medium text-gray-500">@p.MercadoReferencia</p>
                                </div>
                            </div>
                            
                            @if (p.EstadoVariacion == "Sube")
                            {
                                <span class="px-2 py-1 bg-rose-50 text-rose-600 rounded-lg text-xs font-bold border border-rose-100 flex items-center gap-1">
                                    ↑ Sube
                                </span>
                            }
                            else if (p.EstadoVariacion == "Baja")
                            {
                                <span class="px-2 py-1 bg-emerald-50 text-emerald-600 rounded-lg text-xs font-bold border border-emerald-100 flex items-center gap-1">
                                    ↓ Baja
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-gray-50 text-gray-600 rounded-lg text-xs font-bold border border-gray-200 flex items-center gap-1">
                                    = Igual
                                </span>
                            }
                        </div>

                        <div class="mb-4">
                            <div class="text-3xl font-black text-gray-900">
                                @p.Precio.ToString("C0") <span class="text-sm font-medium text-gray-400">/ kg</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center text-xs text-gray-500 pt-4 border-t border-gray-50">
                            <div>Mín: <strong>@p.PrecioMinimo.ToString("C0")</strong></div>
                            <div>Máx: <strong>@p.PrecioMaximo.ToString("C0")</strong></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full p-12 text-center bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 text-gray-500">
                    <div class="text-4xl mb-3">📊</div>
                    <p class="font-medium text-sm">No fue posible obtener los precios en este momento.<br/>Intente nuevamente más tarde.</p>
                </div>
            }
        </div>
    </div>
</div>
