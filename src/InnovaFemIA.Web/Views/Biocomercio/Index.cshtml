@model InnovaFemIA.Web.Features.Mapa.ObtenerPrecios.PreciosSipsaViewModel
@{
    ViewData["Title"] = "Dashboard de Biocomercio";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <h1 class="text-2xl font-black text-gray-900 mb-1">Precios de Mercado</h1>
            <p class="text-sm text-gray-500">Última actualización: @Model.UltimaActualizacion.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
        </div>
        
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
            <a href="/biocomercio/calculadoras" class="px-5 py-2.5 bg-emerald-100 text-verde hover:bg-emerald-200 rounded-xl text-sm font-bold shadow-sm transition-all text-center">
                🧮 Ir a Calculadoras
            </a>
            <a href="/biocomercio/mi-stock" class="px-5 py-2.5 bg-naranja hover:bg-orange-600 text-white rounded-xl text-sm font-bold shadow-sm transition-all text-center">
                📦 Mi Stock
            </a>
        </div>
    </div>

    @if (Model.BoletinActual == null || !Model.BoletinActual.EsReciente)
    {
        <div class="bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 rounded-2xl text-sm flex gap-3">
            <div class="text-xl">⚠️</div>
            <div>
                <strong>Aviso de desactualización:</strong> 
                La información mostrada podría no estar actualizada debido a problemas temporales con el sistema DANE SIPSA.
            </div>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model.PreciosCultivos.Any())
        {
            @foreach(var p in Model.PreciosCultivos)
            {
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-gray-50 flex items-center justify-center text-2xl border border-gray-100">
                                @p.IconoCultivo
                            </div>
                            <div>
                                <h3 class="font-black text-gray-900 text-lg">@p.NombreCultivo</h3>
                                <p class="text-xs font-medium text-gray-500">@p.MercadoReferencia</p>
                            </div>
                        </div>
                        
                        @if (p.EstadoVariacion == "Sube")
                        {
                            <span class="px-2 py-1 bg-rose-50 text-rose-600 rounded-lg text-xs font-bold border border-rose-100 flex items-center gap-1">
                                ↑ Sube
                            </span>
                        }
                        else if (p.EstadoVariacion == "Baja")
                        {
                            <span class="px-2 py-1 bg-emerald-50 text-emerald-600 rounded-lg text-xs font-bold border border-emerald-100 flex items-center gap-1">
                                ↓ Baja
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 bg-gray-50 text-gray-600 rounded-lg text-xs font-bold border border-gray-200 flex items-center gap-1">
                                = Igual
                            </span>
                        }
                    </div>

                    <div class="mb-4">
                        <div class="text-3xl font-black text-gray-900">
                            @p.Precio.ToString("C0") <span class="text-sm font-medium text-gray-400">/ kg</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center text-xs text-gray-500 pt-4 border-t border-gray-50">
                        <div>Mín: <strong>@p.PrecioMinimo.ToString("C0")</strong></div>
                        <div>Máx: <strong>@p.PrecioMaximo.ToString("C0")</strong></div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full p-12 text-center bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 text-gray-500">
                <div class="text-4xl mb-3">📊</div>
                <p class="font-medium">No fue posible obtener los precios en este momento.<br/>Intente nuevamente más tarde.</p>
            </div>
        }
    </div>
</div>
