@model IEnumerable<InnovaFemIA.Web.Features.Biocomercio.Calculadoras.CultivoTiempoDto>
@using System.Text.Json
@{
    ViewData["Title"] = "Calculadoras de Biocomercio";
    Layout = "_Layout";

    // Agrupar tiempos por cultivo para poblar selects
    var cultivosUnicos = Model.Select(x => new { x.CultivoId, x.NombreCultivo }).Distinct().ToList();
    var jsonTiempos = JsonSerializer.Serialize(Model);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="/biocomercio/index" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🧮</span> Calculadoras
            </h1>
            <p class="text-sm text-gray-500">Herramientas prácticas para proyectar tus cosechas y evaluar rentabilidad.</p>
        </div>
    </div>

    <!-- Pestañas (Navegación) -->
    <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-2">
        <button onclick="mostrarCalculadora('cosecha', this)" class="tab-btn px-5 py-2.5 bg-emerald-100 text-verde rounded-t-xl text-sm font-bold shadow-sm transition-all text-center">
            🌱 Cosecha
        </button>
        <button onclick="mostrarCalculadora('rentabilidad', this)" class="tab-btn px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-t-xl text-sm font-bold transition-all text-center">
            💰 Rentabilidad
        </button>
        <button onclick="mostrarCalculadora('conversion', this)" class="tab-btn px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-t-xl text-sm font-bold transition-all text-center">
            ☕ Conversión de Café
        </button>
    </div>

    <!-- CALCULADORA DE COSECHA -->
    <div id="calc-cosecha" class="calc-section bg-white p-6 sm:p-8 rounded-b-3xl rounded-tr-3xl border border-gray-100 shadow-sm transition-all duration-300">
        <h2 class="text-xl font-black text-gray-900 mb-6">Calculadora de Cosecha</h2>
        
        <form id="formCosecha" class="space-y-6 max-w-xl" onsubmit="calcularCosecha(event)">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">¿Qué cultivo?</label>
                <select id="cultivoCosecha" required class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 outline-none transition-all" onchange="actualizarActividades()">
                    <option value="">Selecciona un cultivo...</option>
                    @foreach (var c in cultivosUnicos)
                    {
                        <option value="@c.NombreCultivo">@c.NombreCultivo</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">¿Qué actividad?</label>
                <select id="actividadCosecha" required class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 outline-none transition-all">
                    <option value="">Primero selecciona un cultivo...</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">¿En qué fecha lo hiciste?</label>
                <input type="date" id="fechaCosecha" required max="@DateTime.Now.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 outline-none transition-all" />
                <p class="text-xs text-gray-400 mt-1">La fecha no puede ser en el futuro.</p>
            </div>

            <button type="submit" class="w-full bg-verde hover:bg-emerald-700 text-white font-black text-lg py-4 rounded-2xl shadow-lg transition-all active:scale-95">
                Calcular Cosecha
            </button>
        </form>

        <div id="resultadoCosecha" class="hidden mt-8 p-6 bg-emerald-50 border border-emerald-200 rounded-3xl space-y-4">
            <h3 class="font-black text-lg text-emerald-900">Resultado Estimado</h3>
            <p id="textoCosecha" class="text-gray-800 text-sm font-medium"></p>
            <div class="flex items-start gap-2 bg-white p-4 rounded-2xl border border-emerald-100 shadow-sm text-sm text-gray-600">
                <span>🌒</span> 
                <span><strong>Sugerencia:</strong> Consulta el calendario lunar del Mapa Interactivo para elegir el mejor momento dentro de ese mes.</span>
            </div>
        </div>
    </div>

    <!-- CALCULADORA DE RENTABILIDAD -->
    <div id="calc-rentabilidad" class="calc-section hidden bg-white p-6 sm:p-8 rounded-b-3xl rounded-tr-3xl border border-gray-100 shadow-sm transition-all duration-300">
        <h2 class="text-xl font-black text-gray-900 mb-6">Calculadora de Rentabilidad (Ganancia o Pérdida)</h2>
        
        <form id="formRentabilidad" class="max-w-2xl" onsubmit="calcularRentabilidad(event)">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Gastos -->
                <div class="space-y-4">
                    <h3 class="font-bold text-rose-600 border-b border-rose-100 pb-2">Tus Gastos ($)</h3>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Siembra</label>
                        <input type="text" inputmode="numeric" id="gastoSiembra" placeholder="0" class="dinero-input w-full px-4 py-2 rounded-xl border border-gray-200 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Abonado</label>
                        <input type="text" inputmode="numeric" id="gastoAbonado" placeholder="0" class="dinero-input w-full px-4 py-2 rounded-xl border border-gray-200 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Poda</label>
                        <input type="text" inputmode="numeric" id="gastoPoda" placeholder="0" class="dinero-input w-full px-4 py-2 rounded-xl border border-gray-200 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Control Plagas</label>
                        <input type="text" inputmode="numeric" id="gastoPlagas" placeholder="0" class="dinero-input w-full px-4 py-2 rounded-xl border border-gray-200 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Otros gastos</label>
                        <input type="text" inputmode="numeric" id="gastoOtros" placeholder="0" class="dinero-input w-full px-4 py-2 rounded-xl border border-gray-200 text-sm" />
                    </div>
                </div>

                <!-- Ingresos y Resultado -->
                <div class="space-y-6">
                    <div class="space-y-4">
                        <h3 class="font-bold text-emerald-600 border-b border-emerald-100 pb-2">Tus Ingresos ($)</h3>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Ingreso por venta (Obligatorio)</label>
                            <input type="text" inputmode="numeric" id="ingresoVenta" required class="dinero-input w-full px-4 py-3 rounded-xl border-2 border-emerald-200 focus:border-emerald-500 outline-none text-lg font-black text-gray-800" />
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-gray-900 hover:bg-black text-white font-black py-4 rounded-2xl shadow-md transition-all active:scale-95">
                        Calcular Balance
                    </button>
                    
                    <div id="resultadoRentabilidad" class="hidden rounded-3xl p-6 text-center text-white font-black shadow-lg">
                        <div class="text-sm uppercase tracking-widest mb-1 opacity-80" id="rentabilidadTitulo"></div>
                        <div class="text-3xl" id="rentabilidadMonto"></div>
                        <div class="text-xs mt-4 bg-black/20 rounded-lg p-2 font-medium">
                            Ingresos: <span id="lblIngresos"></span> | Gastos: <span id="lblGastos"></span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- CALCULADORA DE CONVERSION -->
    <div id="calc-conversion" class="calc-section hidden bg-white p-6 sm:p-8 rounded-b-3xl rounded-tr-3xl border border-gray-100 shadow-sm transition-all duration-300">
        <h2 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-2">
            ☕ Conversión de Café
        </h2>
        
        <form id="formConversion" class="max-w-xl space-y-6" onsubmit="calcularConversion(event)">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Kilos de Café Cereza recogidos</label>
                <div class="relative">
                    <input type="number" id="kilosCereza" required min="0.1" step="0.1"
                           class="w-full px-4 py-4 rounded-2xl border-2 border-gray-200 focus:border-orange-500 outline-none text-2xl font-black text-gray-800 transition-all"
                           placeholder="0.0" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-5 pointer-events-none text-gray-400 font-bold">
                        Kg
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-naranja hover:bg-orange-600 text-white font-black text-lg py-4 rounded-2xl shadow-lg transition-all active:scale-95">
                Estimar Conversión
            </button>
        </form>

        <div id="resultadoConversion" class="hidden mt-8 grid grid-cols-2 gap-4">
            <div class="bg-gray-50 border border-gray-200 rounded-3xl p-6 text-center">
                <div class="text-3xl font-black text-gray-800 mb-1"><span id="lblPergamino"></span> kg</div>
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Café Pergamino Seco</div>
                <div class="text-[10px] text-gray-400 mt-2">Cereza ÷ 5</div>
            </div>
            
            <div class="bg-gray-800 border border-gray-900 rounded-3xl p-6 text-center">
                <div class="text-3xl font-black text-emerald-400 mb-1"><span id="lblVerde"></span> kg</div>
                <div class="text-xs font-bold text-gray-300 uppercase tracking-wide">Café Verde</div>
                <div class="text-[10px] text-gray-500 mt-2">Pergamino × 0.8</div>
            </div>
        </div>

        <div class="mt-8 bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 rounded-2xl text-xs font-medium max-w-xl leading-relaxed">
            <strong>⚠️ Nota importante:</strong> Este cálculo es una <em>estimación</em> basada en promedios estándar (Cenicafé y FNC). El valor real en tu finca variará según la calidad de la cereza, el nivel de secado, las pasillas y la variedad del café.
        </div>
    </div>
</div>

<script>
    const dbTiempos = @Html.Raw(jsonTiempos);
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

    // Manejo de Pestañas
    function mostrarCalculadora(id, btnElement) {
        document.querySelectorAll('.calc-section').forEach(el => el.classList.add('hidden'));
        document.getElementById('calc-' + id).classList.remove('hidden');

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('bg-emerald-100', 'text-verde');
            btn.classList.add('bg-gray-100', 'text-gray-700');
        });
        
        btnElement.classList.remove('bg-gray-100', 'text-gray-700');
        btnElement.classList.add('bg-emerald-100', 'text-verde');
    }

    // Calculadora Cosecha
    function actualizarActividades() {
        const cultivo = document.getElementById('cultivoCosecha').value;
        const selectAct = document.getElementById('actividadCosecha');
        selectAct.innerHTML = '<option value="">Selecciona una actividad...</option>';
        
        if (!cultivo) return;
        
        const acts = dbTiempos.filter(t => t.NombreCultivo === cultivo);
        acts.forEach(a => {
            const opt = document.createElement('option');
            opt.value = a.Actividad;
            opt.textContent = a.Actividad;
            selectAct.appendChild(opt);
        });
    }

    function calcularCosecha(e) {
        e.preventDefault();
        const cultivo = document.getElementById('cultivoCosecha').value;
        const actividad = document.getElementById('actividadCosecha').value;
        const fechaStr = document.getElementById('fechaCosecha').value;
        
        if (!cultivo || !actividad || !fechaStr) {
            alert('Por favor selecciona todos los campos');
            return;
        }

        const objTiempo = dbTiempos.find(t => t.NombreCultivo === cultivo && t.Actividad === actividad);
        if (!objTiempo) {
            alert('No se encontraron tiempos para esta combinación en la base de datos.');
            return;
        }

        // JS Date from YYYY-MM-DD
        const [y, m, d] = fechaStr.split('-');
        const fechaIngresada = new Date(parseInt(y), parseInt(m) - 1, parseInt(d));
        
        const fechaCosecha = new Date(fechaIngresada);
        fechaCosecha.setMonth(fechaCosecha.getMonth() + objTiempo.MesesHastaCosecha);
        
        const strMes = mesesNombres[fechaCosecha.getMonth()];
        const strAnio = fechaCosecha.getFullYear();

        // Reemplazar placeholders en el template
        let txt = objTiempo.DescripcionTemplate
                    .replace('{meses}', objTiempo.MesesHastaCosecha)
                    .replace('{fecha}', `${d} de ${mesesNombres[fechaIngresada.getMonth()]} de ${y}`)
                    .replace('{mes}', strMes)
                    .replace('{año}', strAnio);

        document.getElementById('textoCosecha').innerText = txt;
        document.getElementById('resultadoCosecha').classList.remove('hidden');
    }

    // Calculadora Rentabilidad
    // Formatear inputs de dinero al escribir
    document.querySelectorAll('.dinero-input').forEach(input => {
        input.addEventListener('input', function(e) {
            // Remover cualquier caracter que no sea número
            let val = this.value.replace(/\D/g, '');
            if (val === '') {
                this.value = '';
                return;
            }
            // Agregar separador de miles (punto)
            this.value = val.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        });
    });

    function getVal(id) {
        const valStr = document.getElementById(id).value.replace(/\./g, ''); // Quitar los puntos
        const v = parseFloat(valStr);
        return isNaN(v) ? 0 : v;
    }

    function calcularRentabilidad(e) {
        e.preventDefault();
        const ingresos = getVal('ingresoVenta');
        if (ingresos <= 0) {
            alert('El ingreso por venta debe ser mayor a cero.');
            return;
        }

        const gastos = getVal('gastoSiembra') + getVal('gastoAbonado') + getVal('gastoPoda') + getVal('gastoPlagas') + getVal('gastoOtros');
        const balance = ingresos - gastos;

        const container = document.getElementById('resultadoRentabilidad');
        const titulo = document.getElementById('rentabilidadTitulo');
        const monto = document.getElementById('rentabilidadMonto');
        
        container.classList.remove('hidden', 'bg-emerald-500', 'bg-rose-500');
        
        const formatter = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
        
        document.getElementById('lblIngresos').innerText = formatter.format(ingresos);
        document.getElementById('lblGastos').innerText = formatter.format(gastos);

        if (balance > 0) {
            container.classList.add('bg-emerald-500');
            titulo.innerText = '¡Ganaste!';
            monto.innerText = '+' + formatter.format(balance);
        } else if (balance < 0) {
            container.classList.add('bg-rose-500');
            titulo.innerText = 'Perdiste...';
            monto.innerText = formatter.format(balance);
        } else {
            container.classList.add('bg-gray-600');
            titulo.innerText = 'Quedaste a ras';
            monto.innerText = formatter.format(0);
        }
    }

    // Calculadora Conversion
    function calcularConversion(e) {
        e.preventDefault();
        const cereza = parseFloat(document.getElementById('kilosCereza').value);
        if (isNaN(cereza) || cereza <= 0) {
            alert('Ingresa un valor válido de cereza mayor a cero.');
            return;
        }

        const pergamino = cereza / 5;
        const verde = pergamino * 0.8;

        document.getElementById('lblPergamino').innerText = pergamino.toFixed(1);
        document.getElementById('lblVerde').innerText = verde.toFixed(1);
        document.getElementById('resultadoConversion').classList.remove('hidden');
    }
</script>
