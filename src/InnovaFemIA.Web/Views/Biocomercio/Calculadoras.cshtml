<!-- ───────────────────────────────────────────────────────────────────────────── -->
<script id="tiempos-data" type="application/json">
    @Html.Raw(jsonTiempos)
</script>
<script src="~/js/biocomercio/calculadoras.js" asp-append-version="true"></script>
