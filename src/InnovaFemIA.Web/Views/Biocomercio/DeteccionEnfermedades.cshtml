@{
    ViewData["Title"] = "Detección de Enfermedades en Café — InnovaFemIA";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Encabezado Principal y Navegación -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm gap-4">
        <div class="space-y-1">
            <a href="~/biocomercio/index" class="text-xs text-verde font-bold hover:underline inline-flex items-center gap-1.5 mb-1">
                <span>←</span> Volver al Portal de Biocomercio
            </a>
            <h1 class="text-2xl sm:text-3xl font-black text-gray-900 flex items-center gap-3">
                <span class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl shrink-0">🔬</span>
                Detección de Enfermedades en Café
            </h1>
            <p class="text-xs sm:text-sm text-gray-500 max-w-2xl leading-relaxed">
                Herramienta para el análisis fitosanitario de hojas de café que permite identificar si la planta presenta signos de roya, minador u otras afecciones en el cultivo.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="px-3.5 py-1.5 rounded-full text-xs font-black bg-emerald-50 text-verde border border-emerald-200 flex items-center gap-1.5">
                <span>🍃</span> Sanidad Vegetal
            </span>
            <span class="px-3.5 py-1.5 rounded-full text-xs font-black bg-amber-50 text-amber-900 border border-amber-200 flex items-center gap-1.5">
                <span>☕</span> Cultivo de Café
            </span>
        </div>
    </div>

    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <!-- AVISO DE RESPONSABILIDAD                                                      -->
    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-3xl p-5 sm:p-6 shadow-sm">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl shrink-0 border border-amber-200">
                ⚠️
            </div>
            <div class="space-y-1 text-amber-900">
                <h3 class="text-sm font-black uppercase tracking-wider">
                    Aviso de Responsabilidad
                </h3>
                <p class="text-xs sm:text-sm text-amber-800 leading-relaxed">
                    Los resultados obtenidos tienen carácter <strong>exclusivamente orientativo</strong>. Aunque se trata de un modelo entrenado, <strong>los resultados no son 100% precisos</strong>. Se recomienda consultar con otras entidades o personas expertas antes de tomar cualquier decisión sobre el cultivo.
                </p>
            </div>
        </div>
    </div>

    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <!-- PANEL DE CAPTURA, CARGA Y EJEMPLOS                                            -->
    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm space-y-6">
        <div>
            <h2 class="text-base font-black text-gray-900 flex items-center gap-2">
                <span>📸</span> Captura o Selección de la Muestra Foliar
            </h2>
            <p class="text-xs text-gray-500">
                Asegúrate de que la hoja de café esté enfocada, con buena iluminación natural y ocupando el centro de la imagen.
            </p>
        </div>

        <!-- Botones de Acción de Cámara y Archivo -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Botón 1: Cámara -->
            <label class="group cursor-pointer bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white p-5 rounded-2xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-3 active:scale-98">
                <span class="text-2xl">📸</span>
                <div class="text-left">
                    <span class="block font-black text-sm">Tomar Foto con la Cámara</span>
                    <span class="block text-[11px] text-emerald-100 font-medium">Usa la cámara de tu celular o webcam</span>
                </div>
                <input type="file" id="input-camara" accept="image/*" capture="environment" class="hidden" />
            </label>

            <!-- Botón 2: Subir Archivo -->
            <label class="group cursor-pointer bg-gray-50 hover:bg-gray-100 border-2 border-dashed border-gray-300 hover:border-emerald-500 text-gray-800 p-5 rounded-2xl transition-all flex items-center justify-center gap-3 active:scale-98">
                <span class="text-2xl text-emerald-600">📁</span>
                <div class="text-left">
                    <span class="block font-black text-sm text-gray-900 group-hover:text-verde transition-colors">Subir Imagen desde Dispositivo</span>
                    <span class="block text-[11px] text-gray-500">Formato JPG, PNG o WEBP</span>
                </div>
                <input type="file" id="input-archivo" accept="image/jpeg,image/png,image/webp" class="hidden" />
            </label>
        </div>
    </div>

    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <!-- ÁREA DE VISUALIZACIÓN INTERACTIVA Y RESULTADOS DEL MODELO                      -->
    <!-- ───────────────────────────────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Columna Izquierda: Visor con Canvas de Detección (7 columnas) -->
        <div class="lg:col-span-7 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                <h3 class="text-sm font-black text-gray-900 flex items-center gap-2">
                    <span>🖼️</span> Visor de la Muestra Foliar
                </h3>
                <span id="label-estado-visor" class="text-xs font-bold text-gray-400">Sin imagen cargada</span>
            </div>

            <!-- Contenedor de la Imagen y el Canvas Overlay -->
            <div id="contenedor-visor" class="relative w-full min-h-[340px] max-h-[500px] bg-gray-900 rounded-2xl overflow-hidden flex items-center justify-center border border-gray-800 shadow-inner">
                <!-- Placeholder inicial -->
                <div id="placeholder-visor" class="text-center p-8 space-y-3 text-gray-400">
                    <div class="text-5xl opacity-40">☕</div>
                    <p class="text-xs font-medium">
                        Toma una fotografía de la hoja de café o selecciona un archivo para comenzar el análisis.
                    </p>
                </div>

                <!-- Imagen cargada -->
                <img id="img-muestra" class="hidden max-h-[500px] w-auto max-w-full object-contain mx-auto" alt="Muestra de hoja de café" />

                <!-- Canvas para pintar Bounding Boxes / Detecciones -->
                <canvas id="canvas-overlay" class="hidden absolute inset-0 pointer-events-none w-full h-full"></canvas>

                <!-- Overlay de Carga (Spinner) -->
                <div id="loader-analisis" class="hidden absolute inset-0 bg-gray-950/80 backdrop-blur-xs flex flex-col items-center justify-center p-6 text-white text-center space-y-3 z-20">
                    <div class="w-12 h-12 border-4 border-emerald-400 border-t-transparent rounded-full animate-spin"></div>
                    <div>
                        <h4 class="font-black text-sm text-white">Analizando imagen foliar...</h4>
                        <p class="text-xs text-gray-300 mt-1">Examinando la muestra en busca de signos de enfermedades o plagas.</p>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción del Visor -->
            <div id="controles-visor" class="hidden flex justify-between items-center pt-2 text-xs">
                <button type="button" id="btn-toggle-cajas" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl transition-all">
                    👁️ Alternar recuadros de detección
                </button>
                <button type="button" id="btn-limpiar-muestra" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-xl transition-all">
                    🗑️ Quitar muestra
                </button>
            </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Resultados del Análisis (5 columnas) -->
        <div class="lg:col-span-5 space-y-5">

            <!-- Estado Vacío Inicial -->
            <div id="panel-resultado-vacio" class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm text-center space-y-4">
                <div class="w-16 h-16 rounded-3xl bg-purple-50 text-purple-600 flex items-center justify-center text-3xl mx-auto shadow-inner">
                    🔬
                </div>
                <div class="space-y-1">
                    <h3 class="text-base font-black text-gray-900">Esperando Muestra</h3>
                    <p class="text-xs text-gray-500 leading-relaxed">
                        Cuando cargues o tomes la foto de la planta, aquí aparecerán los resultados del análisis fitosanitario.
                    </p>
                </div>
            </div>

            <!-- Tarjeta de Resultados (Oculta hasta procesar) -->
            <div id="panel-resultado-activo" class="hidden bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden space-y-0">
                
                <!-- Encabezado del Diagnóstico con Semáforo -->
                <div id="header-diagnostico" class="p-6 text-white transition-colors bg-emerald-700">
                    <div class="flex items-center justify-between mb-2">
                        <span id="badge-semaforo" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-white/20 backdrop-blur-sm border border-white/20">
                            Hoja Sana
                        </span>
                        <span id="label-confianza" class="text-xs font-extrabold bg-black/20 px-3 py-1 rounded-full">
                            94.0% de certeza
                        </span>
                    </div>
                    <h3 id="titulo-diagnostico" class="text-2xl font-black tracking-tight">
                        Hoja Aparentemente Sana
                    </h3>
                    <p id="subtitulo-cientifico" class="text-xs text-white/80 italic font-mono mt-0.5">
                        Coffea arabica
                    </p>
                </div>

                <!-- Cuerpo de Resultados -->
                <div class="p-6 space-y-5">
                    <!-- Síntomas visuales -->
                    <div>
                        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                            <span>🔍</span> Signos y Síntomas Observados
                        </h4>
                        <p id="texto-sintomas" class="text-xs sm:text-sm text-gray-700 leading-relaxed bg-gray-50 p-4 rounded-2xl border border-gray-100">
                            No se observan lesiones visibles en el área foliar.
                        </p>
                    </div>

                    <!-- Detecciones específicas en la imagen -->
                    <div id="seccion-cajas-detalle" class="hidden space-y-2">
                        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider flex items-center gap-1.5">
                            <span>🎯</span> Afectaciones Detectadas en la Muestra
                        </h4>
                        <div id="lista-cajas" class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
                            <!-- Inyectado dinámicamente con JS -->
                        </div>
                    </div>

                    <!-- Recordatorio de verificación humana -->
                    <div class="p-3.5 bg-gray-50 rounded-2xl border border-gray-100 text-[11px] text-gray-500 text-center font-medium">
                        🛡️ Recuerda verificar este resultado en campo antes de tomar cualquier decisión.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/biocomercio/deteccion-enfermedades.js" asp-append-version="true"></script>
}
