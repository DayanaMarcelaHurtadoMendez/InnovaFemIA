@model InnovaFemIA.Web.Features.Biocomercio.Stock.StockViewModel
@{
    ViewData["Title"] = "Mi Stock de Productos";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-3xl border border-gray-100 shadow-sm gap-4">
        <div>
            <a href="~/biocomercio/index" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>📦</span> Mi Stock
            </h1>
            <p class="text-sm text-gray-500">Actualiza qué productos tienes disponibles hoy para la venta o agrega nuevos cultivos a tu perfil.</p>
        </div>
        <div class="shrink-0 flex flex-wrap items-center gap-2">
            <a href="~/biocomercio/calculadoras" class="px-3.5 py-2 bg-emerald-50 text-verde hover:bg-emerald-100 rounded-xl text-xs font-bold border border-emerald-200 transition-all flex items-center gap-1.5">
                <span>🧮</span>
                <span>Calculadoras</span>
            </a>
            <a href="~/biocomercio/deteccion-enfermedades" class="px-3.5 py-2 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-xl text-xs font-bold border border-purple-200 transition-all flex items-center gap-1.5">
                <span>🔬</span>
                <span>Detección de Enfermedades</span>
            </a>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-5 py-4 rounded-2xl text-sm flex gap-3 shadow-sm">
            <span>✅</span> <span><strong>@TempData["Exito"]</strong></span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-4 rounded-2xl text-sm flex gap-3 shadow-sm">
            <span>⚠️</span> <span><strong>@TempData["Error"]</strong></span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Formulario de Stock -->
        <div class="lg:col-span-2 space-y-6">
            <form action="/biocomercio/mi-stock" method="POST" class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                @Html.AntiForgeryToken()
                
                <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                    <h2 class="text-lg font-black text-gray-900">Catálogo de Cultivos</h2>
                    <span class="text-xs font-bold text-gray-500 bg-gray-100 px-3 py-1 rounded-full">@Model.Items.Count() productos</span>
                </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        @foreach (var item in Model.Items.OrderBy(i => i.NombreCultivo))
                        {
                            <label class="flex items-center justify-between p-4 rounded-2xl border transition-all cursor-pointer @(item.Disponible ? "bg-emerald-50 border-emerald-200 shadow-sm" : "bg-white border-gray-200 hover:border-gray-300")">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-2xl shadow-sm">
                                        @item.Icono
                                    </div>
                                    <div>
                                        <div class="font-black text-gray-900">@item.NombreCultivo</div>
                                        <div class="text-xs font-bold @(item.Disponible ? "text-verde" : "text-gray-400")">
                                            @(item.Disponible ? "Disponible hoy" : "No disponible")
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Toggle UI -->
                                <div class="relative inline-flex items-center">
                                    <input type="checkbox" name="cultivosDisponibles" value="@item.CultivoId" class="sr-only peer" @(item.Disponible ? "checked" : "") onchange="this.closest('label').classList.toggle('bg-emerald-50'); this.closest('label').classList.toggle('border-emerald-200'); this.closest('label').classList.toggle('bg-white');" />
                                    <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-verde peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
                                </div>
                            </label>
                        }
                    </div>

                    <button type="submit" class="w-full sm:w-auto px-8 py-4 bg-gray-900 hover:bg-black text-white font-black rounded-2xl shadow-lg transition-all active:scale-95">
                        💾 Guardar Disponibilidad
                    </button>
                    <p class="text-xs text-gray-500 mt-4 text-center sm:text-left">
                        Los cambios se reflejarán de inmediato en el Mapa Interactivo público. Los productos que actives también quedarán asociados permanentemente a tu perfil familiar.
                    </p>
            </form>
        </div>

        <!-- Quién más tiene -->
        <div class="lg:col-span-1">
            <div class="bg-gray-50 p-6 sm:p-8 rounded-3xl border border-gray-200">
                <h3 class="text-lg font-black text-gray-900 mb-2">🤝 Quién más tiene este producto hoy</h3>
                <p class="text-xs text-gray-500 mb-6 leading-relaxed">
                    Familias de tu asociación que tienen disponibilidad de al menos un producto de los que tú ofreces hoy. ¡Contáctalas para unir cosechas y vender en volumen!
                </p>

                @if (!Model.Items.Any(i => i.Disponible))
                {
                    <div class="bg-white p-5 rounded-2xl border border-gray-100 text-center shadow-sm">
                        <span class="text-2xl block mb-2">🤔</span>
                        <p class="text-xs font-medium text-gray-500">Primero marca algún producto como disponible para ver quién más lo tiene.</p>
                    </div>
                }
                else if (!Model.FamiliasConMismosProductos.Any())
                {
                    <div class="bg-white p-5 rounded-2xl border border-gray-100 text-center shadow-sm">
                        <span class="text-2xl block mb-2">🌱</span>
                        <p class="text-xs font-medium text-gray-500">Por ahora no hay otras familias con los mismos productos disponibles.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var familia in Model.FamiliasConMismosProductos)
                        {
                            <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-orange-100 text-naranja flex items-center justify-center font-black">
                                        @familia.NombreFamilia.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-bold text-sm text-gray-900">@familia.NombreFamilia</div>
                                        <div class="text-[10px] text-gray-400 font-bold mb-1">
                                            Coincide en: <span class="text-emerald-600">@string.Join(", ", familia.ProductosCoincidentes)</span>
                                        </div>
                                        <div class="text-xs text-gray-500 flex items-center gap-1">
                                            <span>📍</span> @familia.Vereda
                                        </div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(familia.TelefonoContacto))
                                {
                                    <a href="https://wa.me/57@(familia.TelefonoContacto.Replace(" ", "").Replace("+57", ""))" target="_blank" class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-50 text-green-600 hover:bg-green-100 transition-colors" title="Contactar por WhatsApp">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
