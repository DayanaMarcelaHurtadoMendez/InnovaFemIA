@* Footer de InnovaFemIA *@
<footer class="bg-gray-900 text-gray-300 mt-auto" role="contentinfo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

            <!-- Columna 1: Brand -->
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <div class="bg-white p-2.5 rounded-2xl shadow-md border border-gray-100 inline-flex items-center justify-center shrink-0">
                        <img src="~/images/general/Logo.png" alt="InnovaFemIA" class="h-14 w-auto object-contain" />
                    </div>
                    <div>
                        <p class="font-bold text-white text-lg">InnovaFem<span class="text-brand-400">IA</span></p>
                        <p class="text-xs text-gray-400">Proyecto Orquídeas</p>
                    </div>
                </div>
                <p class="text-sm text-gray-400 leading-relaxed">
                    Plataforma digital para el empoderamiento de mujeres rurales
                    y jóvenes de <strong class="text-gray-300">ASCAMPESINA</strong>,
                    Caldono, Cauca.
                </p>
            </div>

            <!-- Columna 2: Módulos -->
            <div>
                <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Módulos</h3>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/mapa" class="text-gray-400 hover:text-primary-400 transition-colors duration-200 flex items-center gap-2">
                            <span>🗺️</span> Mapa Interactivo de Oportunidades
                        </a>
                    </li>
                    <li>
                        <a href="/chatbot" class="text-gray-400 hover:text-brand-400 transition-colors duration-200 flex items-center gap-2">
                            <span>🤖</span> Asistente Educativo
                        </a>
                    </li>
                    <li>
                        <a href="/biocomercio" class="text-gray-400 hover:text-secondary-400 transition-colors duration-200 flex items-center gap-2">
                            <span>🌿</span> Biocomercio ASCAMPESINA
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Columna 3: Institucional -->
            <div>
                <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Institucional</h3>
                <div class="space-y-3">
                    <div class="bg-white rounded-2xl p-3 shadow-sm hover:shadow-md transition-all duration-300 flex items-center gap-3 group border border-gray-100">
                        <div class="w-16 h-12 flex items-center justify-center shrink-0">
                            <img src="~/images/general/Logo_universidad_icesi.webp" alt="Universidad ICESI" class="max-h-10 max-w-[56px] w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
                        </div>
                        <div class="flex flex-col border-l border-gray-200 pl-3">
                            <span class="text-xs font-bold text-gray-900 leading-tight">Universidad ICESI</span>
                            <span class="text-[11px] text-gray-500 font-medium">Co-ejecutor Académico</span>
                        </div>
                    </div>

                    <div class="bg-white rounded-2xl p-3 shadow-sm hover:shadow-md transition-all duration-300 flex items-center gap-3 group border border-gray-100">
                        <div class="w-16 h-12 flex items-center justify-center shrink-0">
                            <img src="~/images/general/ascampesina.png" alt="ASCAMPESINA" class="max-h-10 max-w-[56px] w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
                        </div>
                        <div class="flex flex-col border-l border-gray-200 pl-3">
                            <span class="text-xs font-bold text-gray-900 leading-tight">ASCAMPESINA</span>
                            <span class="text-[11px] text-gray-500 font-medium">Caldono, Cauca</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Línea inferior -->
        <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-500">
            <p>&copy; @DateTime.Now.Year InnovaFemIA — Proyecto Orquídeas. Todos los derechos reservados.</p>
            <div class="flex items-center gap-4">
                <a href="/admin/login" class="hover:text-gray-400 transition-colors" id="footer-admin-link">Administración</a>
            </div>
        </div>
    </div>
</footer>
