@* Navbar principal de InnovaFemIA — visible en toda la plataforma *@
<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

            <!-- Logo / Brand -->
            <a href="/" class="flex items-center gap-3 group" id="nav-brand">
                <img src="~/images/general/Logo.png" alt="InnovaFemIA" class="h-[45px] w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
                <div class="flex flex-col leading-tight">
                    <span class="font-bold text-base text-gray-900">InnovaFem<span class="text-brand-600">IA</span></span>
                    <span class="text-xs text-gray-400 font-medium">Proyecto Orquídeas · ICESI</span>
                </div>
            </a>

            <!-- Módulos de navegación — desktop -->
            <div class="hidden md:flex items-center gap-1" role="navigation" aria-label="Módulos principales">
                <a href="/mapa"
                   id="nav-mapa"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mapa" ? "active" : "")">
                    <span aria-hidden="true">🗺️</span>
                    <span>Mapa</span>
                </a>
                <a href="/chatbot"
                   id="nav-chatbot"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chatbot" ? "active" : "")">
                    <span aria-hidden="true">🤖</span>
                    <span>Asistente</span>
                </a>
                <a href="/biocomercio"
                   id="nav-biocomercio"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Biocomercio" ? "active" : "")">
                    <span aria-hidden="true">🌿</span>
                    <span>Biocomercio</span>
                </a>
            </div>

            <!-- Acciones derecha -->
            <div class="flex items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <a href="/admin" id="nav-admin" class="nav-link text-brand-700 bg-brand-50 hover:bg-brand-100">
                        <span aria-hidden="true">⚙️</span>
                        <span class="hidden sm:inline">Panel Admin</span>
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-sm font-medium text-gray-600 px-3">👩‍🌾 Mi perfil</span>
                    <a href="/biocomercio/logout" id="nav-logout" class="btn-secondary text-xs px-3 py-2">
                        Salir
                    </a>
                }

                <!-- Botón mobile -->
                <button id="nav-mobile-toggle"
                        class="md:hidden p-2 rounded-xl text-gray-500 hover:bg-gray-100 transition-colors"
                        aria-label="Abrir menú de navegación"
                        aria-expanded="false">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Menú mobile desplegable -->
        <div id="nav-mobile-menu" class="md:hidden hidden pb-4 animate-fade-in">
            <div class="flex flex-col gap-1 pt-2 border-t border-gray-100">
                <a href="/mapa" class="nav-link" id="nav-mobile-mapa">🗺️ Mapa Interactivo</a>
                <a href="/chatbot" class="nav-link" id="nav-mobile-chatbot">🤖 Asistente Educativo</a>
                <a href="/biocomercio" class="nav-link" id="nav-mobile-biocomercio">🌿 Biocomercio</a>
            </div>
        </div>
    </div>
</nav>

<script>
    // Toggle mobile menu
    document.getElementById('nav-mobile-toggle')?.addEventListener('click', function () {
        const menu = document.getElementById('nav-mobile-menu');
        const expanded = this.getAttribute('aria-expanded') === 'true';
        menu.classList.toggle('hidden');
        this.setAttribute('aria-expanded', String(!expanded));
    });
</script>
