@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    bool esAdmin = User.Identity?.IsAuthenticated == true && (User.IsInRole("Administrador") || User.IsInRole("Admin"));
    bool esFamilia = User.Identity?.IsAuthenticated == true && !esAdmin;
}
@* Navbar del Módulo 3 — Biocomercio InnovaFemIA *@
<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

            <!-- Logo / Brand -->
            <a href="~/biocomercio" class="flex items-center gap-3 group" id="nav-brand">
                <img src="~/images/general/Logo.png" alt="InnovaFemIA" class="h-[45px] w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
                <div class="flex flex-col leading-tight">
                    <span class="font-bold text-base text-gray-900">InnovaFem<span class="text-morado">IA</span></span>
                    <span class="text-xs text-verde font-medium">Soberanía Económica & Biocomercio</span>
                </div>
            </a>

            <!-- Módulos de navegación — desktop -->
            <div class="hidden md:flex items-center gap-1" role="navigation" aria-label="Módulos principales">
                <a href="~/biocomercio"
                   id="nav-biocomercio"
                   title="Portal Principal de Biocomercio"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <span aria-hidden="true">🌿</span>
                    <span>Biocomercio</span>
                </a>
                <a href="~/biocomercio/calculadoras"
                   id="nav-calculadoras"
                   title="Calculadoras agronómicas y financieras"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Calculadoras" ? "active" : "")">
                    <span aria-hidden="true">🧮</span>
                    <span>Calculadoras</span>
                </a>
                <a href="~/biocomercio/mi-stock"
                   id="nav-stock"
                   title="Gestión de cosechas de la productora"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MiStock" ? "active" : "")">
                    <span aria-hidden="true">📦</span>
                    <span>Mi Stock</span>
                </a>
                <a href="~/biocomercio/deteccion-enfermedades"
                   id="nav-deteccion"
                   title="Diagnóstico fitosanitario en hojas de café con IA"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "DeteccionEnfermedades" ? "active" : "")">
                    <span aria-hidden="true">🔬</span>
                    <span>Detección IA</span>
                </a>
            </div>

            <!-- Acciones derecha -->
            <div class="flex items-center gap-2 sm:gap-3">
                @if (esAdmin)
                {
                    <a href="~/admin/dashboard" id="nav-admin" class="nav-link text-verde bg-emerald-50 hover:bg-emerald-100 font-bold border border-emerald-200 text-xs sm:text-sm">
                        <span aria-hidden="true">⚙️</span>
                        <span class="hidden sm:inline">Panel Admin</span>
                    </a>
                    <a href="~/admin/logout" id="nav-admin-logout"
                       title="Cerrar sesión de administrador"
                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 shadow-sm shadow-rose-200 hover:shadow-md transition-all active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013 3v1" /></svg>
                        <span>Cerrar Sesión</span>
                    </a>
                }
                else if (esFamilia)
                {
                    <span class="hidden sm:inline-flex items-center gap-1.5 bg-gray-100 border border-gray-200 px-3 py-1.5 rounded-xl text-xs font-semibold text-gray-700">
                        <span>👩‍🌾</span>
                        <span>@(User.Identity?.Name ?? "Mi Perfil")</span>
                    </span>
                    <a href="~/biocomercio/logout" id="nav-logout"
                       title="Cerrar sesión de familia campesina"
                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 shadow-sm shadow-rose-200 hover:shadow-md transition-all active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013 3v1" /></svg>
                        <span>Cerrar Sesión</span>
                    </a>
                }
                else
                {
                    <a href="~/biocomercio/login" id="nav-login" class="nav-link text-verde font-bold text-xs sm:text-sm">
                        <span>Ingreso Productoras</span>
                    </a>
                    <a href="~/admin/login" id="nav-admin-login" class="nav-link text-gray-500 hover:text-gray-900 text-xs font-semibold hidden sm:inline">
                        <span>Admin</span>
                    </a>
                }

                <!-- Botón mobile -->
                <button id="nav-mobile-toggle"
                        class="md:hidden p-2 rounded-xl text-gray-500 hover:bg-gray-100 transition-colors"
                        aria-label="Abrir menú de navegación"
                        aria-expanded="false">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Menú mobile desplegable -->
        <div id="nav-mobile-menu" class="md:hidden hidden pb-4 animate-fade-in">
            <div class="flex flex-col gap-1 pt-2 border-t border-gray-100">
                <a href="~/biocomercio" class="nav-link" id="nav-mobile-biocomercio">🌿 Portal Biocomercio</a>
                <a href="~/biocomercio/calculadoras" class="nav-link" id="nav-mobile-calc">🧮 Calculadoras</a>
                <a href="~/biocomercio/mi-stock" class="nav-link" id="nav-mobile-stock">📦 Mi Stock</a>
                <a href="~/biocomercio/deteccion-enfermedades" class="nav-link" id="nav-mobile-deteccion">🔬 Detección IA</a>

                @if (esAdmin)
                {
                    <a href="~/admin/dashboard" class="nav-link text-verde font-bold mt-2">⚙️ Panel Admin</a>
                    <a href="~/admin/logout" class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 shadow-sm mt-3 transition-all">
                        <span>Cerrar Sesión (Admin)</span>
                    </a>
                }
                else if (esFamilia)
                {
                    <a href="~/biocomercio/logout" class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 shadow-sm mt-3 transition-all">
                        <span>Cerrar Sesión</span>
                    </a>
                }
                else
                {
                    <a href="~/biocomercio/login" class="nav-link text-verde font-bold mt-2">👩‍🌾 Ingreso Productoras</a>
                    <a href="~/admin/login" class="nav-link text-gray-500 text-xs">🔐 Ingreso Admin</a>
                }
            </div>
        </div>
    </div>
</nav>
