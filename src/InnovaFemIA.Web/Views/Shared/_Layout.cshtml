<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light" />

    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | InnovaFemIA" : "InnovaFemIA — Plataforma Orquídeas ICESI")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "InnovaFemIA: Mapa de oportunidades, asistente educativo y biocomercio para mujeres rurales de ASCAMPESINA — Caldono, Cauca. Proyecto Orquídeas, Universidad ICESI.")" />
    <meta name="keywords" content="ASCAMPESINA, mujeres rurales, Caldon, biocomercio, soberanía alimentaria" />
    <meta name="author" content="Universidad ICESI — Proyecto Orquídeas" />

    <!-- Open Graph -->
    <meta property="og:title" content="InnovaFemIA — Plataforma Orquídeas" />
    <meta property="og:description" content="Mapa interactivo, chatbot educativo y herramientas de biocomercio para comunidades campesinas de Caldono, Cauca." />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- TailwindCSS compilado -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    
    <!-- TailwindCSS CDN (Respaldo en Desarrollo) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/shared/tailwind.config.js" asp-append-version="true"></script>
    <style type="text/tailwindcss">
        @@layer base {
            html {
                font-size: 16.8px; /* +20% exacto sobre 14px original en móvil */
                -webkit-text-size-adjust: 100%;
                color-scheme: light;
            }
            @@media (min-width: 768px) {
                html {
                    font-size: 19.2px; /* +20% exacto sobre 16px original en desktop */
                }
            }
            body {
                font-family: 'Outfit', system-ui, sans-serif;
                color-scheme: light;
            }
            input, select, textarea {
                color-scheme: light;
            }
        }
        @@layer components {
            .card { @@apply bg-white rounded-2xl p-5 transition-all duration-300; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
            .card:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); }
            .btn-primary { @@apply inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-verde text-white hover:bg-verde/90 active:bg-verde/80 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-verde focus:ring-offset-2; }
            .btn-morado { @@apply inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-morado text-white hover:bg-morado/90 active:bg-morado/80 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-morado focus:ring-offset-2; }
            .btn-cian { @@apply inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-cian text-white hover:bg-cian/90 active:bg-cian/80 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-cian focus:ring-offset-2; }
            .btn-naranja { @@apply inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-naranja text-white hover:bg-naranja/90 active:bg-naranja/80 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-naranja focus:ring-offset-2; }
            .btn-secondary { @@apply inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-white text-gray-700 border border-gray-200 hover:bg-gray-50 transition-all duration-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2; }
            .input-field { @@apply w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-verde focus:border-transparent transition-all duration-200; }
            .section-header { @@apply text-2xl font-bold text-gray-900 mb-1; }
            .section-subtitle { @@apply text-sm text-gray-500 mb-6; }
            .cultivo-disponible { @@apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-verde/10 text-verde; }
            .cultivo-no-disponible { @@apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 line-through; }
            .nav-link { @@apply flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium text-gray-600 hover:text-morado hover:bg-morado-light transition-all duration-200; }
            .nav-link.active { @@apply text-morado bg-morado-light; }
        }

        /* Micro-etiquetas con aumento proporcional exacto del +20% */
        [class*="text-[9px]"] { font-size: 10.8px !important; }
        [class*="text-[10px]"] { font-size: 12px !important; }
        [class*="text-[11px]"] { font-size: 13.2px !important; }
        [class*="text-[12px]"] { font-size: 14.4px !important; }
    </style>

    <!-- Favicon (emoji como data URI) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌺</text></svg>" />

    <!-- Compatibilidad de Sub-Rutas y Proxy Reverso (PathBase) para llamadas JavaScript/fetch -->
    <meta name="app-path-base" content="@(Context.Request.PathBase.Value ?? "")" />
    <script src="~/js/shared/pathbase.js" asp-append-version="true"></script>

    @RenderSection("Head", required: false)
</head>
<body class="min-h-screen flex flex-col bg-gray-50">

    <!-- ── Navbar ──────────────────────────────────────────────────────── -->
    @await Html.PartialAsync("_NavBar")

    <!-- ── Contenido principal ─────────────────────────────────────────── -->
    <main class="flex-1 animate-fade-in">
        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────────────── -->
    @await Html.PartialAsync("_Footer")

    <!-- Scripts base -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/shared/navbar.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
