@using InnovaFemIA.Web.Features.Shared.Entities
@{
    ViewData["Title"] = "Amalia — Asistente Educativo Chatbot";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Chatbot.CultivoChatbotDto> ?? [];
    var lecciones = ViewBag.Lecciones as IEnumerable<InnovaFemIA.Web.Features.Chatbot.LeccionResumenDto> ?? [];
}

<div class="min-h-[calc(100vh-4rem)] bg-gray-50 py-6 px-3 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto flex flex-col h-[85vh] bg-white rounded-3xl border border-gray-100 shadow-xl overflow-hidden">
        
        <!-- Header del Chatbot -->
        <header class="bg-white px-4 sm:px-6 py-4 flex items-center justify-between border-b border-gray-100 shrink-0">
            <div class="flex items-center gap-3.5">
                <div class="relative">
                    <div class="w-12 h-12 rounded-2xl bg-naranja-light text-naranja flex items-center justify-center text-2xl shadow-sm border border-naranja/10">
                        👩‍🌾
                    </div>
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-naranja border-2 border-white rounded-full animate-pulse"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-black text-base sm:text-lg tracking-tight text-gray-900">Amalia</h1>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-naranja-light border border-naranja/20 text-naranja">
                            Asistente Educativo
                        </span>
                    </div>
                    <p class="text-xs text-gray-500 font-medium">InnovaFemIA · Saberes Agroecológicos de Caldono</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a href="/chatbot/lecciones" class="hidden sm:flex items-center gap-1.5 px-3.5 py-2 btn-secondary text-xs">
                    <span>🎓</span>
                    <span>Modo Lección</span>
                </a>
                <button onclick="reiniciarChat()" title="Reiniciar conversación" class="p-2.5 btn-secondary flex items-center gap-1">
                    <span>🔄</span>
                    <span class="hidden md:inline">Reiniciar</span>
                </button>
            </div>
        </header>

        <!-- Contenedor scrollable de mensajes -->
        <main id="chat-messages" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 bg-gray-50/50 scroll-smooth">
            <!-- Los mensajes se insertan dinámicamente aquí mediante JavaScript -->
        </main>

        <!-- Barra inferior / Menú de Acciones Rápidas -->
        <footer class="p-3.5 bg-white border-t border-gray-100 flex flex-wrap items-center justify-between gap-2 shrink-0">
            <div class="flex items-center gap-1.5 overflow-x-auto py-1 max-w-full text-xs">
                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider pl-1">Accesos:</span>
                <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-verde font-bold rounded-xl border border-emerald-200/80 transition-all flex items-center gap-1 shrink-0">
                    🌾 Consultar Cultivos
                </button>
                <a href="/chatbot/lecciones" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold rounded-xl border border-amber-200/80 transition-all flex items-center gap-1 shrink-0">
                    🎓 Modo Lección
                </a>
            </div>
            <div class="text-[11px] text-gray-400 font-medium hidden sm:block">
                InnovafemIA.
            </div>
        </footer>
    </div>
</div>

<!-- Modal Visualizador de Medios / Zoom -->
<div id="media-modal" class="fixed inset-0 z-50 hidden bg-gray-950/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl border border-gray-100 flex flex-col max-h-[90vh]">
        <div class="bg-gray-900 text-white p-4 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-2">
                <span id="media-modal-icon" class="text-xl">🖼️</span>
                <h3 id="media-modal-title" class="font-black text-sm text-white truncate max-w-md">Vista Previa</h3>
            </div>
            <button onclick="cerrarMediaModal()" class="text-white hover:text-gray-300 font-bold text-xl px-2">✕</button>
        </div>
        <div id="media-modal-body" class="p-6 overflow-y-auto flex-1 flex items-center justify-center bg-gray-950 text-white">
            <!-- Contenido dinámico -->
        </div>
        <div class="p-3.5 bg-gray-900 border-t border-gray-800 flex justify-end">
            <button onclick="cerrarMediaModal()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold rounded-xl text-xs">Cerrar</button>
        </div>
    </div>
</div>

<script>
    // Catálogo de cultivos pre-cargado desde Razor (Solo cultivos que SI tienen contenidos en BD)
    const CULTIVOS_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cultivos));

    // Estado del flujo actual
    let estadoActual = {
        cultivoSeleccionado: null,
        temaSeleccionado: null,
        recursosDisponibles: [],
        indiceRecursoActual: 0
    };

    // Inicializar chat al cargar
    document.addEventListener('DOMContentLoaded', () => {
        iniciarConversacion();
    });

    function getNombreUsuaria() {
        return localStorage.getItem('innovafemia_user_name') || '';
    }

    function scrollChatAbajo() {
        const container = document.getElementById('chat-messages');
        setTimeout(() => {
            container.scrollTop = container.scrollHeight;
        }, 100);
    }

    function agregarBurbujaBot(htmlContent) {
        const container = document.getElementById('chat-messages');
        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-start gap-3 animate-fade-in max-w-2xl';
        
        wrapper.innerHTML = `
            <div class="w-9 h-9 rounded-2xl bg-verde text-white flex items-center justify-center text-base shrink-0 shadow-sm border border-verde">
                👩‍🌾
            </div>
            <div class="bg-white p-4 rounded-3xl rounded-tl-sm border border-gray-100 shadow-sm text-xs text-gray-800 space-y-3 leading-relaxed w-full">
                ${htmlContent}
            </div>
        `;

        container.appendChild(wrapper);
        scrollChatAbajo();
    }

    function agregarBurbujaUsuaria(texto) {
        const container = document.getElementById('chat-messages');
        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-end justify-end gap-2 animate-fade-in';
        
        wrapper.innerHTML = `
            <div class="bg-verde text-white px-4 py-3 rounded-3xl rounded-tr-sm shadow-md text-xs font-bold max-w-md">
                ${texto}
            </div>
            <div class="w-8 h-8 rounded-full bg-emerald-100 text-verde flex items-center justify-center text-xs font-bold shrink-0">
                👤
            </div>
        `;

        container.appendChild(wrapper);
        scrollChatAbajo();
    }

    function reiniciarChat() {
        document.getElementById('chat-messages').innerHTML = '';
        estadoActual = { cultivoSeleccionado: null, temaSeleccionado: null, recursosDisponibles: [], indiceRecursoActual: 0 };
        iniciarConversacion();
    }

    function iniciarConversacion() {
        const nombre = getNombreUsuaria();
        const saludo = nombre ? `¡Hola, <strong>${nombre}</strong>! 👋` : `¡Hola! 👋`;

        const welcomeHtml = `
            <div>
                <p class="font-extrabold text-verde text-sm mb-1">${saludo} Soy <strong>Amalia</strong>, tu asistente educativa de InnovaFemIA.</p>
                <p class="text-gray-600">Estoy aquí para acompañarte y compartir conocimientos prácticos sobre el campo en Caldono, Cauca.</p>
            </div>
            <div class="pt-2 border-t border-gray-100">
                <p class="font-bold text-gray-700 mb-2">¿Qué te gustaría hacer hoy?</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <button onclick="iniciarFlujoCultivos()" class="p-3 bg-emerald-50 hover:bg-emerald-100 text-verde rounded-2xl border border-emerald-200 text-left font-bold flex items-center gap-2 transition-all group">
                        <span class="text-xl group-hover:scale-110 transition-transform">🌾</span>
                        <div>
                            <span class="block">Mis Cultivos</span>
                            <span class="text-[10px] text-verde font-normal">Guías prácticas y calidad</span>
                        </div>
                    </button>
                    <button onclick="consultarCalendarioLunarChatbot()" class="p-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-950 rounded-2xl border border-indigo-200 text-left font-bold flex items-center gap-2 transition-all group">
                        <span class="text-xl group-hover:scale-110 transition-transform">🌒</span>
                        <div>
                            <span class="block">Fase Lunar</span>
                            <span class="text-[10px] text-indigo-700 font-normal">Cuándo sembrar y podar</span>
                        </div>
                    </button>
                    <a href="/chatbot/lecciones" class="p-3 bg-amber-50 hover:bg-amber-100 text-amber-900 rounded-2xl border border-amber-200 text-left font-bold flex items-center gap-2 transition-all group">
                        <span class="text-xl group-hover:scale-110 transition-transform">🎓</span>
                        <div>
                            <span class="block">Modo Lección</span>
                            <span class="text-[10px] text-amber-700 font-normal">Aprende con trivias</span>
                        </div>
                    </a>
                </div>
            </div>
        `;

        agregarBurbujaBot(welcomeHtml);
    }

    // ─── Flujo 1: Consulta de Cultivos (Solo cultivos con contenido en BD) ────

    function iniciarFlujoCultivos() {
        agregarBurbujaUsuaria("🌾 Quiero aprender sobre mis cultivos");

        let cultivosBotonesHtml = '';
        if (CULTIVOS_DATA && CULTIVOS_DATA.length > 0) {
            cultivosBotonesHtml = CULTIVOS_DATA.map(c => {
                const id = c.id || c.Id;
                const nombre = c.nombre || c.Nombre;
                const icono = c.icono || c.Icono || '🌱';
                return `
                    <button onclick="seleccionarCultivo(${id}, '${nombre}', '${icono}')" 
                            class="p-3 bg-emerald-50/60 hover:bg-emerald-100 hover:border-emerald-300 border border-emerald-200/70 rounded-2xl font-bold text-gray-900 flex items-center gap-2.5 transition-all text-xs">
                        <span class="text-xl">${icono}</span>
                        <div class="text-left">
                            <span class="block font-black">${nombre}</span>
                        </div>
                    </button>
                `;
            }).join('');
        } else {
            cultivosBotonesHtml = `
                <div class="col-span-full p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-900 text-xs">
                    <p class="font-bold">Por el momento no hay contenidos educativos cargados en la base de datos.</p>
                    <p class="text-[11px] text-amber-800 font-normal mt-1">El equipo administrador cargará nuevos recursos próximamente.</p>
                </div>
            `;
        }

        const html = `
            <p class="font-bold text-gray-900">Excelente. ¿Sobre cuál de estos cultivos te gustaría consultar información?</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2">
                ${cultivosBotonesHtml}
            </div>
        `;

        agregarBurbujaBot(html);
    }

    async function seleccionarCultivo(id, nombre, icono) {
        estadoActual.cultivoSeleccionado = { id, nombre, icono };
        agregarBurbujaUsuaria(`${icono} ${nombre}`);

        try {
            // Consultar ÚNICAMENTE los temas que SI tienen contenido para este cultivo
            const resp = await fetch(`/chatbot/api/temas-por-cultivo?cultivoId=${id}`);
            const temasDisponibles = await resp.json();

            if (!temasDisponibles || temasDisponibles.length === 0) {
                const sinTemasHtml = `
                    <p class="font-bold text-amber-900">No encontramos temas con recursos disponibles para <strong>${nombre}</strong>.</p>
                    <div class="pt-2">
                        <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-emerald-100 text-verde font-bold rounded-xl text-xs">
                            ← Elegir otro cultivo
                        </button>
                    </div>
                `;
                agregarBurbujaBot(sinTemasHtml);
                return;
            }

            const temasBotonesHtml = temasDisponibles.map(t => {
                const tId = t.id || t.Id;
                const tNombre = t.nombre || t.Nombre;
                const tIcono = t.icono || t.Icono || '🌱';
                const total = t.totalRecursos || t.TotalRecursos || 1;
                return `
                    <button onclick="seleccionarTema('${tId}', '${tNombre}', '${tIcono}')" 
                            class="p-3 bg-amber-50 hover:bg-amber-100 hover:border-amber-300 border border-amber-200 rounded-2xl font-bold text-amber-950 flex items-center justify-between gap-2 transition-all text-xs">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">${tIcono}</span>
                            <span class="font-black">${tNombre}</span>
                        </div>
                        <span class="px-2 py-0.5 bg-amber-200/80 text-amber-900 rounded-lg text-[10px] font-extrabold">
                            ${total} ${total === 1 ? 'recurso' : 'recursos'}
                        </span>
                    </button>
                `;
            }).join('');

            const html = `
                <p class="font-bold text-gray-900">¡Perfecto! Seleccionaste <strong>${icono} ${nombre}</strong>.</p>
                <p class="text-gray-600">Estos son los temas con contenidos educativos disponibles para este cultivo:</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2">
                    ${temasBotonesHtml}
                </div>
                <div class="pt-2">
                    <button onclick="iniciarFlujoCultivos()" class="text-[11px] text-verde font-bold hover:underline">
                        ← Cambiar de cultivo
                    </button>
                </div>
            `;

            agregarBurbujaBot(html);

        } catch (err) {
            agregarBurbujaBot(`
                <p class="text-rose-700 font-bold">Ocurrió un inconveniente al consultar los temas disponibles.</p>
                <button onclick="seleccionarCultivo(${id}, '${nombre}', '${icono}')" class="mt-2 px-3 py-1 bg-emerald-100 text-verde font-bold rounded-xl text-xs">Reintentar</button>
            `);
        }
    }

    async function seleccionarTema(temaId, temaNombre, temaIcono) {
        estadoActual.temaSeleccionado = { id: temaId, nombre: temaNombre, icono: temaIcono };
        agregarBurbujaUsuaria(`${temaIcono} ${temaNombre}`);

        const cultivo = estadoActual.cultivoSeleccionado;

        try {
            const resp = await fetch(`/chatbot/api/contenidos?cultivoId=${cultivo.id}&tema=${temaId}`);
            const recursos = await resp.json();

            estadoActual.recursosDisponibles = recursos;
            estadoActual.indiceRecursoActual = 0;

            if (!recursos || recursos.length === 0) {
                const sinContenidoHtml = `
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-2xl">
                        <p class="font-bold text-amber-900">No tenemos información disponible sobre este tema todavía. Prueba con otra combinación.</p>
                    </div>
                    <div class="pt-2 flex flex-wrap gap-2">
                        <button onclick="seleccionarCultivo(${cultivo.id}, '${cultivo.nombre}', '${cultivo.icono}')" class="px-3 py-1.5 bg-emerald-100 text-verde font-bold rounded-xl text-xs">
                            🔄 Elegir otro tema para ${cultivo.nombre}
                        </button>
                        <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-gray-100 text-gray-700 font-bold rounded-xl text-xs">
                            🌾 Cambiar de cultivo
                        </button>
                    </div>
                `;
                agregarBurbujaBot(sinContenidoHtml);
                return;
            }

            // Mostrar el primer recurso encontrado
            mostrarRecursoActual();

        } catch (err) {
            agregarBurbujaBot(`
                <p class="text-rose-700 font-bold">Ocurrió un inconveniente al cargar el contenido. Por favor intenta nuevamente.</p>
                <button onclick="seleccionarTema('${temaId}', '${temaNombre}', '${temaIcono}')" class="mt-2 px-3 py-1 bg-emerald-100 text-verde font-bold rounded-xl text-xs">Reintentar</button>
            `);
        }
    }

    function formatearTamano(bytes) {
        if (!bytes || bytes <= 0) return '';
        const kb = bytes / 1024.0;
        if (kb < 1024) return `(${kb.toFixed(1)} KB)`;
        const mb = kb / 1024.0;
        return `(${mb.toFixed(1)} MB)`;
    }

    function mostrarRecursoActual() {
        const cultivo = estadoActual.cultivoSeleccionado;
        const tema = estadoActual.temaSeleccionado;
        const index = estadoActual.indiceRecursoActual;
        const total = estadoActual.recursosDisponibles.length;
        const r = estadoActual.recursosDisponibles[index];

        // Normalización de campos tanto camelCase como PascalCase
        const rId = r.id !== undefined ? r.id : r.Id;
        const rTitulo = r.titulo || r.Titulo || 'Recurso Educativo';
        const rTipoRecurso = r.tipoRecurso !== undefined ? r.tipoRecurso : r.TipoRecurso;
        const rTieneArchivo = r.tieneArchivo !== undefined ? r.tieneArchivo : r.TieneArchivo;
        const rArchivoNombre = r.archivoNombre || r.ArchivoNombre || '';
        const rArchivoMimeType = (r.archivoMimeType || r.ArchivoMimeType || '').toLowerCase();
        const rUrl = r.url || r.Url || '';
        const rTamano = r.tamanoBytes || r.TamanoBytes || 0;
        const rNombreFuente = r.nombreFuente || r.NombreFuente || '';
        const rEnlaceFuente = r.enlaceFuente || r.EnlaceFuente || '';

        let mediaRenderHtml = '';
        let fileUrl = '';

        if (rTieneArchivo) {
            fileUrl = `/chatbot/recursos/${rId}/archivo`;
        } else if (rUrl) {
            fileUrl = rUrl;
        }

        // Determinar si es Imagen / Infografía
        const esImagen = rTipoRecurso === 2 || 
                         rTipoRecurso === 'Infografia' || 
                         rArchivoMimeType.includes('image') || 
                         rArchivoNombre.match(/\.(jpg|jpeg|png|webp|gif)$/i) ||
                         fileUrl.match(/\.(jpg|jpeg|png|webp|gif)$/i);

        // Determinar si es Video
        const esVideo = rTipoRecurso === 1 || 
                        rTipoRecurso === 'Video' || 
                        rArchivoMimeType.includes('video') || 
                        rArchivoNombre.match(/\.(mp4|webm|mkv|mov|avi)$/i) ||
                        fileUrl.includes('youtube.com') || fileUrl.includes('youtu.be') || fileUrl.endsWith('.mp4');

        if (esImagen) {
            // 🖼️ Infografía / Imagen
            mediaRenderHtml = `
                <div class="space-y-2">
                    <div class="relative group rounded-2xl overflow-hidden border border-gray-200 shadow-sm bg-gray-900 cursor-pointer" onclick="abrirMediaModal('${rTitulo.replace(/'/g, "\\'")}', '${fileUrl}', 'image')">
                        <img src="${fileUrl}" alt="${rTitulo}" class="w-full max-h-80 object-contain bg-white group-hover:opacity-95 transition-opacity" />
                        <div class="absolute bottom-2 right-2 bg-gray-900/80 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm shadow-md">
                            🔍 Toca para ampliar infografía
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between text-[11px] text-gray-500 pt-2 gap-2">
                        <span class="break-all">📦 ${rArchivoNombre || 'infografia.jpg'} ${formatearTamano(rTamano)}</span>
                        <a href="${fileUrl}" target="_blank" download class="font-bold text-verde hover:underline whitespace-nowrap">Descargar Imagen 📥</a>
                    </div>
                </div>
            `;
        } else if (esVideo) {
            // 🎬 Video
            if (rTieneArchivo || (fileUrl.endsWith('.mp4') || fileUrl.endsWith('.webm'))) {
                mediaRenderHtml = `
                    <div class="rounded-2xl overflow-hidden shadow-md bg-black border border-gray-800">
                        <video controls playsinline preload="metadata" class="w-full max-h-80 bg-black">
                            <source src="${fileUrl}" type="${rArchivoMimeType || 'video/mp4'}">
                            Tu navegador no soporta reproducción de video.
                        </video>
                    </div>
                `;
            } else if (fileUrl.includes('youtube.com') || fileUrl.includes('youtu.be')) {
                let embedUrl = fileUrl;
                if (fileUrl.includes('watch?v=')) embedUrl = fileUrl.replace('watch?v=', 'embed/');
                else if (fileUrl.includes('youtu.be/')) embedUrl = fileUrl.replace('youtu.be/', 'www.youtube.com/embed/');
                mediaRenderHtml = `
                    <div class="rounded-2xl overflow-hidden shadow-md border border-gray-200">
                        <iframe src="${embedUrl}" class="w-full h-64 border-0" allowfullscreen></iframe>
                    </div>
                `;
            } else {
                mediaRenderHtml = `
                    <div class="p-4 bg-red-50 border border-red-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <span class="font-bold text-red-900 text-xs">🎬 Video Educativo</span>
                        <a href="${fileUrl}" target="_blank" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs transition-all w-full sm:w-auto text-center">Ver Video ↗</a>
                    </div>
                `;
            }
        } else {
            // 📄 Documento PDF
            mediaRenderHtml = `
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="flex items-start gap-2.5">
                        <span class="text-3xl shrink-0">📄</span>
                        <div class="min-w-0">
                            <span class="font-extrabold text-blue-950 block text-xs break-words">${rArchivoNombre || rTitulo}</span>
                            <span class="text-[10px] text-blue-700 font-medium">Guía práctica en formato PDF ${formatearTamano(rTamano)}</span>
                        </div>
                    </div>
                    <a href="${fileUrl}" target="_blank" class="w-full sm:w-auto px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs text-center transition-all shadow-sm shrink-0">
                        Abrir / Descargar 📥
                    </a>
                </div>
            `;
        }

        const recursoHtml = `
            <div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-verde border border-emerald-200 inline-block mb-1.5">
                    ${cultivo.icono} ${cultivo.nombre} · ${tema.icono} ${tema.nombre} (Recurso ${index + 1} de ${total})
                </span>
                <h2 class="text-sm font-black text-gray-900 mb-2">${rTitulo}</h2>
            </div>

            ${mediaRenderHtml}

            ${rNombreFuente ? `
                <div class="mt-3 flex items-center gap-1.5 text-[11px] text-gray-500 font-medium bg-gray-50 p-2 rounded-lg border border-gray-100">
                    <span>📚 Fuente:</span>
                    ${rEnlaceFuente ? 
                        `<a href="${rEnlaceFuente}" target="_blank" class="text-blue-600 hover:underline font-bold truncate block max-w-xs">${rNombreFuente}</a>` 
                        : `<span class="font-bold text-gray-700">${rNombreFuente}</span>`
                    }
                </div>
            ` : ''}

            <!-- Encuesta de satisfacción rápida -->
            <div class="pt-3 border-t border-gray-100">
                <p class="font-extrabold text-gray-800 text-xs mb-2">¿Te sirvió esta información?</p>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="responderFeedback('si')" class="px-3 py-1.5 bg-emerald-600 hover:bg-verde text-white font-bold rounded-xl text-xs transition-all shadow-sm flex items-center gap-1">
                        <span>🟢</span> <span>Sí, ¡muchas gracias!</span>
                    </button>
                    <button onclick="responderFeedback('no')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 font-bold rounded-xl text-xs border border-rose-200 transition-all flex items-center gap-1">
                        <span>🔴</span> <span>No</span>
                    </button>
                    ${total > 1 ? `
                        <button onclick="mostrarSiguienteRecurso()" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold rounded-xl text-xs border border-amber-200 transition-all flex items-center gap-1">
                            <span>🔄</span> <span>Ver más recursos (${index + 1}/${total})</span>
                        </button>
                    ` : ''}
                </div>
            </div>
        `;

        agregarBurbujaBot(recursoHtml);
    }

    function responderFeedback(tipo) {
        const cultivo = estadoActual.cultivoSeleccionado;
        if (tipo === 'si') {
            agregarBurbujaUsuaria("🟢 Sí, ¡muchas gracias!");
            const html = `
                <p class="font-bold text-verde">¡Nos alegra muchísimo que te haya servido! 😊</p>
                <p class="text-gray-600">¿Quieres consultar otro tema para <strong>${cultivo?.nombre || 'tus cultivos'}</strong> o volver al menú principal?</p>
                <div class="pt-2 flex flex-wrap gap-2">
                    <button onclick="seleccionarCultivo(${cultivo.id}, '${cultivo.nombre}', '${cultivo.icono}')" class="px-3 py-1.5 bg-emerald-100 text-verde font-bold rounded-xl text-xs">
                        🌾 Consultar otro tema de ${cultivo.nombre}
                    </button>
                    <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-gray-100 text-gray-800 font-bold rounded-xl text-xs">
                        🌱 Ver otros cultivos
                    </button>
                    <a href="/chatbot/lecciones" class="px-3 py-1.5 bg-amber-100 text-amber-900 font-bold rounded-xl text-xs">
                        🎓 Ir al Modo Lección
                    </a>
                </div>
            `;
            agregarBurbujaBot(html);
        } else {
            agregarBurbujaUsuaria("🔴 No fue suficiente");
            const total = estadoActual.recursosDisponibles.length;
            const tieneMas = (estadoActual.indiceRecursoActual + 1) < total;

            const html = `
                <p class="font-bold text-gray-800">Lo sentimos. ¿Quieres que te mostremos otro recurso sobre este tema o probar con otro cultivo?</p>
                <div class="pt-2 flex flex-wrap gap-2">
                    ${tieneMas ? `
                        <button onclick="mostrarSiguienteRecurso()" class="px-3 py-1.5 bg-amber-600 text-white font-bold rounded-xl text-xs shadow-sm">
                            🔄 Ver siguiente recurso disponible
                        </button>
                    ` : `
                        <span class="text-xs text-gray-500 italic block w-full mb-1">No hay más recursos disponibles sobre este tema.</span>
                    `}
                    <button onclick="seleccionarCultivo(${cultivo.id}, '${cultivo.nombre}', '${cultivo.icono}')" class="px-3 py-1.5 bg-emerald-100 text-verde font-bold rounded-xl text-xs">
                        🌾 Elegir otro tema
                    </button>
                    <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-gray-100 text-gray-800 font-bold rounded-xl text-xs">
                        🌱 Cambiar de cultivo
                    </button>
                </div>
            `;
            agregarBurbujaBot(html);
        }
    }

    function mostrarSiguienteRecurso() {
        const total = estadoActual.recursosDisponibles.length;
        if (estadoActual.indiceRecursoActual + 1 < total) {
            estadoActual.indiceRecursoActual++;
            agregarBurbujaUsuaria("🔄 Ver más recursos");
            mostrarRecursoActual();
        } else {
            agregarBurbujaUsuaria("🔄 Ver más");
            const html = `
                <p class="font-bold text-amber-900">No hay más recursos disponibles sobre este tema en este momento.</p>
                <div class="pt-2 flex flex-wrap gap-2">
                    <button onclick="seleccionarCultivo(${estadoActual.cultivoSeleccionado.id}, '${estadoActual.cultivoSeleccionado.nombre}', '${estadoActual.cultivoSeleccionado.icono}')" class="px-3 py-1.5 bg-emerald-100 text-verde font-bold rounded-xl text-xs">
                        🌾 Elegir otro tema
                    </button>
                    <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-gray-100 text-gray-800 font-bold rounded-xl text-xs">
                        🌱 Cambiar de cultivo
                    </button>
                </div>
            `;
            agregarBurbujaBot(html);
        }
    }

    // ─── Modal de Medios / Zoom ────────────────────────────────────────────

    function abrirMediaModal(titulo, url, tipo) {
        document.getElementById('media-modal-title').innerText = titulo;
        const container = document.getElementById('media-modal-body');
        container.innerHTML = '';

        if (tipo === 'image') {
            document.getElementById('media-modal-icon').innerText = '🖼️';
            container.innerHTML = `<img src="${url}" alt="${titulo}" class="max-h-[75vh] max-w-full object-contain rounded-2xl shadow-2xl" />`;
        }

        document.getElementById('media-modal').classList.remove('hidden');
    }

    function cerrarMediaModal() {
        document.getElementById('media-modal').classList.add('hidden');
        document.getElementById('media-modal-body').innerHTML = '';
    }

    // ─── Flujo 3: Consulta del Calendario Lunar Agrícola de Caldono ──────────
    async function consultarCalendarioLunarChatbot() {
        agregarBurbujaUsuaria("🌒 ¿En qué fase lunar estamos y qué labores se recomiendan en Caldono?");

        try {
            const resp = await fetch('/api/mapa/lunar');
            if (!resp.ok) throw new Error("No se pudo obtener la fase lunar");
            const data = await resp.json();

            let recsHtml = '';
            if (data.practicasRecomendadas && data.practicasRecomendadas.length > 0) {
                recsHtml = data.practicasRecomendadas.slice(0, 3).map(p => `
                    <li class="flex items-start gap-2 text-xs text-slate-700">
                        <span class="text-emerald-600 font-bold">${p.iconoPractica || '🌱'}</span>
                        <div><strong>${p.practica}:</strong> ${p.recomendacion}</div>
                    </li>
                `).join('');
            }

            const html = `
                <div class="space-y-3">
                    <div class="p-3.5 bg-gradient-to-r from-indigo-950 to-slate-900 text-white rounded-2xl border border-indigo-500/30 flex items-center gap-3">
                        <span class="text-4xl">${data.icono}</span>
                        <div>
                            <span class="text-[10px] text-indigo-300 font-bold uppercase tracking-wider block">Fase Lunar Actual · Caldono (Cauca)</span>
                            <h4 class="text-base font-extrabold text-white">${data.nombreFase}</h4>
                            <p class="text-[11px] text-indigo-200">Iluminación: <strong>${data.porcentajeIluminacion}</strong> • Cambia a <strong>${data.nombreProximaFase}</strong> en <strong>${data.diasParaProximoCambio} días</strong></p>
                        </div>
                    </div>

                    <div>
                        <p class="font-bold text-xs text-gray-800 mb-1.5">🌿 Labores y recomendaciones de ASCAMPESINA para esta fase:</p>
                        <ul class="space-y-1.5 bg-white p-3 rounded-xl border border-gray-100 shadow-sm">
                            ${recsHtml || '<li class="text-xs text-gray-500 italic">No hay prácticas registradas para esta fase.</li>'}
                        </ul>
                    </div>

                    <div class="pt-2 flex flex-wrap gap-2">
                        <a href="/mapa/lunar" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs flex items-center gap-1 shadow-sm">
                            <span>📖</span> Ver Calendario Completo del Mes
                        </a>
                        <button onclick="iniciarFlujoCultivos()" class="px-3.5 py-2 bg-emerald-100 hover:bg-emerald-200 text-verde font-bold rounded-xl text-xs">
                            🌾 Aprender de mis cultivos
                        </button>
                        <button onclick="reiniciarChat()" class="px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl text-xs">
                            🔄 Menú Principal
                        </button>
                    </div>
                </div>
            `;

            agregarBurbujaBot(html);

        } catch (err) {
            console.error(err);
            agregarBurbujaBot(`
                <p class="text-xs text-gray-700">No se pudo consultar el cálculo lunar en este momento. Puedes ingresar directamente a la sección de <a href="/mapa/lunar" class="text-indigo-600 font-bold underline">Calendario Lunar</a>.</p>
                <div class="pt-2">
                    <button onclick="reiniciarChat()" class="px-3 py-1.5 bg-gray-100 text-gray-800 font-bold rounded-xl text-xs">🔄 Volver</button>
                </div>
            `);
        }
    }
</script>
