@using InnovaFemIA.Web.Features.Shared.Entities
@{
    ViewData["Title"] = "Asalia — Asistente Educativo Chatbot";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Chatbot.CultivoChatbotDto> ?? [];
    var lecciones = ViewBag.Lecciones as IEnumerable<InnovaFemIA.Web.Features.Chatbot.LeccionResumenDto> ?? [];
}

<div class="min-h-[calc(100vh-4rem)] bg-gray-50 py-6 px-3 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto flex flex-col h-[85vh] bg-white rounded-3xl border border-gray-100 shadow-xl overflow-hidden">
        
        <!-- Header del Chatbot -->
        <header class="bg-white px-4 sm:px-6 py-4 flex items-center justify-between border-b border-gray-100 shrink-0">
            <div class="flex items-center gap-3.5">
                <div class="relative">
                    <div class="w-12 h-12 rounded-2xl bg-naranja-light text-naranja flex items-center justify-center text-2xl shadow-sm border border-naranja/10">
                        👩‍🌾
                    </div>
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-naranja border-2 border-white rounded-full animate-pulse"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-black text-base sm:text-lg tracking-tight"><span class="text-verde">Asal</span><span class="text-morado">ia</span></h1>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-naranja-light border border-naranja/20 text-naranja">
                            Asistente Educativo
                        </span>
                    </div>
                    <p class="text-xs text-gray-500 font-medium">InnovaFemIA · Saberes productivos, agroecológicos y de biocomercio en Caldono, Cauca.</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a href="/chatbot/lecciones" class="hidden sm:flex items-center gap-1.5 px-3.5 py-2 btn-secondary text-xs">
                    <span>🎓</span>
                    <span>Modo Lección</span>
                </a>
                <button onclick="reiniciarChat()" title="Reiniciar conversación" class="p-2.5 btn-secondary flex items-center gap-1">
                    <span>🔄</span>
                    <span class="hidden md:inline">Reiniciar</span>
                </button>
            </div>
        </header>

        <!-- Contenedor scrollable de mensajes -->
        <main id="chat-messages" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 bg-gray-50/50 scroll-smooth">
            <!-- Los mensajes se insertan dinámicamente aquí mediante JavaScript -->
        </main>

        <!-- Barra inferior / Menú de Acciones Rápidas -->
        <footer class="p-3.5 bg-white border-t border-gray-100 flex flex-wrap items-center justify-between gap-2 shrink-0">
            <div class="flex items-center gap-1.5 overflow-x-auto py-1 max-w-full text-xs">
                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider pl-1">Accesos:</span>
                <button onclick="iniciarFlujoCultivos()" class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-verde font-bold rounded-xl border border-emerald-200/80 transition-all flex items-center gap-1 shrink-0">
                    🌾 Consultar Cultivos
                </button>
                <a href="/chatbot/lecciones" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold rounded-xl border border-amber-200/80 transition-all flex items-center gap-1 shrink-0">
                    🎓 Modo Lección
                </a>
            </div>
            <div class="text-[11px] text-gray-400 font-medium hidden sm:block">
                InnovafemIA.
            </div>
        </footer>
    </div>
</div>

<!-- Modal Visualizador de Medios / Zoom -->
<div id="media-modal" class="fixed inset-0 z-50 hidden bg-gray-950/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl border border-gray-100 flex flex-col max-h-[90vh]">
        <div class="bg-gray-900 text-white p-4 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-2">
                <span id="media-modal-icon" class="text-xl">🖼️</span>
                <h3 id="media-modal-title" class="font-black text-sm text-white truncate max-w-md">Vista Previa</h3>
            </div>
            <button onclick="cerrarMediaModal()" class="text-white hover:text-gray-300 font-bold text-xl px-2">✕</button>
        </div>
        <div id="media-modal-body" class="p-6 overflow-y-auto flex-1 flex items-center justify-center bg-gray-950 text-white">
            <!-- Contenido dinámico -->
        </div>
        <div class="p-3.5 bg-gray-900 border-t border-gray-800 flex justify-end">
            <button onclick="cerrarMediaModal()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold rounded-xl text-xs">Cerrar</button>
        </div>
    </div>
</div>

<script id="cultivos-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cultivos))
</script>
<script src="~/js/chatbot/chatbot-chat.js" asp-append-version="true"></script>
