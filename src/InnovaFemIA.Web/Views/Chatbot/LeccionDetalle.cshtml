@model InnovaFemIA.Web.Features.Chatbot.LeccionDetalleDto
@{
    ViewData["Title"] = $"{Model.Titulo} — Modo Lección";
}

<div class="min-h-[calc(100vh-4rem)] bg-gradient-to-b from-amber-50/40 via-emerald-50/20 to-gray-50 flex items-center justify-center p-4 sm:p-6">
    <div class="max-w-2xl w-full bg-white rounded-3xl border border-gray-100 shadow-2xl overflow-hidden flex flex-col min-h-[580px]">
        
        <!-- Header con Barra de Progreso Duolingo -->
        <header class="p-4 sm:p-5 border-b border-gray-100 flex items-center justify-between gap-4 shrink-0 bg-white">
            <a href="/chatbot/lecciones" title="Salir de la lección" class="text-gray-400 hover:text-gray-700 font-black text-xl px-2 py-1 transition-colors">
                ✕
            </a>

            <!-- Barra de Progreso -->
            <div class="flex-1 max-w-md bg-gray-100 h-3.5 rounded-full overflow-hidden p-0.5 border border-gray-200">
                <div id="progreso-barra" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full rounded-full transition-all duration-500 shadow-sm" style="width: 0%;"></div>
            </div>

            <!-- Contador de Pregunta -->
            <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-xs font-black text-emerald-900" id="texto-progreso-paso">1 / @Model.Preguntas.Count</span>
            </div>
        </header>

        <!-- Contenedor Principal de Preguntas -->
        <main id="pantalla-juego" class="flex-1 p-6 sm:p-8 overflow-y-auto space-y-6 flex flex-col justify-between">
            <div id="contenedor-pregunta" class="space-y-6">
                <!-- Se llena dinámicamente con JavaScript -->
            </div>

            <!-- Barra Inferior de Acción -->
            <div id="barra-accion" class="pt-4 border-t border-gray-100 flex items-center justify-between gap-3 shrink-0">
                <div id="mensaje-feedback" class="text-xs font-bold text-gray-500">
                    Selecciona una respuesta para continuar
                </div>
                <button id="btn-comprobar" onclick="comprobarRespuesta()" disabled class="px-6 py-3 bg-gray-200 text-gray-400 font-black text-xs rounded-2xl transition-all shadow-sm cursor-not-allowed">
                    Comprobar
                </button>
            </div>
        </main>

        <!-- Pantalla Final de Felicitaciones / Resumen -->
        <section id="pantalla-resumen" class="hidden flex-1 p-8 text-center flex-col items-center justify-center space-y-6 bg-gradient-to-b from-white via-emerald-50/40 to-emerald-100/30">
            <div class="w-24 h-24 rounded-3xl bg-amber-100 text-amber-600 flex items-center justify-center text-5xl mx-auto shadow-lg animate-bounce border-2 border-amber-300">
                🏆
            </div>

            <div class="space-y-1">
                <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-900 border border-emerald-300 inline-block mb-1">
                    ¡Lección Completada!
                </span>
                <h2 class="text-2xl font-black text-gray-900">@Model.Titulo</h2>
                <p class="text-xs text-gray-500">Has fortalecido tus saberes agroecológicos de Caldono</p>
            </div>

            <!-- Métricas de la Sesión -->
            <div class="grid grid-cols-2 gap-4 w-full max-w-xs">
                <div class="p-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
                    <span class="text-2xl block mb-1">🎯</span>
                    <span id="resumen-aciertos" class="text-base font-black text-gray-900 block leading-tight">0 / 0</span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase">Respuestas Correctas</span>
                </div>
                <div class="p-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
                    <span class="text-2xl block mb-1">📊</span>
                    <span id="resumen-precision" class="text-base font-black text-emerald-900 block leading-tight">100%</span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase">Precisión</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 w-full max-w-sm pt-2">
                <a href="/chatbot/lecciones" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-2xl shadow-md transition-all text-center">
                    Ver Más Lecciones 🎓
                </a>
                <a href="/chatbot" class="w-full py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-2xl transition-all text-center">
                    Volver al Asistente 🌾
                </a>
            </div>
        </section>
    </div>
</div>

<script>
    const LECCION_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    let indicePregunta = 0;
    let opcionSeleccionada = null;
    let totalAciertos = 0;
    let yaComprobado = false;

    document.addEventListener('DOMContentLoaded', () => {
        if (!LECCION_DATA || !LECCION_DATA.Preguntas || LECCION_DATA.Preguntas.length === 0) {
            document.getElementById('contenedor-pregunta').innerHTML = `
                <div class="p-8 text-center text-gray-500 italic">
                    Esta lección aún no contiene preguntas registradas.
                </div>
            `;
            return;
        }

        cargarPreguntaActual();
    });

    function cargarPreguntaActual() {
        yaComprobado = false;
        opcionSeleccionada = null;

        const totalPreguntas = LECCION_DATA.Preguntas.length;
        const p = LECCION_DATA.Preguntas[indicePregunta];

        // Actualizar barra de progreso
        const porcentaje = Math.round(((indicePregunta) / totalPreguntas) * 100);
        document.getElementById('progreso-barra').style.width = `${porcentaje}%`;
        document.getElementById('texto-progreso-paso').innerText = `${indicePregunta + 1} / ${totalPreguntas}`;

        // Reset barra de acción
        const btn = document.getElementById('btn-comprobar');
        btn.disabled = true;
        btn.className = 'px-6 py-3 bg-gray-200 text-gray-400 font-black text-xs rounded-2xl transition-all shadow-sm cursor-not-allowed';
        btn.innerText = 'Comprobar';
        btn.onclick = comprobarRespuesta;
        document.getElementById('mensaje-feedback').innerHTML = 'Selecciona una respuesta para continuar';

        // Renderizar explicación previa (si tiene)
        let explicacionHtml = '';
        if (p.ContenidoExplicativo || p.TieneImagenExplicativa) {
            explicacionHtml = `
                <div class="p-4 bg-emerald-50/70 border border-emerald-200/80 rounded-2xl space-y-2">
                    <div class="flex items-center gap-1.5 text-emerald-900 font-extrabold text-[11px] uppercase tracking-wider">
                        <span>💡</span>
                        <span>Saberes Agroecológicos:</span>
                    </div>
                    ${p.TieneImagenExplicativa ? `
                        <div class="rounded-xl overflow-hidden shadow-xs border border-emerald-200 max-h-48 bg-white">
                            <img src="/chatbot/preguntas/${p.Id}/imagen" alt="Ilustración explicativa" class="w-full h-full object-cover max-h-48" />
                        </div>
                    ` : ''}
                    ${p.ContenidoExplicativo ? `<p class="text-xs text-emerald-950 leading-relaxed">${p.ContenidoExplicativo}</p>` : ''}
                </div>
            `;
        }

        // Renderizar opciones de respuesta (3 a 4 opciones)
        const opcionesHtml = p.Opciones.map((op, idx) => `
            <button id="opcion-btn-${op.Id}" 
                    type="button" 
                    onclick="seleccionarOpcion(${op.Id})" 
                    class="opcion-card w-full p-4 bg-white hover:bg-emerald-50/40 border-2 border-gray-200 hover:border-emerald-400 rounded-2xl font-bold text-xs text-gray-800 text-left transition-all flex items-center justify-between gap-3 shadow-xs">
                <div class="flex items-center gap-3">
                    <span class="w-6 h-6 rounded-full bg-gray-100 text-gray-600 font-extrabold text-[10px] flex items-center justify-center shrink-0">
                        ${String.fromCharCode(65 + idx)}
                    </span>
                    <span class="leading-snug">${op.TextoOpcion}</span>
                </div>
                <div id="opcion-indicator-${op.Id}" class="w-4 h-4 rounded-full border-2 border-gray-300 shrink-0"></div>
            </button>
        `).join('');

        const preguntaHtml = `
            ${explicacionHtml}

            <div class="space-y-3">
                <h3 class="text-base sm:text-lg font-black text-gray-900 leading-snug">
                    ${p.TextoPregunta}
                </h3>
                <div class="space-y-2.5 pt-1">
                    ${opcionesHtml}
                </div>
            </div>
        `;

        document.getElementById('contenedor-pregunta').innerHTML = preguntaHtml;
    }

    function seleccionarOpcion(opcionId) {
        if (yaComprobado) return;

        opcionSeleccionada = opcionId;

        // Deseleccionar todas las opciones visualmente
        document.querySelectorAll('.opcion-card').forEach(c => {
            c.classList.remove('border-emerald-600', 'bg-emerald-50', 'shadow-md');
            c.classList.add('border-gray-200', 'bg-white');
        });

        // Marcar la opción activa
        const selectedBtn = document.getElementById(`opcion-btn-${opcionId}`);
        if (selectedBtn) {
            selectedBtn.classList.remove('border-gray-200', 'bg-white');
            selectedBtn.classList.add('border-emerald-600', 'bg-emerald-50', 'shadow-md');
        }

        // Habilitar botón comprobar
        const btn = document.getElementById('btn-comprobar');
        btn.disabled = false;
        btn.className = 'px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-2xl transition-all shadow-md cursor-pointer';
        document.getElementById('mensaje-feedback').innerHTML = '<span class="text-emerald-800 font-bold">¡Opción lista! Haz clic en Comprobar</span>';
    }

    function comprobarRespuesta() {
        if (!opcionSeleccionada || yaComprobado) return;
        yaComprobado = true;

        const p = LECCION_DATA.Preguntas[indicePregunta];
        const opcionElegida = p.Opciones.find(o => o.Id === opcionSeleccionada);
        const opcionCorrecta = p.Opciones.find(o => o.EsCorrecta);

        const esAcierto = opcionElegida && opcionElegida.EsCorrecta;
        if (esAcierto) totalAciertos++;

        // Resaltar visualmente las opciones con verde/rojo
        p.Opciones.forEach(op => {
            const btnEl = document.getElementById(`opcion-btn-${op.Id}`);
            if (op.EsCorrecta) {
                btnEl.className = 'opcion-card w-full p-4 bg-emerald-100 border-2 border-emerald-500 rounded-2xl font-bold text-xs text-emerald-950 text-left flex items-center justify-between gap-3 shadow-md';
            } else if (op.Id === opcionSeleccionada && !op.EsCorrecta) {
                btnEl.className = 'opcion-card w-full p-4 bg-rose-100 border-2 border-rose-500 rounded-2xl font-bold text-xs text-rose-950 text-left flex items-center justify-between gap-3 shadow-md';
            }
        });

        // Banner de retroalimentación
        const feedbackEl = document.getElementById('mensaje-feedback');
        if (esAcierto) {
            const retro = opcionElegida.Retroalimentacion || '¡Excelente! Respuesta correcta.';
            feedbackEl.innerHTML = `
                <div class="text-emerald-800 font-black flex items-center gap-1.5">
                    <span class="text-base">🌟</span>
                    <span>${retro}</span>
                </div>
            `;
        } else {
            const retro = (opcionElegida && opcionElegida.Retroalimentacion) ? opcionElegida.Retroalimentacion : `Respuesta correcta: ${opcionCorrecta ? opcionCorrecta.TextoOpcion : ''}`;
            feedbackEl.innerHTML = `
                <div class="text-rose-800 font-bold flex items-center gap-1.5">
                    <span class="text-base">❌</span>
                    <span>${retro}</span>
                </div>
            `;
        }

        // Cambiar botón a "Continuar"
        const btn = document.getElementById('btn-comprobar');
        btn.innerText = 'Continuar →';
        btn.className = 'px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-2xl transition-all shadow-md cursor-pointer';
        btn.onclick = avanzarPregunta;
    }

    function avanzarPregunta() {
        indicePregunta++;
        const totalPreguntas = LECCION_DATA.Preguntas.length;

        if (indicePregunta < totalPreguntas) {
            cargarPreguntaActual();
        } else {
            finalizarLeccion();
        }
    }

    function finalizarLeccion() {
        document.getElementById('progreso-barra').style.width = '100%';
        document.getElementById('pantalla-juego').classList.add('hidden');
        document.getElementById('pantalla-resumen').classList.remove('hidden');

        const totalPreguntas = LECCION_DATA.Preguntas.length;
        const precision = Math.round((totalAciertos / totalPreguntas) * 100);

        document.getElementById('resumen-aciertos').innerText = `${totalAciertos} / ${totalPreguntas}`;
        document.getElementById('resumen-precision').innerText = `${precision}%`;

        // Guardar progreso en localStorage
        guardarProgresoEnLocalStorage(LECCION_DATA.Id);
    }

    function guardarProgresoEnLocalStorage(leccionId) {
        const key = 'innovafemia_lecciones_progreso';
        let progreso = {};
        try {
            progreso = JSON.parse(localStorage.getItem(key) || '{}');
        } catch {
            progreso = {};
        }

        if (!progreso.completadas) progreso.completadas = [];
        if (!progreso.completadas.includes(leccionId)) {
            progreso.completadas.push(leccionId);
        }

        progreso.ultimaFecha = new Date().toISOString();
        localStorage.setItem(key, JSON.stringify(progreso));
    }
</script>
