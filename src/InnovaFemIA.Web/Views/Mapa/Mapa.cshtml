@{
    ViewData["Title"] = "Mapa Interactivo de Caldono, Cauca";
    ViewData["Description"] = "Mapa georreferenciado del Municipio de Caldono, Cauca. Explora la ubicación de familias campesinas de ASCAMPESINA, veredas, asociaciones y puntos de compra.";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerCultivos.CultivoDto> ?? [];
}

@section Head {
    <!-- Leaflet.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        /* Estilo para resplandor y marcadores personalizados */
        .caldono-glow {
            filter: drop-shadow(0 0 12px rgba(34, 197, 94, 0.6));
            animation: pulse-glow 3s infinite ease-in-out;
        }

        @@keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 8px rgba(34, 197, 94, 0.5)); }
            50% { filter: drop-shadow(0 0 18px rgba(147, 51, 234, 0.7)); }
        }

        .custom-pin-familia {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg, #16a34a, #15803d);
            border: 2.5px solid #ffffff;
            box-shadow: 0 4px 14px rgba(22, 163, 74, 0.45);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            transition: all 0.2s ease;
            cursor: pointer;
            overflow: hidden;
        }

        .custom-pin-familia img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            display: block;
        }

        .custom-pin-familia:hover {
            transform: scale(1.2);
            box-shadow: 0 8px 22px rgba(22, 163, 74, 0.7);
            z-index: 9999 !important;
        }

        .custom-pin-asociacion {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #d97706, #b45309);
            border: 2.5px solid #ffffff;
            box-shadow: 0 4px 14px rgba(217, 119, 6, 0.45);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .custom-pin-asociacion:hover {
            transform: scale(1.2);
            box-shadow: 0 8px 22px rgba(217, 119, 6, 0.7);
            z-index: 9999 !important;
        }

        .custom-pin-punto {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: 2.5px solid #ffffff;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .custom-pin-punto:hover {
            transform: scale(1.2);
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.7);
            z-index: 9999 !important;
        }

        .leaflet-popup-content-wrapper {
            border-radius: 1rem !important;
            padding: 0 !important;
            background: #ffffff !important;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.25), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
            border: 1px solid #f3f4f6 !important;
            overflow: hidden !important;
        }
        .leaflet-popup-content {
            margin: 0 !important;
            width: 280px !important;
            min-width: 280px !important;
            line-height: 1.5 !important;
        }

        /* Tarjeta flotante de vista previa (Google Maps Style) */
        .leaflet-tooltip.gm-preview-card {
            background: rgba(255, 255, 255, 0.98) !important;
            border: 1.5px solid #10b981 !important;
            border-radius: 0.85rem !important;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14) !important;
            padding: 4px 8px !important;
            color: #111827 !important;
            font-family: inherit !important;
            white-space: nowrap !important;
            pointer-events: auto !important;
            cursor: pointer !important;
            transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease !important;
        }

        .leaflet-tooltip.gm-preview-card.card-asociacion {
            border-color: #d97706 !important;
        }

        .leaflet-tooltip.gm-preview-card.card-punto {
            border-color: #2563eb !important;
        }

        .leaflet-tooltip.gm-preview-card:hover {
            transform: scale(1.05) translateY(-2px) !important;
            box-shadow: 0 10px 24px rgba(16, 185, 129, 0.3) !important;
            z-index: 10000 !important;
        }

        /* Cuando está alejado (zoom < 15.5), las tarjetas permanentes se ocultan para mantener el mapa limpio */
        #mapa-caldono.zoom-lejano .leaflet-tooltip.gm-preview-card {
            display: none !important;
        }

        /* En zoom muy cercano (zoom >= 15.5), se muestran todas las tarjetas automáticamente para ver la información desde arriba sin dar clicks */
        #mapa-caldono:not(.zoom-lejano) .leaflet-tooltip.gm-preview-card {
            display: flex !important;
            opacity: 1 !important;
        }

        .leaflet-tooltip-top.gm-preview-card:before {
            border-top-color: #10b981 !important;
        }
        .leaflet-tooltip-bottom.gm-preview-card:before {
            border-bottom-color: #10b981 !important;
        }
        .leaflet-tooltip-top.gm-preview-card.card-asociacion:before {
            border-top-color: #d97706 !important;
        }
        .leaflet-tooltip-bottom.gm-preview-card.card-asociacion:before {
            border-bottom-color: #d97706 !important;
        }
        .leaflet-tooltip-top.gm-preview-card.card-punto:before {
            border-top-color: #2563eb !important;
        }
        .leaflet-tooltip-bottom.gm-preview-card.card-punto:before {
            border-bottom-color: #2563eb !important;
        }

    </style>
}

<div class="relative min-h-[calc(100vh-4rem)] flex flex-col lg:flex-row bg-gray-100">

    <!-- ── Sidebar Flotante de Filtros y Control ───────────────────────── -->
    <aside class="w-full lg:w-96 bg-white border-r border-gray-200 z-20 flex flex-col shrink-0 shadow-lg">
        
        <!-- Header del Sidebar -->
        <div class="p-5 bg-white border-b border-gray-100">
            <div class="flex items-center justify-between mb-2">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-cian-light text-cian border border-cian/20 inline-flex items-center gap-1.5 uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-cian animate-pulse"></span>
                    Territorio Local
                </span>
                <a href="/mapa/directorio" class="text-[11px] text-cian hover:text-cian/80 transition-colors font-bold uppercase tracking-wider">
                    Ver Directorio →
                </a>
            </div>
            <h1 class="text-xl font-black text-gray-900 flex items-center gap-2 mt-2">
                <span>🗺️</span> Mapa de Caldono
            </h1>
            <p class="text-xs text-gray-500 mt-1 leading-relaxed font-medium">
                Georreferenciación de familias productoras, veredas y centros de acopio campesino.
            </p>

            <!-- Estadísticas en vivo -->
            <div class="grid grid-cols-3 gap-2 mt-4 pt-3 border-t border-gray-100 text-center">
                <div class="bg-gray-50 rounded-xl p-2 border border-gray-100">
                    <span class="block font-black text-lg text-gray-900" id="stat-familias">0</span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Familias</span>
                </div>
                <div class="bg-gray-50 rounded-xl p-2 border border-gray-100">
                    <span class="block font-black text-lg text-gray-900" id="stat-veredas">0</span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Veredas</span>
                </div>
                <div class="bg-gray-50 rounded-xl p-2 border border-gray-100">
                    <span class="block font-black text-lg text-gray-900" id="stat-actores">0</span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Actores</span>
                </div>
            </div>
        </div>

        <!-- Formulario de Filtros Dinámicos -->
        <div class="p-5 flex-1 overflow-y-auto space-y-4">
            
            <!-- Búsqueda rápida -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    Buscar en Caldono
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🔍</span>
                    <input type="text"
                           id="map-search"
                           placeholder="Buscar por vereda, familia o producto..."
                           class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-xs text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cian focus:bg-white transition-all" />
                </div>
            </div>

            <!-- Filtro por Cultivo -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    Filtrar por Cultivo
                </label>
                <select id="map-filter-cultivo" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-cian focus:bg-white transition-all">
                    <option value="">🌱 Todos los cultivos</option>
                    @foreach (var c in cultivos)
                    {
                        <option value="@c.Id">@c.Icono @c.Nombre</option>
                    }
                </select>
            </div>

            <!-- Filtro por Tipo de Actor -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    Capas del Mapa
                </label>
                <div class="space-y-2 text-xs">
                    <label class="flex items-center gap-2.5 p-2 rounded-xl border border-gray-100 hover:bg-gray-50 cursor-pointer transition-colors">
                        <input type="checkbox" id="check-familias" checked class="w-4 h-4 text-cian rounded focus:ring-cian" />
                        <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block"></span>
                        <span class="font-medium text-gray-700">Familias ASCAMPESINA</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2 rounded-xl border border-gray-100 hover:bg-gray-50 cursor-pointer transition-colors">
                        <input type="checkbox" id="check-asociaciones" checked class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                        <span class="w-3 h-3 rounded-full bg-amber-600 inline-block"></span>
                        <span class="font-medium text-gray-700">Asociaciones Aliadas</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2 rounded-xl border border-gray-100 hover:bg-gray-50 cursor-pointer transition-colors">
                        <input type="checkbox" id="check-puntos" checked class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span>
                        <span class="font-medium text-gray-700">Puntos de Compra / Acopio</span>
                    </label>
                </div>
            </div>

            <!-- Controles del Visor -->
            <div class="pt-3 border-t border-gray-100 space-y-2">
                <button id="btn-recenter" class="w-full btn-secondary text-xs py-2 justify-center">
                    📍 Centrar en Caldono, Cauca
                </button>
                <div class="flex items-center justify-between text-[11px] text-gray-500 pt-1">
                    <span>Estilo de Mapa:</span>
                    <button id="btn-toggle-tiles" class="text-cian font-semibold hover:underline">
                        Cambiar a Satelital
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer del Sidebar -->
        <div class="p-4 border-t border-gray-100 bg-gray-50 text-[11px] text-gray-500 text-center font-medium">
            Coordenadas Centrales: 2.8139° N, 76.5369° W · Caldono, Cauca
        </div>
    </aside>

    <!-- ── Contenedor del Mapa Leaflet ────────────────────────────────── -->
    <main class="flex-1 relative min-h-[500px] lg:min-h-full">
        
        <!-- Banner flotante indicador del municipio -->
        <div class="absolute top-4 left-4 right-4 sm:right-auto z-10 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-lg border border-gray-200 flex items-center gap-3">
            <span class="text-2xl animate-bounce">📍</span>
            <div>
                <h2 class="text-xs font-bold text-gray-900 leading-tight">Municipio de Caldono, Cauca</h2>
                <p class="text-[10px] text-verde font-semibold">Zona de Resguardo y Territorio Agroecológico ASCAMPESINA</p>
            </div>
        </div>

        <!-- Div principal donde Leaflet renderiza el mapa -->
        <div id="mapa-caldono" class="w-full h-full min-h-[550px]"></div>
    </main>

</div>

<!-- ── Botón Flotante de Lunita (🌒) Fases Lunares de Caldono ────────────────── -->
<button id="btn-flotante-lunar"
        onclick="abrirPanelLunar()"
        title="Consultar Calendario Lunar y Prácticas Agrícolas de Caldono"
        class="fixed bottom-6 right-6 z-[1000] group flex items-center gap-3 px-4 sm:px-5 py-3 rounded-full bg-white/95 text-purple-950 border-2 border-purple-200 shadow-xl hover:border-purple-400 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 backdrop-blur-md cursor-pointer">
    <span id="icono-lunar-btn" class="text-2xl sm:text-3xl animate-bounce">🌒</span>
    <div class="text-left">
        <span class="block text-[9px] font-black text-purple-600 uppercase tracking-widest leading-none">Fase Lunar · Caldono</span>
        <span id="nombre-lunar-btn" class="block text-xs font-black text-purple-950 leading-tight">Cargando luna...</span>
    </div>
    <span class="w-2.5 h-2.5 rounded-full bg-purple-500 animate-ping hidden sm:inline-block"></span>
</button>

<!-- ── Panel Modal Interactivo del Módulo Lunar de Caldono ──────────────────── -->
<div id="modal-lunar" class="fixed inset-0 z-[99999] hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 overflow-y-auto">
    <div class="bg-white text-gray-900 rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl border border-purple-100 transform transition-all my-auto max-h-[90vh] flex flex-col">
        
        <!-- Header del Modal Lunar -->
        <div class="relative bg-gradient-to-r from-purple-950 via-indigo-900 to-slate-900 text-white p-6 border-b border-purple-800 shrink-0">
            <button onclick="cerrarPanelLunar()" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-lg transition-colors cursor-pointer">
                ✕
            </button>
            <div class="flex items-center gap-2 mb-2">
                <span class="px-2.5 py-0.5 rounded-full bg-purple-400/20 text-purple-200 border border-purple-300/30 text-[10px] font-extrabold uppercase tracking-wider">
                    📍 Caldono, Cauca (2.7978° N, -76.4828° W) • 1.800 msnm
                </span>
            </div>
            <div class="flex items-center gap-4">
                <div id="lunar-modal-icono-hero" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white/10 border-2 border-white/20 flex items-center justify-center text-4xl sm:text-5xl shadow-inner shrink-0">
                    🌒
                </div>
                <div>
                    <h3 id="lunar-modal-titulo-fase" class="text-2xl sm:text-3xl font-black text-white leading-tight">Cargando Fase Lunar...</h3>
                    <p id="lunar-modal-desc-visual" class="text-xs text-purple-200 mt-0.5">Calculando posición astronómica local en Colombia (UTC-5)...</p>
                    <div class="flex items-center gap-2 mt-2 flex-wrap text-[11px]">
                        <span class="px-2 py-0.5 rounded-md bg-white/10 border border-white/20 text-amber-300 font-bold" id="lunar-modal-iluminacion">
                            Iluminación: --%
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-white/10 border border-white/20 text-purple-200 font-bold" id="lunar-modal-edad">
                            Edad: -- días
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-emerald-400/20 text-emerald-300 border border-emerald-400/30 font-bold" id="lunar-modal-cambio">
                            Cambia en: -- días
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtro por Cultivo en el Modal (Solo visible si hay cultivos específicos cargados) -->
        <div id="fila-filtro-cultivo-lunar" class="bg-purple-50/60 p-3 sm:px-6 border-b border-purple-100 flex items-center justify-between gap-3 shrink-0 flex-wrap hidden">
            <span class="text-xs font-bold text-purple-950 flex items-center gap-1.5">
                <span>🌾</span> Filtrar por cultivo:
            </span>
            <select id="select-cultivo-lunar" onchange="cambiarCultivoLunar(this.value)" class="px-3 py-1.5 rounded-xl bg-white border border-purple-200 text-xs text-purple-950 focus:outline-none focus:ring-2 focus:ring-purple-500 shadow-sm font-medium">
                <option value="">🌱 Todos los cultivos</option>
            </select>
        </div>

        <!-- Pestañas del Modal Lunar -->
        <div class="flex items-center border-b border-gray-100 bg-gray-50/70 px-6 shrink-0 gap-4 text-xs font-bold">
            <button id="tab-btn-recomendadas" onclick="cambiarPestanaLunar('recomendadas')" class="py-3 border-b-2 border-purple-700 text-purple-900 flex items-center gap-1.5 cursor-pointer">
                <span>🌿</span> Prácticas y Labores (<span id="count-recomendadas">0</span>)
            </button>
            <button id="tab-btn-calendario" onclick="cambiarPestanaLunar('calendario')" class="py-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-1.5 cursor-pointer">
                <span>📅</span> Calendario del Mes
            </button>
        </div>

        <!-- Contenido Desplazable del Modal Lunar -->
        <div class="p-6 overflow-y-auto space-y-4 flex-1 bg-white">
            
            <!-- Vista 1: Prácticas y Recomendaciones -->
            <div id="vista-lunar-recomendadas" class="space-y-3">
                <p class="text-xs text-gray-400 italic">Cargando recomendaciones agroecológicas para esta fase...</p>
            </div>

            <!-- Vista 2: Calendario Lunar del Mes -->
            <div id="vista-lunar-calendario" class="hidden space-y-3">
                <p class="text-xs text-gray-400 italic">Cargando calendario lunar mensual...</p>
            </div>
        </div>

        <!-- Footer del Modal Lunar -->
        <div class="bg-gray-50 px-6 py-3.5 border-t border-gray-100 flex items-center justify-between text-xs text-gray-600 shrink-0">
            <a href="/mapa/lunar" class="text-purple-800 hover:text-purple-900 font-bold flex items-center gap-1">
                <span>📖</span> Ver Calendario Completo
            </a>
            <button onclick="cerrarPanelLunar()" class="px-4 py-1.5 rounded-xl bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold transition-all cursor-pointer">
                Cerrar
            </button>
        </div>
    </div>
</div>

<!-- ── Modal Emergente de Ficha Completa de Familia ── -->
<div id="modal-familia" class="fixed inset-0 z-[99999] hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl border border-gray-200 transform transition-all">
        
        <!-- Header del Modal -->
        <div class="relative bg-gradient-to-r from-verde via-verde to-gray-900 text-white p-6">
            <button id="btn-cerrar-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-lg transition-colors">
                ✕
            </button>
            <div class="flex items-center gap-4">
                <div id="modal-foto-container" class="w-16 h-16 rounded-2xl bg-white/10 border-2 border-white/20 flex items-center justify-center text-3xl overflow-hidden shrink-0">
                    👩‍🌾
                </div>
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-400/20 text-emerald-300 border border-emerald-400/30 mb-1">
                        Familia Productora ASCAMPESINA
                    </span>
                    <h3 id="modal-nombre-familia" class="text-xl font-extrabold text-white leading-snug">Cargando...</h3>
                    <p id="modal-vereda" class="text-xs text-emerald-200 flex items-center gap-1 mt-0.5">
                        📍 Caldono, Cauca
                    </p>
                </div>
            </div>
        </div>

        <!-- Cuerpo del Modal -->
        <div class="p-6 space-y-5 max-h-[60vh] overflow-y-auto">
            
            <!-- Persona de contacto y WhatsApp -->
            <div class="bg-gray-50 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 border border-gray-100">
                <div>
                    <span class="text-xs text-gray-400 block font-medium">Persona de Contacto</span>
                    <span id="modal-contacto-nombre" class="font-bold text-gray-800 text-sm">--</span>
                </div>
                <a id="modal-whatsapp-link" href="#" target="_blank" class="btn-primary text-xs px-4 py-2 shadow-sm hover:shadow-md">
                    <span>📱</span> Contactar por WhatsApp
                </a>
            </div>

            <!-- Descripción de la Familia -->
            <div id="modal-desc-container" class="p-4 bg-emerald-50/60 rounded-2xl border border-emerald-100 text-xs text-gray-700 leading-relaxed">
                <span class="font-extrabold text-verde block text-[11px] uppercase tracking-wider mb-1">🌿 Sobre la Familia:</span>
                <p id="modal-descripcion-texto" class="italic text-gray-600">--</p>
            </div>

            <!-- Stock de Productos Agroecológicos -->
            <div>
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span>📦</span> Productos Disponibles en Caldono
                </h4>
                <div id="modal-stock-list" class="space-y-2">
                    <p class="text-xs text-gray-400 italic">Cargando catálogo de productos...</p>
                </div>
            </div>
        </div>

        <!-- Footer del Modal -->
        <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
            <span>InnovaFemIA · Proyecto Orquídeas ICESI</span>
            <button id="btn-cerrar-modal-footer" class="text-gray-600 hover:text-gray-900 font-semibold">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet.js JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // ── Coordenadas Reales de Caldono, Cauca (OpenStreetMap / DANE) ──
            const LAT_CALDONO = 2.8152;
            const LNG_CALDONO = -76.4958;
            const ZOOM_INICIAL = 11.5;

            // Capas de mapas
