@model IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerFamilias.FamiliaDto>
@{
    ViewData["Title"] = "Directorio de Familias";
    ViewData["Description"] = "Directorio de familias campesinas de ASCAMPESINA en Caldono, Cauca. Conoce quiénes producen café, aguacate, plátano y más.";
}

<!-- Módulo 1 — Pantalla 1: Directorio de Familias -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Header del módulo -->
    <div class="mb-8 animate-slide-up">
        <div class="flex items-center gap-3 mb-3">
            <span class="text-4xl">🗺️</span>
            <div>
                <h1 class="section-header">Directorio de Familias ASCAMPESINA</h1>
                <p class="section-subtitle">Conoce a las familias productoras de Caldono, Cauca y sus productos disponibles</p>
            </div>
        </div>

        <!-- Barra de búsqueda y filtros -->
        <form method="get" action="/mapa" class="flex flex-col sm:flex-row gap-3 mt-6" id="form-filtros-familias">
            <div class="flex-1 relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔍</span>
                <input type="text"
                       name="busqueda"
                       id="input-busqueda-familia"
                       value="@Context.Request.Query["busqueda"]"
                       placeholder="Buscar por nombre o producto..."
                       class="input-field pl-10" />
            </div>
            <select name="cultivoId" id="select-cultivo-filtro" class="input-field sm:w-52">
                <option value="">Todos los cultivos</option>
                <!-- Se puebla desde el backend en implementación completa -->
            </select>
            <button type="submit" class="btn-primary" id="btn-filtrar-familias">
                Filtrar
            </button>
        </form>
    </div>

    <!-- Accesos rápidos a sub-pantallas -->
    <div class="flex flex-wrap gap-3 mb-8">
        <a href="/mapa/mapa" class="btn-secondary" id="link-ver-mapa">
            📍 Ver en el Mapa
        </a>
        <a href="/mapa/precios" class="btn-secondary" id="link-ver-precios">
            📊 Precios de Mercado
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Estado vacío -->
        <div class="card text-center py-16 animate-fade-in">
            <div class="text-6xl mb-4">🌱</div>
            <h2 class="text-xl font-semibold text-gray-700 mb-2">No se encontraron familias</h2>
            <p class="text-gray-400 text-sm">
                @if (!string.IsNullOrEmpty(Context.Request.Query["busqueda"]))
                {
                    <span>No hay resultados para "<strong>@Context.Request.Query["busqueda"]</strong>".</span>
                }
                else
                {
                    <span>Aún no hay familias registradas en el directorio.</span>
                }
            </p>
        </div>
    }
    else
    {
        <!-- Grid de tarjetas de familias -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="grid-familias">
            @foreach (var familia in Model)
            {
                <article class="card group cursor-pointer animate-fade-in" id="card-familia-@familia.Id">
                    <!-- Foto de la familia -->
                    <div class="flex items-center gap-3 mb-4">
                        @if (!string.IsNullOrEmpty(familia.FotoBase64))
                        {
                            <img src="@familia.FotoBase64"
                                 alt="Foto de @familia.Nombre"
                                 class="w-14 h-14 rounded-full object-cover ring-2 ring-primary-200" />
                        }
                        else
                        {
                            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center text-2xl ring-2 ring-primary-200">
                                👨‍👩‍👧
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <h2 class="font-semibold text-gray-900 text-sm truncate">@familia.Nombre</h2>
                            <p class="text-xs text-gray-500 truncate">📍 @familia.Vereda, @familia.Municipio</p>
                        </div>
                    </div>

                    <!-- Cultivos disponibles -->
                    <div class="flex flex-wrap gap-1.5 mb-4" aria-label="Cultivos de @familia.Nombre">
                        @foreach (var cultivo in familia.Cultivos)
                        {
                            @if (cultivo.Disponible)
                            {
                                <span class="cultivo-disponible" title="@cultivo.NombreCultivo disponible">
                                    @cultivo.Icono @cultivo.NombreCultivo
                                </span>
                            }
                            else
                            {
                                <span class="cultivo-no-disponible" title="@cultivo.NombreCultivo no disponible">
                                    @cultivo.Icono @cultivo.NombreCultivo
                                </span>
                            }
                        }
                    </div>

                    <!-- Contacto y acción -->
                    <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                        <a href="https://wa.me/57@familia.TelefonoContacto.Replace(" ", "").Replace("-", "")"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-xs text-primary-600 hover:text-primary-800 font-medium flex items-center gap-1"
                           id="link-whatsapp-@familia.Id"
                           aria-label="Contactar a @familia.NombreContacto por WhatsApp">
                            📱 @familia.NombreContacto
                        </a>
                        <button class="text-xs text-gray-400 hover:text-gray-700 transition-colors font-medium"
                                id="btn-ver-mas-@familia.Id"
                                aria-label="Ver ficha completa de @familia.Nombre"
                                onclick="verFichaFamilia(@familia.Id)">
                            Ver más →
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        // Función para mostrar la ficha completa de una familia (modal)
        function verFichaFamilia(familiaId) {
            // TODO: Implementar modal con detalle completo en Fase 2
            console.log('Ver ficha de familia:', familiaId);
        }
    </script>
}
