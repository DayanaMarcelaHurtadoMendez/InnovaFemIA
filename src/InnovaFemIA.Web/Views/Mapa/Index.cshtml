@model IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerFamilias.FamiliaDto>
@{
    ViewData["Title"] = "Directorio de Familias";
    ViewData["Description"] = "Directorio de familias campesinas de ASCAMPESINA en Caldono, Cauca. Conoce quiénes producen café, aguacate, plátano y más.";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerCultivos.CultivoDto> ?? [];
    int? cultivoSeleccionado = ViewBag.CultivoIdSeleccionado;
}

<!-- Módulo 1 — Pantalla 1: Directorio de Familias -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Header del módulo -->
    <div class="mb-8 animate-slide-up">
        <div class="flex items-center gap-3 mb-3">
            <span class="text-4xl">👨‍👩‍👧</span>
            <div>
                <h1 class="section-header">Directorio de Familias ASCAMPESINA</h1>
                <p class="section-subtitle">Conoce a las familias productoras de Caldono, Cauca y sus cultivos agroecológicos</p>
            </div>
        </div>

        <!-- Barra de búsqueda y filtros -->
        <form method="get" action="/mapa" class="flex flex-col sm:flex-row gap-3 mt-6" id="form-filtros-familias">
            <div class="flex-1 relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔍</span>
                <input type="text"
                       name="busqueda"
                       id="input-busqueda-familia"
                       value="@ViewBag.Busqueda"
                       placeholder="Buscar por nombre, vereda o cultivo..."
                       class="input-field pl-10" />
            </div>
            <select name="cultivoId" id="select-cultivo-filtro" class="input-field sm:w-60">
                <option value="">🌱 Todos los cultivos</option>
                @foreach (var c in cultivos)
                {
                    <option value="@c.Id" selected="@(cultivoSeleccionado == c.Id)">
                        @c.Icono @c.Nombre
                    </option>
                }
            </select>
            <button type="submit" class="btn-cian" id="btn-filtrar-familias">
                Filtrar
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Busqueda?.ToString()) || cultivoSeleccionado.HasValue)
            {
                <a href="/mapa" class="btn-secondary text-center" id="btn-limpiar-filtros">
                    Limpiar
                </a>
            }
        </form>
    </div>

    <!-- Accesos rápidos a sub-pantallas -->
    <div class="flex flex-wrap gap-3 mb-8">
        <a href="/mapa/mapa" class="btn-cian" id="link-ver-mapa">
            📍 Ver Mapa Interactivo de Caldono
        </a>
        <a href="/mapa/precios" class="btn-secondary" id="link-ver-precios">
            📊 Precios de Mercado DANE
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Estado vacío -->
        <div class="card text-center py-16 animate-fade-in">
            <div class="text-6xl mb-4">🌱</div>
            <h2 class="text-xl font-semibold text-gray-700 mb-2">No se encontraron familias</h2>
            <p class="text-gray-400 text-sm">
                @if (!string.IsNullOrEmpty(ViewBag.Busqueda?.ToString()))
                {
                    <span>No hay resultados para "<strong>@ViewBag.Busqueda</strong>".</span>
                }
                else
                {
                    <span>Aún no hay familias registradas en el directorio con este filtro.</span>
                }
            </p>
        </div>
    }
    else
    {
        <!-- Grid de tarjetas de familias -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="grid-familias">
            @foreach (var familia in Model)
            {
                <article class="card group cursor-pointer animate-fade-in flex flex-col justify-between hover:shadow-lg hover:border-emerald-200 transition-all" id="card-familia-@familia.Id" onclick="verFichaFamilia(@familia.Id)">
                    <div>
                        <!-- Foto de la familia -->
                        <div class="flex items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(familia.FotoBase64))
                            {
                                <button onclick="event.stopPropagation(); window.abrirVistaPreviaImagen('@familia.FotoBase64')" title="Ampliar foto" class="shrink-0 cursor-zoom-in">
                                    <img src="@familia.FotoBase64"
                                         alt="Foto de @familia.Nombre"
                                         class="w-14 h-14 rounded-2xl object-cover ring-2 ring-emerald-200 shadow-sm hover:scale-105 transition-transform" />
                                </button>
                            }
                            else
                            {
                                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-100 to-emerald-200 flex items-center justify-center text-2xl ring-2 ring-emerald-200 shrink-0">
                                    👩‍🌾
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <h2 class="font-bold text-gray-900 text-sm truncate group-hover:text-verde transition-colors">@familia.Nombre</h2>
                                <p class="text-xs text-verde font-medium truncate">📍 Vereda @familia.Vereda, Caldono</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(familia.Descripcion))
                        {
                            <p class="text-[11px] text-gray-500 line-clamp-2 mb-3 italic">"@familia.Descripcion"</p>
                        }

                        <!-- Cultivos disponibles -->
                        <div class="flex flex-wrap gap-1.5 mb-4" aria-label="Cultivos de @familia.Nombre">
                            @foreach (var cultivo in familia.Cultivos)
                            {
                                @if (cultivo.Disponible)
                                {
                                    <span class="cultivo-disponible" title="@cultivo.NombreCultivo disponible">
                                        @cultivo.Icono @cultivo.NombreCultivo
                                    </span>
                                }
                                else
                                {
                                    <span class="cultivo-no-disponible" title="@cultivo.NombreCultivo no disponible">
                                        @cultivo.Icono @cultivo.NombreCultivo
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    <!-- Contacto y acción -->
                    <div class="flex items-center justify-between pt-3 border-t border-gray-100 mt-2">
                        @{
                            var telLimpio = System.Text.RegularExpressions.Regex.Replace(familia.TelefonoContacto ?? "", @"\D", "");
                        }
                        <a href="https://wa.me/57@(telLimpio)"
                           target="_blank"
                           rel="noopener noreferrer"
                           onclick="event.stopPropagation()"
                           class="text-xs text-verde hover:text-verde font-bold flex items-center gap-1"
                           id="link-whatsapp-@familia.Id">
                            📱 WhatsApp
                        </a>
                        <button class="text-xs text-gray-500 hover:text-verde transition-colors font-bold"
                                id="btn-ver-mas-@familia.Id"
                                onclick="event.stopPropagation(); verFichaFamilia(@familia.Id)">
                            Ver Ficha →
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- ── Modal Emergente de Ficha Completa de Familia ───────────────────── -->
<div id="modal-familia-dir" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl border border-gray-100 transform transition-all">
        
        <!-- Header del Modal -->
        <div class="relative bg-white border-b border-gray-100 p-6">
            <button id="btn-cerrar-modal-dir" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 text-lg transition-colors">
                ✕
            </button>
            <div class="flex items-center gap-4">
                <div id="modal-dir-foto-container" class="w-16 h-16 rounded-2xl bg-gray-50 border border-gray-200 flex items-center justify-center text-3xl overflow-hidden shrink-0 shadow-sm cursor-zoom-in">
                    👩‍🌾
                </div>
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-cian-light text-cian border border-cian/20 mb-1 uppercase tracking-wider">
                        Familia Productora
                    </span>
                    <h3 id="modal-dir-nombre" class="text-xl font-black text-gray-900 leading-snug">Cargando...</h3>
                    <p id="modal-dir-vereda" class="text-sm text-gray-500 flex items-center gap-1 mt-0.5 font-medium">
                        📍 Caldono, Cauca
                    </p>
                </div>
            </div>
        </div>

        <!-- Cuerpo del Modal -->
        <div class="p-6 space-y-5 max-h-[60vh] overflow-y-auto">
            
            <!-- Persona de contacto y WhatsApp -->
            <div class="bg-gray-50 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 border border-gray-100">
                <div>
                    <span class="text-xs text-gray-400 block font-medium">Persona de Contacto</span>
                    <span id="modal-dir-contacto" class="font-bold text-gray-800 text-sm">--</span>
                </div>
                <a id="modal-dir-whatsapp" href="#" target="_blank" class="btn-primary text-xs px-4 py-2 shadow-sm hover:shadow-md">
                    <span>📱</span> Contactar por WhatsApp
                </a>
            </div>

            <!-- Descripción de la Familia -->
            <div id="modal-dir-desc-container" class="p-4 bg-emerald-50/60 rounded-2xl border border-emerald-100 text-xs text-gray-700 leading-relaxed">
                <span class="font-extrabold text-verde block text-[11px] uppercase tracking-wider mb-1">🌿 Sobre la Familia:</span>
                <p id="modal-dir-descripcion" class="italic text-gray-600">--</p>
            </div>

            <!-- Stock de Productos Agroecológicos -->
            <div>
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span>📦</span> Productos Disponibles en Caldono
                </h4>
                <div id="modal-dir-stock" class="space-y-2">
                    <p class="text-xs text-gray-400 italic">Cargando catálogo...</p>
                </div>
            </div>
        </div>

        <!-- Footer del Modal -->
        <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
            <span>InnovaFemIA · Proyecto Orquídeas ICESI</span>
            <button id="btn-cerrar-modal-dir-footer" class="text-gray-600 hover:text-gray-900 font-semibold">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function verFichaFamilia(familiaId) {
            const modal = document.getElementById('modal-familia-dir');
            modal.classList.remove('hidden');

            document.getElementById('modal-dir-nombre').innerText = 'Cargando...';
            document.getElementById('modal-dir-stock').innerHTML = '<p class="text-xs text-gray-400 italic">Cargando productos...</p>';

            try {
                const res = await fetch(`/api/mapa/familias/${familiaId}`);
                if (!res.ok) throw new Error('Error al cargar la familia');
                const f = await res.json();

                document.getElementById('modal-dir-nombre').innerText = f.nombre;
                document.getElementById('modal-dir-vereda').innerText = `📍 Vereda ${f.vereda}, ${f.municipio}, Cauca`;
                document.getElementById('modal-dir-contacto').innerText = f.nombreContacto;
                document.getElementById('modal-dir-whatsapp').href = `https://wa.me/57${f.telefonoContacto.replace(/\D/g, '')}`;

                if (f.fotoBase64) {
                    document.getElementById('modal-dir-foto-container').innerHTML = `<button onclick="window.abrirVistaPreviaImagen('${f.fotoBase64}')" title="Ampliar foto" class="block w-full h-full cursor-zoom-in hover:opacity-90 transition-opacity"><img src="${f.fotoBase64}" class="w-full h-full object-cover"/></button>`;
                } else {
                    document.getElementById('modal-dir-foto-container').innerHTML = '👩‍🌾';
                }

                if (f.descripcion) {
                    document.getElementById('modal-dir-descripcion').innerText = f.descripcion;
                    document.getElementById('modal-dir-desc-container').classList.remove('hidden');
                } else {
                    document.getElementById('modal-dir-desc-container').classList.add('hidden');
                }

                if (f.stockProductos && f.stockProductos.length > 0) {
                    const stockHtml = f.stockProductos.map(s => `
                        <div class="flex items-center justify-between p-3 rounded-xl border border-gray-100 bg-white hover:bg-gray-50 transition-colors">
                            <div class="flex items-center gap-2.5">
                                <span class="text-xl">${s.icono}</span>
                                <div>
                                    <span class="font-semibold text-xs text-gray-900 block">${s.nombreCultivo}</span>
                                    <span class="text-[10px] text-gray-400">${s.notas || 'Producto de finca agroecológica'}</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="font-bold text-[11px] ${s.disponible ? 'text-verde bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200' : 'text-gray-400'} inline-block">
                                    ${s.disponible ? '✓ Cosecha Disponible' : '✕ Agotado'}
                                </span>
                            </div>
                        </div>
                    `).join('');
                    document.getElementById('modal-dir-stock').innerHTML = stockHtml;
                } else {
                    document.getElementById('modal-dir-stock').innerHTML = '<p class="text-xs text-gray-400 italic">No hay productos registrados en stock actualmente.</p>';
                }
            } catch (e) {
                console.error(e);
                document.getElementById('modal-dir-nombre').innerText = 'Error al cargar';
            }
        }

        const cerrarModalDir = () => document.getElementById('modal-familia-dir').classList.add('hidden');
        document.getElementById('btn-cerrar-modal-dir')?.addEventListener('click', cerrarModalDir);
        document.getElementById('btn-cerrar-modal-dir-footer')?.addEventListener('click', cerrarModalDir);
        document.getElementById('modal-familia-dir')?.addEventListener('click', function(e) {
            if (e.target === this) cerrarModalDir();
        });

        // Vista previa de fotos estilo Lightbox profesional
        window.abrirVistaPreviaImagen = function(url) {
            if (!url) return;
            const div = document.createElement('div');
            div.className = 'fixed inset-0 z-[9999] bg-gray-900/95 backdrop-blur-sm flex items-center justify-center p-4 animate-fade-in cursor-zoom-out';
            div.onclick = () => div.remove();
            div.innerHTML = `
                <img src="${url}" class="max-w-full max-h-[90vh] rounded-xl shadow-2xl object-contain" onclick="event.stopPropagation()" />
                <button class="absolute top-6 right-6 text-white text-3xl font-bold bg-gray-800/60 hover:bg-gray-700 w-12 h-12 rounded-full flex items-center justify-center transition-colors" onclick="this.parentElement.remove()">✕</button>
            `;
            document.body.appendChild(div);
        };
    </script>
}
