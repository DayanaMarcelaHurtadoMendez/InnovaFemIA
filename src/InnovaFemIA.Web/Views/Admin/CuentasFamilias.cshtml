@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionCuentasFamilias.CuentaFamiliaAdminDto>
@{
    ViewData["Title"] = "Gestión de Cuentas Biocomercio — Panel de Admin";
    var familias = ViewBag.Familias as IEnumerable<InnovaFemIA.Web.Features.Admin.GestionFamilias.FamiliaAdminDto> ?? [];
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y botón de creación -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="/admin/dashboard" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🔑</span> Cuentas de Acceso (Biocomercio)
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">Credenciales de inicio de sesión de las Familias Campesinas (Módulo 3)</p>
        </div>
        <button onclick="abrirModalCrearCuenta()" class="px-5 py-3 bg-verde hover:bg-verde text-white text-xs font-bold rounded-2xl shadow-md transition-all shrink-0">
            + Crear Cuenta de Familia
        </button>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>✅</span> <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Tabla de Cuentas -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 font-bold uppercase text-[10px] tracking-wider">
                        <th class="p-4">Usuario</th>
                        <th class="p-4">Familia Asociada</th>
                        <th class="p-4">Vereda</th>
                        <th class="p-4">Fecha Creación</th>
                        <th class="p-4">Último Inicio de Sesión</th>
                        <th class="p-4 text-center">Estado</th>
                        <th class="p-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 font-bold text-gray-900">👤 @c.NombreUsuario</td>
                                <td class="p-4 font-semibold text-verde">👩‍🌾 @c.NombreFamilia</td>
                                <td class="p-4 text-gray-600">📍 @c.Vereda</td>
                                <td class="p-4 text-gray-500 text-[11px]">@c.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td class="p-4 text-gray-500 text-[11px]">
                                    @(c.UltimoLogin.HasValue ? c.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca")
                                </td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(c.Activo ? "bg-emerald-100 text-verde" : "bg-rose-100 text-rose-800")">
                                        @(c.Activo ? "Activa" : "Desactivada")
                                    </span>
                                </td>
                                <td class="p-4 text-right space-x-2">
                                    <button onclick='abrirModalEditarCuenta(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-lg transition-all">
                                        Editar / Clave
                                    </button>
                                    <button onclick="confirmarEliminarCuenta(@c.Id, '@c.NombreUsuario')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-lg transition-all">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-400 italic">
                                No hay cuentas de familias creadas en el módulo de Biocomercio.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Formulario Crear Cuenta -->
<div id="modal-crear-cuenta" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-verde text-white p-5 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-white">Crear Cuenta de Familia</h3>
            <button onclick="cerrarModalCrearCuenta()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form action="/admin/cuentas-familias/crear" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Familia Beneficiaria</label>
                <select name="FamiliaId" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-emerald-600">
                    <option value="">Selecciona la familia...</option>
                    @foreach (var f in familias)
                    {
                        <option value="@f.Id">@f.Nombre (Vereda @f.Vereda)</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nombre de Usuaria</label>
                <input type="text" name="NombreUsuario" required placeholder="Ej: familiacampo" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-emerald-600" />
                <span class="text-[10px] text-gray-400 block mt-1">Sin espacios, entre 3 y 50 caracteres.</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Contraseña Inicial</label>
                <input type="password" name="Contrasena" required placeholder="••••••••" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-emerald-600" />
                <span class="text-[10px] text-gray-400 block mt-1">Mínimo 6 caracteres (encriptada con BCrypt).</span>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalCrearCuenta()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-verde text-white font-bold text-xs rounded-xl shadow-md">Crear Cuenta</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Formulario Editar Cuenta / Cambiar Clave -->
<div id="modal-editar-cuenta" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-gray-900 text-white p-5 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-white">Editar Cuenta de Usuaria</h3>
            <button onclick="cerrarModalEditarCuenta()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form action="/admin/cuentas-familias/editar" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit-cuenta-id" name="Id" value="" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Usuario</label>
                <input type="text" id="edit-cuenta-usuario" disabled class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-gray-100 font-bold text-gray-600" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nueva Contraseña (Opcional)</label>
                <input type="password" name="NuevaContrasena" placeholder="Dejar en blanco para mantener la actual" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-gray-800" />
            </div>

            <div>
                <label class="flex items-center gap-2">
                    <input type="checkbox" id="edit-cuenta-activo" name="Activo" value="true" class="w-4 h-4 text-emerald-600 rounded" />
                    <span class="text-xs font-bold text-gray-700">Cuenta Activa</span>
                </label>
                <span class="text-[10px] text-gray-400 block mt-1">Si desactivas la cuenta, la familia no podrá iniciar sesión en Biocomercio.</span>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalEditarCuenta()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-gray-900 text-white font-bold text-xs rounded-xl shadow-md">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmación Eliminar -->
<div id="modal-eliminar-cuenta" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-bold">
            🗑️
        </div>
        <h3 class="font-black text-lg text-gray-900">¿Confirmar Eliminación?</h3>
        <p class="text-xs text-gray-500">
            ¿Estás seguro de eliminar la cuenta <strong id="cuenta-nombre-eliminar" class="text-gray-800"></strong>?
        </p>
        <form action="/admin/cuentas-familias/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cuenta-id-eliminar" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarCuenta()" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow-md hover:bg-rose-700">Sí, Eliminar</button>
        </form>
    </div>
</div>

<script>
    function abrirModalCrearCuenta() {
        document.getElementById('modal-crear-cuenta').classList.remove('hidden');
    }
    function cerrarModalCrearCuenta() {
        document.getElementById('modal-crear-cuenta').classList.add('hidden');
    }

    function abrirModalEditarCuenta(c) {
        document.getElementById('edit-cuenta-id').value = c.Id;
        document.getElementById('edit-cuenta-usuario').value = c.NombreUsuario;
        document.getElementById('edit-cuenta-activo').checked = c.Activo;
        document.getElementById('modal-editar-cuenta').classList.remove('hidden');
    }
    function cerrarModalEditarCuenta() {
        document.getElementById('modal-editar-cuenta').classList.add('hidden');
    }

    function confirmarEliminarCuenta(id, usuario) {
        document.getElementById('cuenta-id-eliminar').value = id;
        document.getElementById('cuenta-nombre-eliminar').innerText = usuario;
        document.getElementById('modal-eliminar-cuenta').classList.remove('hidden');
    }
    function cerrarModalEliminarCuenta() {
        document.getElementById('modal-eliminar-cuenta').classList.add('hidden');
    }
</script>
