@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionLeccionesChatbot.LeccionChatbotAdminDto>
@{
    ViewData["Title"] = "Gestión de Modo Lección — Admin";
    var leccionesList = Model?.ToList() ?? new List<InnovaFemIA.Web.Features.Admin.GestionLeccionesChatbot.LeccionChatbotAdminDto>();
    var totalLecciones = leccionesList.Count;
    var totalPreguntas = leccionesList.Sum(l => l.TotalPreguntas);
    var siguienteNumero = leccionesList.Any() ? leccionesList.Max(l => l.NumeroLeccion) + 1 : 1;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y Estadísticas -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1">
            <a href="~/admin/dashboard" class="text-xs text-amber-800 font-bold hover:underline flex items-center gap-1 mb-1">
                <span>←</span> Volver al Dashboard
            </a>
            <h1 class="text-2xl sm:text-3xl font-black text-gray-900 flex items-center gap-3">
                <span class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl shrink-0">🎓</span>
                Escuela Agroecológica de Saberes
            </h1>
            <p class="text-xs sm:text-sm text-gray-500 max-w-2xl">
                Administra las lecciones formativas y sus preguntas interactivas de selección múltiple con retroalimentación en tiempo real.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
            <div class="flex items-center gap-3 bg-gray-50 px-4 py-2.5 rounded-2xl border border-gray-200/80">
                <div class="text-center">
                    <span class="text-sm font-black text-gray-900 block leading-none">@totalLecciones</span>
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Lecciones</span>
                </div>
                <div class="h-6 w-[1px] bg-gray-200"></div>
                <div class="text-center">
                    <span class="text-sm font-black text-amber-700 block leading-none">@totalPreguntas</span>
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Preguntas</span>
                </div>
            </div>

            <button onclick="abrirModalCrearLeccion(@siguienteNumero)" class="px-5 py-3 bg-amber-600 hover:bg-amber-700 text-white text-xs font-black rounded-2xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                <span>+</span>
                <span>Crear Nueva Lección</span>
            </button>
        </div>
    </div>

    <!-- Alertas del Sistema -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-5 py-3.5 rounded-2xl text-xs font-bold flex items-center gap-2 shadow-sm animate-fade-in">
            <span class="text-base">✅</span>
            <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-3.5 rounded-2xl text-xs font-bold flex items-center gap-2 shadow-sm animate-fade-in">
            <span class="text-base">⚠️</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Listado Modular de Lecciones -->
    <div class="space-y-5">
        @if (leccionesList.Any())
        {
            @foreach (var lec in leccionesList)
            {
                <div id="leccion-card-@lec.Id" class="bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-all overflow-hidden">
                    
                    <!-- Cabecera de la Lección -->
                    <div class="p-6 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 bg-gradient-to-r from-white via-white to-amber-50/20">
                        <div class="flex items-start gap-4 flex-1 min-w-0">
                            <span class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-900 border border-amber-200/60 flex items-center justify-center font-black text-base shrink-0 shadow-inner">
                                #@lec.NumeroLeccion
                            </span>

                            <div class="space-y-1 min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-200">
                                        Lección Secuencial
                                    </span>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold @(lec.TotalPreguntas > 0 ? "bg-emerald-100 text-verde border border-emerald-200" : "bg-gray-100 text-gray-500 border border-gray-200")">
                                        @(lec.TotalPreguntas == 1 ? "1 pregunta configurada" : $"{lec.TotalPreguntas} preguntas configuradas")
                                    </span>
                                </div>
                                <h2 class="text-base sm:text-lg font-black text-gray-900 truncate">@lec.Titulo</h2>
                                @if (!string.IsNullOrWhiteSpace(lec.Descripcion))
                                {
                                    <p class="text-xs text-gray-500 line-clamp-2">@lec.Descripcion</p>
                                }
                            </div>
                        </div>

                        <!-- Acciones de la Lección -->
                        <div class="flex items-center gap-2 self-end lg:self-center shrink-0">
                            <button onclick="abrirModalAgregarPregunta(@lec.Id, '@lec.Titulo.Replace("'", "\\'")'.replace(/&quot;/g, '&quot;'), @(lec.TotalPreguntas + 1))" 
                                    class="h-9 px-3.5 bg-emerald-50 hover:bg-emerald-100 text-verde border border-emerald-200/80 rounded-xl text-xs font-black transition-all inline-flex items-center gap-1.5 shadow-sm"
                                    title="Agregar Pregunta a esta lección">
                                <span>➕</span>
                                <span class="hidden sm:inline">Agregar Pregunta</span>
                            </button>

                            <button onclick="abrirModalEditarLeccion(@lec.Id, @lec.NumeroLeccion, '@lec.Titulo.Replace("'", "\\'").Replace("\"", "&quot;")', '@(lec.Descripcion?.Replace("'", "\\'").Replace("\"", "&quot;").Replace("\r\n", "\\n").Replace("\n", "\\n") ?? "")')" 
                                    class="h-9 px-3 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200/80 rounded-xl text-xs font-bold transition-all inline-flex items-center gap-1 shadow-sm"
                                    title="Editar Título y Descripción de la Lección">
                                <span>✏️</span>
                                <span class="hidden sm:inline">Editar</span>
                            </button>

                            <button onclick="togglePreguntas(@lec.Id)" id="btn-toggle-@lec.Id"
                                    class="h-9 px-3 bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-200/80 rounded-xl text-xs font-bold transition-all inline-flex items-center gap-1 shadow-sm">
                                <span id="toggle-icon-@lec.Id">▼</span>
                                <span class="hidden sm:inline">Ver preguntas</span>
                            </button>

                            <button onclick="confirmarEliminarLeccion(@lec.Id, '@lec.Titulo.Replace("'", "\\'")')" 
                                    class="h-9 w-9 inline-flex items-center justify-center bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-bold transition-all shadow-sm" 
                                    title="Eliminar Lección Completa">
                                <span>🗑️</span>
                            </button>
                        </div>
                    </div>

                    <!-- Acordeón Desplegable con las Preguntas -->
                    <div id="preguntas-container-@lec.Id" class="border-t border-gray-100 p-6 bg-gray-50/40 space-y-4">
                        @if (lec.Preguntas != null && lec.Preguntas.Any())
                        {
                            <div class="grid grid-cols-1 gap-4">
                                @foreach (var p in lec.Preguntas)
                                {
                                    <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm space-y-3">
                                        <!-- Header de la Pregunta -->
                                        <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-3">
                                            <div class="flex items-start gap-2.5 flex-1 min-w-0">
                                                <span class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-800 text-[11px] font-black shrink-0">
                                                    Pregunta #@p.Orden
                                                </span>
                                                <h4 class="font-extrabold text-sm text-gray-900 leading-snug">
                                                    @p.TextoPregunta
                                                </h4>
                                            </div>

                                            <div class="inline-flex items-center justify-end gap-1.5 shrink-0">
                                                <button type="button" 
                                                        onclick="cargarYEditarPregunta(@p.Id)"
                                                        id="btn-data-pregunta-@p.Id"
                                                        data-pregunta='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(p))'
                                                        class="inline-flex items-center justify-center gap-1 min-w-[72px] text-[11px] font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 px-2.5 py-1 rounded-lg border border-amber-200 transition-colors shadow-sm">
                                                    <span>✏️</span>
                                                    <span>Editar</span>
                                                </button>

                                                <button onclick="confirmarEliminarPregunta(@p.Id, '@p.TextoPregunta.Replace("'", "\\'")')" 
                                                        class="inline-flex items-center justify-center gap-1 min-w-[72px] text-[11px] font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 px-2.5 py-1 rounded-lg border border-rose-200 transition-colors shadow-sm">
                                                    <span>🗑️</span>
                                                    <span>Eliminar</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Contenido Explicativo si existe -->
                                        @if (!string.IsNullOrWhiteSpace(p.ContenidoExplicativo))
                                        {
                                            <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-200/60 text-xs text-amber-950 flex items-start gap-2">
                                                <span class="text-base shrink-0">📖</span>
                                                <div class="space-y-0.5">
                                                    <span class="font-black text-[10px] text-amber-800 uppercase tracking-wider block">Explicación Didáctica</span>
                                                    <p class="text-gray-700 leading-relaxed">@p.ContenidoExplicativo</p>
                                                </div>
                                            </div>
                                        }

                                        <!-- Opciones de Respuesta -->
                                        <div>
                                            <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block mb-1.5">
                                                Opciones de Respuesta (@p.Opciones.Count)
                                            </span>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                                                @foreach (var op in p.Opciones)
                                                {
                                                    <div class="p-3 rounded-2xl text-xs border transition-all @(op.EsCorrecta ? "bg-emerald-50/90 border-emerald-300 text-emerald-950 shadow-sm ring-1 ring-emerald-400/30" : "bg-white border-gray-200 text-gray-700")">
                                                        <div class="flex items-center justify-between gap-1 mb-1">
                                                            <span class="font-black text-xs flex items-center gap-1.5 @(op.EsCorrecta ? "text-verde" : "text-gray-900")">
                                                                <span>@(op.EsCorrecta ? "✅" : "⚪")</span>
                                                                <span>@op.TextoOpcion</span>
                                                            </span>
                                                            @if (op.EsCorrecta)
                                                            {
                                                                <span class="px-2 py-0.5 bg-emerald-200 text-emerald-900 rounded-md text-[9px] font-black uppercase">Correcta</span>
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(op.Retroalimentacion))
                                                        {
                                                            <div class="text-[11px] @(op.EsCorrecta ? "text-emerald-800" : "text-gray-500") italic pt-1 border-t @(op.EsCorrecta ? "border-emerald-200/80" : "border-gray-100")">
                                                                💬 @op.Retroalimentacion
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-8 bg-white rounded-2xl border border-dashed border-gray-300 text-center space-y-2">
                                <span class="text-3xl block">💡</span>
                                <h4 class="font-bold text-xs text-gray-700">Esta lección aún no tiene preguntas</h4>
                                <p class="text-[11px] text-gray-400 max-w-sm mx-auto">Agrega preguntas prácticas con múltiples opciones de respuesta para que las usuarias puedan resolver la lección.</p>
                                <button onclick="abrirModalAgregarPregunta(@lec.Id, '@lec.Titulo.Replace("'", "\\'")'.replace(/&quot;/g, '&quot;'), 1)" 
                                        class="inline-block mt-2 px-4 py-2 bg-emerald-600 hover:bg-verde text-white font-bold text-xs rounded-xl shadow-sm transition-all">
                                    + Crear Primera Pregunta
                                </button>
                            </div>
                        }
                    </div>

                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-3xl border border-gray-100 p-12 text-center space-y-3">
                <span class="text-5xl block">🌱</span>
                <h3 class="text-base font-black text-gray-900">No hay lecciones registradas en el sistema</h3>
                <p class="text-xs text-gray-500 max-w-md mx-auto">
                    Crea la primera lección formativa con sus preguntas de opción múltiple para activar la Escuela Agroecológica.
                </p>
                <button onclick="abrirModalCrearLeccion(1)" class="inline-block mt-2 px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-black text-xs rounded-2xl shadow-md transition-all">
                    + Crear Lección #1
                </button>
            </div>
        }
    </div>

</div>

<!-- Modal 1: Crear Nueva Lección -->
<div id="modal-crear-leccion" class="fixed inset-0 z-50 hidden bg-gray-950/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100 animate-scale-in">
        <div class="bg-amber-600 text-white p-5 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <span class="text-xl">🎓</span>
                <h3 class="font-black text-sm text-white">Nueva Lección Formativa</h3>
            </div>
            <button onclick="cerrarModalCrearLeccion()" class="text-white hover:text-gray-200 font-bold text-xl px-2">✕</button>
        </div>

        <form action="~/admin/chatbot/lecciones/crear" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Número Secuencial de Lección <span class="text-amber-600">*</span>
                </label>
                <input type="number" id="input-numero-leccion" name="NumeroLeccion" min="1" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
                <span class="text-[10px] text-gray-400 mt-1 block">Determina el orden de aparición en el catálogo.</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Título de la Lección <span class="text-amber-600">*</span>
                </label>
                <input type="text" name="Titulo" required placeholder="Ej: Fundamentos del Cultivo de Café" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Descripción Breve
                </label>
                <textarea name="Descripcion" rows="3" placeholder="Aprende sobre las etapas de siembra, cuidado agroecológico y recolección..." class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"></textarea>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2.5">
                <button type="button" onclick="cerrarModalCrearLeccion()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all">Cancelar</button>
                <button type="submit" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-black text-xs rounded-xl shadow-md transition-all">Crear Lección</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Editar Lección Existente -->
<div id="modal-editar-leccion" class="fixed inset-0 z-50 hidden bg-gray-950/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100 animate-scale-in">
        <div class="bg-amber-700 text-white p-5 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <span class="text-xl">✏️</span>
                <h3 class="font-black text-sm text-white">Editar Lección</h3>
            </div>
            <button onclick="cerrarModalEditarLeccion()" class="text-white hover:text-gray-200 font-bold text-xl px-2">✕</button>
        </div>

        <form action="~/admin/chatbot/lecciones/editar" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit-leccion-id" name="Id" value="" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Número Secuencial de Lección <span class="text-amber-600">*</span>
                </label>
                <input type="number" id="edit-leccion-numero" name="NumeroLeccion" min="1" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
                <span class="text-[10px] text-gray-400 mt-1 block">Determina el orden de aparición en el catálogo.</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Título de la Lección <span class="text-amber-600">*</span>
                </label>
                <input type="text" id="edit-leccion-titulo" name="Titulo" required placeholder="Ej: Fundamentos del Cultivo de Café" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Descripción Breve
                </label>
                <textarea id="edit-leccion-descripcion" name="Descripcion" rows="3" placeholder="Aprende sobre las etapas de siembra..." class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"></textarea>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2.5">
                <button type="button" onclick="cerrarModalEditarLeccion()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all">Cancelar</button>
                <button type="submit" class="px-5 py-2.5 bg-amber-700 hover:bg-amber-800 text-white font-black text-xs rounded-xl shadow-md transition-all">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 3: Agregar Pregunta con Opciones Dinámicas Ilimitadas -->
<div id="modal-agregar-pregunta" class="fixed inset-0 z-50 hidden bg-gray-950/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl border border-gray-100 my-8 flex flex-col max-h-[90vh] animate-scale-in">
        
        <div class="bg-amber-600 text-white p-5 flex items-center justify-between shrink-0">
            <div class="min-w-0">
                <div class="flex items-center gap-2.5">
                    <span class="text-xl">➕</span>
                    <h3 class="font-black text-sm text-white">Agregar Pregunta</h3>
                </div>
                <p id="label-leccion-destino" class="text-xs text-amber-100 font-bold truncate mt-0.5"></p>
            </div>
            <button onclick="cerrarModalAgregarPregunta()" class="text-white hover:text-amber-100 font-bold text-xl px-2">✕</button>
        </div>

        <form id="form-agregar-pregunta" action="~/admin/chatbot/lecciones/agregar-pregunta" method="POST" onsubmit="return validarFormularioPregunta(event)" class="p-6 space-y-5 overflow-y-auto flex-1">
            @Html.AntiForgeryToken()
            <input type="hidden" id="pregunta-leccion-id" name="leccionId" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                <div class="sm:col-span-3">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Enunciado de la Pregunta <span class="text-rose-600">*</span>
                    </label>
                    <input type="text" id="input-texto-pregunta" name="textoPregunta" required placeholder="Ej: ¿Cuál es la distancia recomendada para siembra de café?" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Orden # <span class="text-rose-600">*</span>
                    </label>
                    <input type="number" id="input-orden-pregunta" name="orden" value="1" min="1" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none text-center" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Contenido Explicativo Didáctico <span class="text-gray-400 font-normal">(Opcional, se muestra como ayuda pedagógica)</span>
                </label>
                <textarea name="contenidoExplicativo" rows="2" placeholder="El marco de plantación adecuado permite optimizar el paso de luz y nutrientes en la parcela..." class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"></textarea>
            </div>

            <!-- Sección Dinámica de Opciones de Respuesta -->
            <div class="space-y-3 pt-2 border-t border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <label class="block text-xs font-black text-gray-900 uppercase tracking-wider">
                            Opciones de Respuesta
                        </label>
                        <span class="text-[10px] text-gray-500">Agrega las opciones que desees y marca el botón redondo de la que sea correcta.</span>
                    </div>

                    <button type="button" onclick="agregarNuevaOpcionUI('', false, '')" class="px-3.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-verde border border-emerald-300 rounded-xl text-xs font-black transition-all flex items-center gap-1 shadow-sm">
                        <span>➕</span>
                        <span>Agregar Opción</span>
                    </button>
                </div>

                <div id="contenedor-opciones-dinamicas" class="space-y-3">
                    <!-- Se llena con JavaScript dinámicamente -->
                </div>
            </div>

            <!-- Banner de error JS -->
            <div id="banner-error-pregunta" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs font-bold"></div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2.5 shrink-0">
                <button type="button" onclick="cerrarModalAgregarPregunta()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all">Cancelar</button>
                <button type="submit" class="px-6 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-black text-xs rounded-xl shadow-md transition-all">Guardar Pregunta</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 4: Editar Pregunta con Opciones Dinámicas Ilimitadas -->
<div id="modal-editar-pregunta" class="fixed inset-0 z-50 hidden bg-gray-950/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl border border-gray-100 my-8 flex flex-col max-h-[90vh] animate-scale-in">
        
        <div class="bg-amber-700 text-white p-5 flex items-center justify-between shrink-0">
            <div class="min-w-0">
                <div class="flex items-center gap-2.5">
                    <span class="text-xl">✏️</span>
                    <h3 class="font-black text-sm text-white">Editar Pregunta</h3>
                </div>
                <p class="text-xs text-amber-100 font-medium truncate mt-0.5">Modifica el texto, explicación y opciones de respuesta</p>
            </div>
            <button onclick="cerrarModalEditarPregunta()" class="text-white hover:text-amber-100 font-bold text-xl px-2">✕</button>
        </div>

        <form id="form-editar-pregunta" action="~/admin/chatbot/lecciones/editar-pregunta" method="POST" onsubmit="return validarFormularioPreguntaEdit(event)" class="p-6 space-y-5 overflow-y-auto flex-1">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit-pregunta-id" name="id" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                <div class="sm:col-span-3">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Enunciado de la Pregunta <span class="text-rose-600">*</span>
                    </label>
                    <input type="text" id="edit-pregunta-texto" name="textoPregunta" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Orden # <span class="text-rose-600">*</span>
                    </label>
                    <input type="number" id="edit-pregunta-orden" name="orden" min="1" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs font-bold focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none text-center" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Contenido Explicativo Didáctico <span class="text-gray-400 font-normal">(Opcional, ayuda pedagógica)</span>
                </label>
                <textarea id="edit-pregunta-explicacion" name="contenidoExplicativo" rows="2" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"></textarea>
            </div>

            <!-- Sección Dinámica de Opciones de Respuesta en Edición -->
            <div class="space-y-3 pt-2 border-t border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <label class="block text-xs font-black text-gray-900 uppercase tracking-wider">
                            Opciones de Respuesta
                        </label>
                        <span class="text-[10px] text-gray-500">Modifica, agrega o elimina opciones. Marca la que sea correcta.</span>
                    </div>

                    <button type="button" onclick="agregarNuevaOpcionEditUI('', false, '')" class="px-3.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-verde border border-emerald-300 rounded-xl text-xs font-black transition-all flex items-center gap-1 shadow-sm">
                        <span>➕</span>
                        <span>Agregar Opción</span>
                    </button>
                </div>

                <div id="contenedor-opciones-dinamicas-edit" class="space-y-3">
                    <!-- Se llena con JavaScript dinámicamente -->
                </div>
            </div>

            <!-- Banner de error JS -->
            <div id="banner-error-pregunta-edit" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs font-bold"></div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2.5 shrink-0">
                <button type="button" onclick="cerrarModalEditarPregunta()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all">Cancelar</button>
                <button type="submit" class="px-6 py-2.5 bg-amber-700 hover:bg-amber-800 text-white font-black text-xs rounded-xl shadow-md transition-all">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 5: Confirmar Eliminación de Lección -->
<div id="modal-eliminar-leccion" class="fixed inset-0 z-50 hidden bg-gray-950/75 backdrop-blur-sm flex items-center justify-center p-4 animate-scale-in">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-14 h-14 rounded-3xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-black shadow-inner">
            🗑️
        </div>
        <div class="space-y-1">
            <h3 class="font-black text-lg text-gray-900">¿Eliminar Lección Completa?</h3>
            <p class="text-xs text-gray-500">
                Se eliminará permanentemente la lección <strong id="leccion-nombre-eliminar" class="text-gray-900 font-black"></strong> junto con todas sus preguntas y opciones de respuesta en cascada.
            </p>
        </div>
        <form action="~/admin/chatbot/lecciones/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
