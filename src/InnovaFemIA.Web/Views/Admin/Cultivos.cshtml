@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionCultivos.CultivoAdminDto>
@{
    ViewData["Title"] = "Catálogo de Cultivos — Admin";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y botón de creación -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="~/admin/dashboard" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🌱</span> Catálogo de Cultivos del Sistema
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">Cultivos disponibles en el Mapa Interactivo, Chatbot Educativo y Biocomercio</p>
        </div>
        <button onclick="abrirModalCrearCultivo()" class="px-5 py-3 bg-verde hover:bg-verde text-white text-xs font-bold rounded-2xl shadow-md transition-all shrink-0">
            + Registrar Nuevo Cultivo
        </button>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>✅</span> <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Grilla de Cultivos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @if (Model != null && Model.Any())
        {
            foreach (var c in Model)
            {
                <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-3 flex flex-col justify-between hover:shadow-md transition-all">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-3xl p-2 bg-emerald-50 rounded-2xl border border-emerald-100">@c.Icono</span>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(c.Activo ? "bg-emerald-100 text-verde" : "bg-rose-100 text-rose-800")">
                                @(c.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        <h3 class="font-extrabold text-base text-gray-900 mt-2">@c.Nombre</h3>
                        <p class="text-xs text-gray-500 line-clamp-2 mt-1">@(string.IsNullOrWhiteSpace(c.Descripcion) ? "Sin descripción agregada." : c.Descripcion)</p>
                    </div>

                    <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                        <button onclick='abrirModalEditarCultivo(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="text-gray-700 font-bold hover:text-verde">
                            Editar
                        </button>
                        <button onclick="confirmarEliminarCultivo(@c.Id, '@c.Nombre')" class="text-rose-600 font-bold hover:underline">
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full bg-white rounded-3xl border border-gray-100 p-8 text-center text-gray-400 italic">
                No hay cultivos registrados en el sistema.
            </div>
        }
    </div>
</div>

<!-- Modal Formulario Crear / Editar Cultivo con Selector de Emojis Global -->
<div id="modal-cultivo-form" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100 max-h-[90vh] flex flex-col">
        <div class="bg-verde text-white p-5 flex items-center justify-between shrink-0">
            <h3 id="modal-cultivo-title" class="font-extrabold text-sm text-white">Registrar Nuevo Cultivo</h3>
            <button onclick="cerrarModalCultivoForm()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form id="form-cultivo" action="~/admin/cultivos/crear" method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cultivo-id" name="Id" value="0" />

            <!-- Selector de Ícono / Emoji -->
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Ícono Representativo (Emoji)</label>
                <div class="flex items-center gap-3">
                    <span id="cultivo-icono-preview" class="text-4xl p-3 bg-emerald-50 rounded-2xl border border-emerald-200 shrink-0">🌱</span>
                    <input type="hidden" id="cultivo-icono" name="Icono" value="🌱" />
                    <button type="button" onclick="toggleEmojiPicker()" class="px-4 py-2 bg-emerald-100 hover:bg-emerald-200 text-verde font-bold text-xs rounded-xl border border-emerald-300 transition-all">
                        😀 Seleccionar Emoji...
                    </button>
                </div>

                <!-- Desplegable del Selector de Emojis Global -->
                <div id="emoji-picker-container" class="hidden mt-3 p-4 bg-gray-50 border border-gray-200 rounded-2xl space-y-3">
                    <div class="flex items-center gap-2">
                        <input type="text" id="emoji-search" oninput="filtrarEmojis()" placeholder="🔍 Buscar emoji (ej: café, aguacate, plátano)..." class="w-full px-3 py-1.5 text-xs rounded-xl border border-gray-200" />
                    </div>
                    <div id="emoji-grid" class="grid grid-cols-7 gap-2 max-h-40 overflow-y-auto p-1 text-2xl text-center">
                        <!-- Se puebla dinámicamente con emojis agrícolas y de naturaleza -->
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nombre del Cultivo</label>
                <input type="text" id="cultivo-nombre" name="Nombre" required placeholder="Ej: Café, Yuca, Aguacate, Plátano" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-emerald-600" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Descripción Breve</label>
                <textarea id="cultivo-descripcion" name="Descripcion" rows="3" placeholder="Descripción agronómica o tradicional del cultivo..." class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-emerald-600"></textarea>
            </div>

            <div id="div-activo-cultivo" class="hidden">
                <label class="flex items-center gap-2">
                    <input type="checkbox" id="cultivo-activo" name="Activo" value="true" checked class="w-4 h-4 text-emerald-600 rounded" />
                    <span class="text-xs font-bold text-gray-700">Cultivo Activo</span>
                </label>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3 shrink-0">
                <button type="button" onclick="cerrarModalCultivoForm()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-verde text-white font-bold text-xs rounded-xl shadow-md">Guardar Cultivo</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Eliminar Cultivo -->
<div id="modal-eliminar-cultivo" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-bold">
            🗑️
        </div>
        <h3 class="font-black text-lg text-gray-900">¿Confirmar Eliminación?</h3>
        <p class="text-xs text-gray-500">
            ¿Estás seguro de eliminar el cultivo <strong id="cultivo-nombre-eliminar" class="text-gray-800"></strong>?
        </p>
        <form action="~/admin/cultivos/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cultivo-id-eliminar" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarCultivo()" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow-md hover:bg-rose-700">Sí, Eliminar</button>
        </form>
    </div>
</div>

