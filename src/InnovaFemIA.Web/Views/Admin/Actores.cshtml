@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionActores.ActorAdminDto>
@using InnovaFemIA.Web.Features.Shared.Entities
@{
    ViewData["Title"] = "Gestión de Actores del Mapa — Panel de Admin";
    var tipoSeleccionado = ViewBag.TipoSeleccionado as TipoActorMapa?;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y botón de creación -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="/admin/dashboard" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🏛️</span> Gestión de Actores del Mapa
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">Asociaciones Campesinas (Ícono Naranja) y Puntos de Acopio / Compra (Ícono Azul)</p>
        </div>
        <button onclick="abrirModalCrearActor()" class="px-5 py-3 bg-gray-900 hover:bg-gray-800 text-white text-xs font-bold rounded-2xl shadow-md transition-all shrink-0">
            + Agregar Nuevo Actor
        </button>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>✅</span> <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Filtros de Tipo de Actor -->
    <div class="flex gap-2 text-xs">
        <a href="/admin/actores" class="px-4 py-2 rounded-xl font-bold border transition-all @(!tipoSeleccionado.HasValue ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            Todos los Actores
        </a>
        <a href="/admin/actores?tipo=Asociacion" class="px-4 py-2 rounded-xl font-bold border transition-all @(tipoSeleccionado == TipoActorMapa.Asociacion ? "bg-amber-600 text-white border-amber-600" : "bg-white text-amber-800 border-amber-200 hover:bg-amber-50")">
            🏛️ Solo Asociaciones
        </a>
        <a href="/admin/actores?tipo=PuntoCompra" class="px-4 py-2 rounded-xl font-bold border transition-all @(tipoSeleccionado == TipoActorMapa.PuntoCompra ? "bg-blue-600 text-white border-blue-600" : "bg-white text-blue-800 border-blue-200 hover:bg-blue-50")">
            🏬 Solo Puntos de Compra / Acopio
        </a>
    </div>

    <!-- Tabla de Actores -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 font-bold uppercase text-[10px] tracking-wider">
                        <th class="p-4">Tipo de Actor</th>
                        <th class="p-4">Nombre del Actor</th>
                        <th class="p-4">Descripción</th>
                        <th class="p-4">Contacto</th>
                        <th class="p-4">Coordenadas GPS</th>
                        <th class="p-4 text-center">Estado</th>
                        <th class="p-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var a in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4">
                                    @if (a.TipoActor == TipoActorMapa.Asociacion)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200 inline-flex items-center gap-1">
                                            🏛️ Asociación
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200 inline-flex items-center gap-1">
                                            🏬 Punto Acopio
                                        </span>
                                    }
                                </td>
                                <td class="p-4 font-bold text-gray-900">@a.Nombre</td>
                                <td class="p-4 text-gray-600 max-w-xs truncate">@a.Descripcion</td>
                                <td class="p-4 text-gray-600">📞 @a.DatosContacto</td>
                                <td class="p-4 font-mono text-[11px] text-blue-700">@a.Latitud, @a.Longitud</td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(a.Activo ? "bg-emerald-100 text-verde" : "bg-gray-100 text-gray-500")">
                                        @(a.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="p-4 text-right space-x-2">
                                    <button onclick='abrirModalEditarActor(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(a)))' class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-lg transition-all">
                                        Editar
                                    </button>
                                    <button onclick="confirmarEliminarActor(@a.Id, '@a.Nombre')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-lg transition-all">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-400 italic">
                                No se encontraron actores registrados en esta categoría.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Formulario Crear / Editar Actor -->
<div id="modal-actor-form" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-gray-900 text-white p-5 flex items-center justify-between">
            <h3 id="modal-actor-title" class="font-extrabold text-sm text-white">Agregar Nuevo Actor</h3>
            <button onclick="cerrarModalActorForm()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form id="form-actor" action="/admin/actores/crear" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="actor-id" name="Id" value="0" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Tipo de Actor</label>
                <select id="actor-tipo" name="TipoActor" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-gray-800">
                    <option value="Asociacion">🏛️ Asociación Campesina (Pin Naranja)</option>
                    <option value="PuntoCompra">🏬 Punto de Acopio / Compra (Pin Azul)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nombre del Actor</label>
                <input type="text" id="actor-nombre" name="Nombre" required placeholder="Ej: Asociación ASCAMPESINA - Sede Central" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-gray-800" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Descripción</label>
                <textarea id="actor-descripcion" name="Descripcion" rows="2" placeholder="Breve descripción del actor..." class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-gray-800"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Datos de Contacto</label>
                <input type="text" id="actor-contacto" name="DatosContacto" placeholder="Ej: Caldono Centro · Tel: 3123456789" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-gray-800" />
            </div>

            <div class="grid grid-cols-2 gap-3 p-3 bg-blue-50 rounded-2xl border border-blue-100">
                <div>
                    <label class="block text-xs font-bold text-blue-900 uppercase tracking-wider mb-1">Latitud (Colombia)</label>
                    <input type="number" step="any" id="actor-latitud" name="Latitud" required placeholder="Ej: 2.4422295" class="w-full px-3 py-2 rounded-xl border border-blue-200 text-xs focus:ring-2 focus:ring-blue-600" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-blue-900 uppercase tracking-wider mb-1">Longitud (Colombia)</label>
                    <input type="number" step="any" id="actor-longitud" name="Longitud" required placeholder="Ej: -76.6072368" class="w-full px-3 py-2 rounded-xl border border-blue-200 text-xs focus:ring-2 focus:ring-blue-600" />
                </div>
            </div>

            <div id="actor-div-activo" class="hidden">
                <label class="flex items-center gap-2">
                    <input type="checkbox" id="actor-activo" name="Activo" value="true" checked class="w-4 h-4 text-gray-900 rounded" />
                    <span class="text-xs font-bold text-gray-700">Estado Activo</span>
                </label>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalActorForm()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-gray-900 text-white font-bold text-xs rounded-xl shadow-md">Guardar Actor</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmación Eliminar (Regla 9.8) -->
<div id="modal-eliminar-actor" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-bold">
            🗑️
        </div>
        <h3 class="font-black text-lg text-gray-900">¿Confirmar Eliminación?</h3>
        <p class="text-xs text-gray-500">
            ¿Estás seguro de eliminar el actor <strong id="actor-nombre-eliminar" class="text-gray-800"></strong>?
        </p>
        <form action="/admin/actores/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="actor-id-eliminar" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarActor()" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow-md hover:bg-rose-700">Sí, Eliminar</button>
        </form>
    </div>
</div>

<script>
    function abrirModalCrearActor() {
        document.getElementById('modal-actor-title').innerText = 'Agregar Nuevo Actor';
        document.getElementById('form-actor').action = '/admin/actores/crear';
        document.getElementById('actor-id').value = 0;
        document.getElementById('actor-nombre').value = '';
        document.getElementById('actor-descripcion').value = '';
        document.getElementById('actor-contacto').value = '';
        document.getElementById('actor-latitud').value = '2.8145';
        document.getElementById('actor-longitud').value = '-76.5360';
        document.getElementById('actor-div-activo').classList.add('hidden');
        document.getElementById('modal-actor-form').classList.remove('hidden');
    }

    function abrirModalEditarActor(a) {
        document.getElementById('modal-actor-title').innerText = 'Editar Actor: ' + a.Nombre;
        document.getElementById('form-actor').action = '/admin/actores/editar';
        document.getElementById('actor-id').value = a.Id;
        document.getElementById('actor-tipo').value = a.TipoActor;
        document.getElementById('actor-nombre').value = a.Nombre;
        document.getElementById('actor-descripcion').value = a.Descripcion;
        document.getElementById('actor-contacto').value = a.DatosContacto;
        document.getElementById('actor-latitud').value = a.Latitud;
        document.getElementById('actor-longitud').value = a.Longitud;
        document.getElementById('actor-div-activo').classList.remove('hidden');
        document.getElementById('actor-activo').checked = a.Activo;
        document.getElementById('modal-actor-form').classList.remove('hidden');
    }

    function cerrarModalActorForm() {
        document.getElementById('modal-actor-form').classList.add('hidden');
    }

    function confirmarEliminarActor(id, nombre) {
        document.getElementById('actor-id-eliminar').value = id;
        document.getElementById('actor-nombre-eliminar').innerText = nombre;
        document.getElementById('modal-eliminar-actor').classList.remove('hidden');
    }

    function cerrarModalEliminarActor() {
        document.getElementById('modal-eliminar-actor').classList.add('hidden');
    }
</script>
