@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionReglasLunares.ReglaLunarAdminDto>
@using InnovaFemIA.Web.Features.Shared.Entities
@{
    ViewData["Title"] = "Gestión de Prácticas Lunares — Panel de Admin";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerCultivos.CultivoDto> ?? [];
    var faseSeleccionada = ViewBag.FaseSeleccionada as FaseLunar?;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y botón de creación -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="~/admin/dashboard" class="text-xs text-verde font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🌘</span> Gestión de Prácticas & Calendario Lunar
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">Recomendaciones agrícolas por fase lunar (Siembra, Cosecha, Poda, Abonado)</p>
        </div>
        <button onclick="abrirModalCrearRegla()" class="px-5 py-3 bg-purple-900 hover:bg-purple-950 text-white text-xs font-bold rounded-2xl shadow-md transition-all shrink-0">
            + Agregar Práctica Lunar
        </button>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>✅</span> <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Filtro por Fase Lunar -->
    <div class="flex flex-wrap gap-2 text-xs">
        <a href="~/admin/reglas-lunares" class="px-4 py-2 rounded-xl font-bold border transition-all @(!faseSeleccionada.HasValue ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            Todas las Fases
        </a>
        <a href="~/admin/reglas-lunares?fase=LunaNueva" class="px-4 py-2 rounded-xl font-bold border transition-all @(faseSeleccionada == FaseLunar.LunaNueva ? "bg-purple-900 text-white border-purple-900" : "bg-white text-purple-900 border-purple-200 hover:bg-purple-50")">
            🌑 Luna Nueva
        </a>
        <a href="~/admin/reglas-lunares?fase=CuartoCrediente" class="px-4 py-2 rounded-xl font-bold border transition-all @(faseSeleccionada == FaseLunar.CuartoCrediente ? "bg-purple-900 text-white border-purple-900" : "bg-white text-purple-900 border-purple-200 hover:bg-purple-50")">
            🌒 Cuarto Creciente
        </a>
        <a href="~/admin/reglas-lunares?fase=LunaLlena" class="px-4 py-2 rounded-xl font-bold border transition-all @(faseSeleccionada == FaseLunar.LunaLlena ? "bg-purple-900 text-white border-purple-900" : "bg-white text-purple-900 border-purple-200 hover:bg-purple-50")">
            🌕 Luna Llena
        </a>
        <a href="~/admin/reglas-lunares?fase=CuartoMenguante" class="px-4 py-2 rounded-xl font-bold border transition-all @(faseSeleccionada == FaseLunar.CuartoMenguante ? "bg-purple-900 text-white border-purple-900" : "bg-white text-purple-900 border-purple-200 hover:bg-purple-50")">
            🌘 Cuarto Menguante
        </a>
    </div>

    <!-- Tabla de Reglas Lunares -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 font-bold uppercase text-[10px] tracking-wider">
                        <th class="p-4">Fase Lunar</th>
                        <th class="p-4">Práctica</th>
                        <th class="p-4">Recomendación</th>
                        <th class="p-4">Cultivo Asociado</th>
                        <th class="p-4 text-center">Nivel Confianza</th>
                        <th class="p-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var r in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 font-bold text-purple-900">
                                    @switch(r.FaseLunar)
                                    {
                                        case FaseLunar.LunaNueva: <span>🌑 Luna Nueva</span> break;
                                        case FaseLunar.CuartoCrediente: <span>🌒 Cuarto Creciente</span> break;
                                        case FaseLunar.LunaLlena: <span>🌕 Luna Llena</span> break;
                                        case FaseLunar.CuartoMenguante: <span>🌘 Cuarto Menguante</span> break;
                                    }
                                </td>
                                <td class="p-4 font-bold text-gray-900">@r.Practica</td>
                                <td class="p-4 text-gray-600 max-w-sm">@r.Recomendacion</td>
                                <td class="p-4">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold @(r.CultivoId.HasValue ? "bg-emerald-50 text-verde border border-emerald-200" : "bg-gray-100 text-gray-600")">
                                        🌱 @r.NombreCultivo
                                    </span>
                                </td>
                                <td class="p-4 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800">
                                        @r.NivelConfianza
                                    </span>
                                </td>
                                <td class="p-4 text-right space-x-2">
                                    <button onclick='abrirModalEditarRegla(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r)))' class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-lg transition-all">
                                        Editar
                                    </button>
                                    <button onclick="confirmarEliminarRegla(@r.Id, '@r.Practica')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-lg transition-all">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-gray-400 italic">
                                No se encontraron prácticas lunares registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Formulario Crear / Editar Regla Lunar -->
<div id="modal-regla-form" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-purple-900 text-white p-5 flex items-center justify-between">
            <h3 id="modal-regla-title" class="font-extrabold text-sm text-white">Agregar Práctica Lunar</h3>
            <button onclick="cerrarModalReglaForm()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form id="form-regla" action="~/admin/reglas-lunares/crear" method="POST" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="regla-id" name="Id" value="0" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Fase Lunar</label>
                <select id="regla-fase" name="FaseLunar" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-purple-600">
                    <option value="LunaNueva">🌑 Luna Nueva</option>
                    <option value="CuartoCrediente">🌒 Cuarto Creciente</option>
                    <option value="LunaLlena">🌕 Luna Llena</option>
                    <option value="CuartoMenguante">🌘 Cuarto Menguante</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Práctica Agrícola</label>
                <input type="text" id="regla-practica" name="Practica" required placeholder="Ej: Siembra de hortalizas y café" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-purple-600" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Recomendación Explicativa</label>
                <textarea id="regla-recomendacion" name="Recomendacion" rows="3" required placeholder="Detalle técnico y tradicional de la recomendación..." class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-purple-600"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Cultivo Asociado (Opcional)</label>
                    <select id="regla-cultivo" name="CultivoId" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-purple-600">
                        <option value="">🌱 Aplica a Todos los Cultivos</option>
                        @foreach (var c in cultivos)
                        {
                            <option value="@c.Id">@c.Icono @c.Nombre</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nivel de Confianza</label>
                    <select id="regla-confianza" name="NivelConfianza" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-purple-600">
                        <option value="Alta">Alta</option>
                        <option value="Media">Media</option>
                        <option value="Tradicional">Tradicional ASCAMPESINA</option>
                    </select>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalReglaForm()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-purple-900 text-white font-bold text-xs rounded-xl shadow-md">Guardar Práctica</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmación Eliminar (Regla 9.8) -->
<div id="modal-eliminar-regla" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-bold">
            🗑️
        </div>
        <h3 class="font-black text-lg text-gray-900">¿Confirmar Eliminación?</h3>
        <p class="text-xs text-gray-500">
            ¿Estás seguro de eliminar la práctica <strong id="regla-nombre-eliminar" class="text-gray-800"></strong>?
        </p>
        <form action="~/admin/reglas-lunares/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="regla-id-eliminar" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarRegla()" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow-md hover:bg-rose-700">Sí, Eliminar</button>
        </form>
    </div>
</div>

<script>
    function abrirModalCrearRegla() {
        document.getElementById('modal-regla-title').innerText = 'Agregar Práctica Lunar';
        document.getElementById('form-regla').action = '@Url.Content("~/admin/reglas-lunares/crear")';
        document.getElementById('regla-id').value = 0;
        document.getElementById('regla-practica').value = '';
        document.getElementById('regla-recomendacion').value = '';
        document.getElementById('regla-cultivo').value = '';
        document.getElementById('modal-regla-form').classList.remove('hidden');
    }

    function abrirModalEditarRegla(r) {
        document.getElementById('modal-regla-title').innerText = 'Editar Práctica Lunar';
        document.getElementById('form-regla').action = '@Url.Content("~/admin/reglas-lunares/editar")';
        document.getElementById('regla-id').value = r.Id;
        document.getElementById('regla-fase').value = r.FaseLunar;
        document.getElementById('regla-practica').value = r.Practica;
        document.getElementById('regla-recomendacion').value = r.Recomendacion;
        document.getElementById('regla-confianza').value = r.NivelConfianza;
        document.getElementById('regla-cultivo').value = r.CultivoId || '';
        document.getElementById('modal-regla-form').classList.remove('hidden');
    }

    function cerrarModalReglaForm() {
        document.getElementById('modal-regla-form').classList.add('hidden');
    }

    function confirmarEliminarRegla(id, nombre) {
        document.getElementById('regla-id-eliminar').value = id;
        document.getElementById('regla-nombre-eliminar').innerText = nombre;
        document.getElementById('modal-eliminar-regla').classList.remove('hidden');
    }

    function cerrarModalEliminarRegla() {
        document.getElementById('modal-eliminar-regla').classList.add('hidden');
    }
</script>
