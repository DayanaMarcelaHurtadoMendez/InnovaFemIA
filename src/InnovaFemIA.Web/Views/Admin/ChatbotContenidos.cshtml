@model IEnumerable<InnovaFemIA.Web.Features.Admin.GestionContenidosChatbot.ContenidoChatbotAdminDto>
@using InnovaFemIA.Web.Features.Shared.Entities
@{
    ViewData["Title"] = "Catálogo de Contenidos Chatbot — Admin";
    var cultivos = ViewBag.Cultivos as IEnumerable<InnovaFemIA.Web.Features.Mapa.ObtenerCultivos.CultivoDto> ?? [];
    var cultivoSeleccionado = ViewBag.CultivoSeleccionado as int?;
    var temaSeleccionado = ViewBag.TemaSeleccionado as TemaContenido?;

    string FormatearTamano(long bytes)
    {
        if (bytes <= 0) return "0 KB";
        double kb = bytes / 1024.0;
        if (kb < 1024) return $"{kb:F1} KB";
        double mb = kb / 1024.0;
        return $"{mb:F1} MB";
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header y botones de creación -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
            <a href="~/admin/dashboard" class="text-xs text-amber-800 font-bold hover:underline block mb-1">← Volver al Dashboard</a>
            <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
                <span>🤖</span> Catálogo de Contenidos del Chatbot
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">Módulo 2 · Gestión de recursos y materiales educativos digitales</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <a href="~/admin/cultivos" class="px-4 py-3 bg-emerald-50 hover:bg-emerald-100 text-verde text-xs font-bold rounded-2xl border border-emerald-200 transition-all">
                🌱 Catálogo de Cultivos
            </a>
            <button onclick="abrirModalCrearContenido()" class="px-5 py-3 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-2xl shadow-md transition-all">
                + Agregar Recurso
            </button>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-verde px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>✅</span> <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Tabla de Contenidos -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <!-- Vista de Tabla (Solo Desktop) -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 font-bold uppercase text-[10px] tracking-wider">
                        <th class="p-4">Cultivo</th>
                        <th class="p-4">Tema del Chatbot</th>
                        <th class="p-4">Tipo Recurso</th>
                        <th class="p-4">Título del Recurso</th>
                        <th class="p-4">Material / Archivo</th>
                        <th class="p-4 text-center">Orden</th>
                        <th class="p-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 font-bold text-gray-900">🌱 @c.NombreCultivo</td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-900 border border-amber-200">
                                        @switch (c.Tema)
                                        {
                                            case TemaContenido.Siembra: <span>🌱 Siembra</span> break;
                                            case TemaContenido.Cosecha: <span>🌾 Cosecha</span> break;
                                            case TemaContenido.AbonadoNutricion: <span>🧪 Abonado - Nutrición</span> break;
                                            case TemaContenido.PlagasEnfermedades: <span>🐛 Plagas y enfermedades</span> break;
                                            case TemaContenido.PodasManejo: <span>✂️ Podas - Manejo</span> break;
                                            case TemaContenido.Riego: <span>💧 Riego</span> break;
                                            case TemaContenido.PostcosechaAlmacenamiento: <span>📦 Postcosecha - Almacenamiento</span> break;
                                            case TemaContenido.Comercializacion: <span>🏷️ Comercialización</span> break;
                                            default: <span>🌱 @c.Tema</span> break;
                                        }
                                    </span>
                                </td>
                                <td class="p-4">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold @(c.TipoRecurso == TipoRecurso.Video ? "bg-red-50 text-red-700 border border-red-200" : c.TipoRecurso == TipoRecurso.Infografia ? "bg-purple-50 text-purple-700 border border-purple-200" : "bg-blue-50 text-blue-700 border border-blue-200")">
                                        @(c.TipoRecurso == TipoRecurso.Video ? "📺 Video" : c.TipoRecurso == TipoRecurso.Infografia ? "🖼️ Infografía" : "📄 Documento PDF")
                                    </span>
                                </td>
                                <td class="p-4 font-bold text-gray-900 max-w-xs">@c.Titulo</td>
                                <td class="p-4">
                                    @if (c.TieneArchivoEnBd)
                                    {
                                        <div class="flex flex-col gap-1">
                                            <span class="font-bold text-verde text-[11px] truncate max-w-xs flex items-center gap-1">
                                                📦 @(string.IsNullOrEmpty(c.ArchivoNombre) ? "Archivo_Adjunto.dat" : c.ArchivoNombre)
                                                <span class="text-[10px] text-gray-400 font-normal">(@FormatearTamano(c.TamanoBytes))</span>
                                            </span>
                                            <button onclick='abrirVistaPrevia(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="inline-flex items-center gap-1 text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md hover:bg-blue-100 w-fit border border-blue-200">
                                                👁️ Previsualizar Recurso
                                            </button>
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(c.Url))
                                    {
                                        <div class="flex flex-col gap-1">
                                            <button onclick='abrirVistaPrevia(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:underline w-fit">
                                                🔗 @c.Url
                                            </button>
                                            <span class="text-[10px] text-gray-400">Enlace Web</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 italic">No disponible</span>
                                    }
                                </td>
                                <td class="p-4 text-center font-bold text-gray-700">#@c.Orden</td>
                                <td class="p-4 text-right shrink-0">
                                    <div class="inline-flex items-center justify-end gap-2">
                                        <button onclick='abrirModalEditarContenido(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' 
                                                class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 min-w-[84px] bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-bold rounded-xl transition-all border border-amber-200 shadow-sm"
                                                title="Editar contenido educativo">
                                            <span>✏️</span>
                                            <span>Editar</span>
                                        </button>
                                        <button onclick="confirmarEliminarContenido(@c.Id, '@c.Titulo')" 
                                                class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 min-w-[84px] bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold rounded-xl transition-all border border-rose-200 shadow-sm"
                                                title="Eliminar contenido educativo">
                                            <span>🗑️</span>
                                            <span>Eliminar</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-400 italic">
                                No se encontraron recursos educativos registrados en el chatbot.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Vista de Tarjetas (Solo Móvil) -->
        <div class="md:hidden divide-y divide-gray-100">
            @if (Model != null && Model.Any())
            {
                foreach (var c in Model)
                {
                    <div class="p-4 space-y-3 hover:bg-gray-50/50 transition-colors">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <div class="font-bold text-gray-900 text-sm">🌱 @c.NombreCultivo</div>
                                <div class="text-xs font-bold text-gray-900 mt-1 line-clamp-2">@c.Titulo</div>
                            </div>
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold shrink-0 @(c.TipoRecurso == TipoRecurso.Video ? "bg-red-50 text-red-700 border border-red-200" : c.TipoRecurso == TipoRecurso.Infografia ? "bg-purple-50 text-purple-700 border border-purple-200" : "bg-blue-50 text-blue-700 border border-blue-200")">
                                @(c.TipoRecurso == TipoRecurso.Video ? "📺 Video" : c.TipoRecurso == TipoRecurso.Infografia ? "🖼️ Infografía" : "📄 PDF")
                            </span>
                        </div>
                        
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-900 border border-amber-200">
                                @switch (c.Tema)
                                {
                                    case TemaContenido.Siembra: <span>🌱 Siembra</span> break;
                                    case TemaContenido.Cosecha: <span>🌾 Cosecha</span> break;
                                    case TemaContenido.AbonadoNutricion: <span>🧪 Abonado - Nutrición</span> break;
                                    case TemaContenido.PlagasEnfermedades: <span>🐛 Plagas y enfermedades</span> break;
                                    case TemaContenido.PodasManejo: <span>✂️ Podas - Manejo</span> break;
                                    case TemaContenido.Riego: <span>💧 Riego</span> break;
                                    case TemaContenido.PostcosechaAlmacenamiento: <span>📦 Postcosecha - Almacenamiento</span> break;
                                    case TemaContenido.Comercializacion: <span>🏷️ Comercialización</span> break;
                                    default: <span>🌱 @c.Tema</span> break;
                                }
                            </span>
                            <span class="px-2 py-1 rounded-full text-[10px] font-bold bg-gray-100 text-gray-700 border border-gray-200">
                                Orden: #@c.Orden
                            </span>
                        </div>

                        <div class="p-3 bg-gray-50 rounded-xl border border-gray-100">
                            @if (c.TieneArchivoEnBd)
                            {
                                <div class="flex flex-col gap-1.5">
                                    <span class="font-bold text-verde text-[11px] truncate flex items-center gap-1">
                                        📦 @(string.IsNullOrEmpty(c.ArchivoNombre) ? "Archivo_Adjunto.dat" : c.ArchivoNombre)
                                        <span class="text-[10px] text-gray-400 font-normal">(@FormatearTamano(c.TamanoBytes))</span>
                                    </span>
                                    <button onclick='abrirVistaPrevia(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="inline-flex items-center justify-center w-full gap-1 text-[11px] font-bold text-blue-700 bg-blue-50 px-3 py-2 rounded-lg hover:bg-blue-100 border border-blue-200 transition-colors">
                                        👁️ Previsualizar
                                    </button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(c.Url))
                            {
                                <div class="flex flex-col gap-1.5">
                                    <button onclick='abrirVistaPrevia(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:underline break-all text-left">
                                        🔗 @c.Url
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-gray-400 italic text-xs">No disponible</span>
                            }
                        </div>
                        
                        <div class="grid grid-cols-2 gap-2 pt-2">
                            <button onclick='abrirModalEditarContenido(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))' 
                                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-bold rounded-xl transition-all border border-amber-200 shadow-sm">
                                <span>✏️</span>
                                <span>Editar</span>
                            </button>
                            <button onclick="confirmarEliminarContenido(@c.Id, '@c.Titulo')" 
                                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold rounded-xl transition-all border border-rose-200 shadow-sm">
                                <span>🗑️</span>
                                <span>Eliminar</span>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-8 text-center text-gray-400 italic text-sm">
                    No se encontraron recursos educativos registrados en el chatbot.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Visualizador / Previsualización Profesional de Medios (0% CPU/RAM) -->
<div id="modal-vista-previa" class="fixed inset-0 z-50 hidden bg-gray-900/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl border border-gray-100 flex flex-col max-h-[90vh]">
        <div class="bg-gray-900 text-white p-5 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-2">
                <span id="preview-icon" class="text-xl">🎬</span>
                <div>
                    <h3 id="preview-title" class="font-extrabold text-sm text-white">Vista Previa del Recurso</h3>
                    <span id="preview-subtitle" class="text-[11px] text-gray-400">Material Educativo Chatbot</span>
                </div>
            </div>
            <button onclick="cerrarVistaPrevia()" class="text-white hover:text-gray-300 font-bold text-xl px-2">✕</button>
        </div>

        <div class="p-6 overflow-y-auto flex-1 flex items-center justify-center bg-gray-950/90 text-white">
            <div id="preview-content-container" class="w-full flex justify-center">
                <!-- Se inserta dinámicamente HTML5 <video>, <iframe> o <img> -->
            </div>
        </div>

        <div class="p-4 bg-gray-900 border-t border-gray-800 flex items-center justify-between shrink-0 text-xs text-gray-300">
            <span id="preview-filename" class="font-mono text-[11px] text-gray-400 truncate max-w-md"></span>
            <div class="flex items-center gap-3">
                <a id="preview-direct-link" href="#" target="_blank" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all">
                    Abrir en Nueva Pestaña ↗
                </a>
                <button onclick="cerrarVistaPrevia()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold rounded-xl">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Formulario Crear Recurso Chatbot -->
<div id="modal-contenido-form" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-amber-600 text-white p-5 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-white">Agregar Recurso Educativo</h3>
            <button onclick="cerrarModalContenidoForm()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form action="~/admin/chatbot/contenidos/crear" method="POST" enctype="multipart/form-data" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
            @Html.AntiForgeryToken()

            <!-- SECCIÓN 1: Información Básica -->
            <div class="border border-gray-200 rounded-2xl p-4 bg-gray-50/50 space-y-3">
                <h4 class="text-[11px] font-black text-gray-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <span class="text-amber-500">📝</span> Información Básica
                </h4>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-bold text-gray-700">Cultivo Asignado</label>
                            <a href="~/admin/cultivos" target="_blank" class="text-[10px] text-verde font-bold hover:underline">+ Crear</a>
                        </div>
                        <select name="CultivoId" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm">
                            @foreach (var cu in cultivos)
                            {
                                <option value="@cu.Id">@cu.Icono @cu.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tema del Chatbot</label>
                        <select name="Tema" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm">
                            <option value="Siembra">🌱 Siembra</option>
                            <option value="Cosecha">🌾 Cosecha</option>
                            <option value="AbonadoNutricion">🧪 Abonado - Nutrición</option>
                            <option value="PlagasEnfermedades">🐛 Plagas y enfermedades</option>
                            <option value="PodasManejo">✂️ Podas - Manejo</option>
                            <option value="Riego">💧 Riego</option>
                            <option value="PostcosechaAlmacenamiento">📦 Postcosecha - Almacenamiento</option>
                            <option value="Comercializacion">🏷️ Comercialización</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Título del Recurso</label>
                    <input type="text" name="Titulo" required placeholder="Ej: Guía completa de nutrición y siembra de café" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                </div>
            </div>

            <!-- SECCIÓN 2: Multimedia -->
            <div class="bg-amber-50/70 p-4 rounded-2xl border border-amber-200/80 space-y-3 relative">
                <h4 class="text-[11px] font-black text-amber-900 uppercase tracking-wider mb-1 flex items-center gap-2">
                    <span>🎬</span> Archivo o Enlace Web <span class="normal-case text-[10px] font-medium text-amber-700">(Elige solo uno)</span>
                </h4>
                
                <div id="crear-file-container" class="transition-opacity duration-300">
                    <label class="block text-[11px] font-bold text-gray-700 mb-1">1. Cargar Archivo Local (Video, Infografía o PDF)</label>
                    <input type="file" id="crear-archivo" name="archivo" accept=".pdf,.png,.jpg,.jpeg,.mp4,.webm,.mkv" onchange="toggleMutuamenteExcluyente('crear')" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-white shadow-sm" />
                    <span id="crear-file-msg" class="text-[10px] text-gray-500 block mt-1">El sistema detectará automáticamente el tipo de recurso.</span>
                </div>

                <div id="crear-url-container" class="pt-2 border-t border-amber-200/60 transition-opacity duration-300">
                    <label class="block text-[11px] font-bold text-gray-700 mb-1">2. O Ingresar Enlace Externo (YouTube, Vimeo, Drive)</label>
                    <input type="url" id="crear-url" name="Url" placeholder="https://www.youtube.com/watch?v=..." oninput="toggleMutuamenteExcluyente('crear')" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-white shadow-sm" />
                    <span id="crear-url-msg" class="text-[10px] text-gray-500 block mt-1 hidden"></span>
                </div>
            </div>

            <!-- SECCIÓN 3: Atribución y Configuración -->
            <div class="border border-gray-200 rounded-2xl p-4 bg-gray-50/50 space-y-3">
                <h4 class="text-[11px] font-black text-gray-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <span class="text-blue-500">📚</span> Atribución y Configuración
                </h4>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Fuente (Opcional)</label>
                        <input type="text" name="NombreFuente" placeholder="Ej: Universidad Nacional" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Enlace de Fuente (Opcional)</label>
                        <input type="url" name="EnlaceFuente" placeholder="https://unal.edu.co" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-gray-700 mb-1">Orden de Presentación (1 = Primero)</label>
                    <input type="number" name="Orden" value="1" min="1" required class="w-full sm:w-1/3 px-3 py-2 rounded-xl border border-gray-200 text-xs bg-white shadow-sm" />
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalContenidoForm()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-amber-600 text-white font-bold text-xs rounded-xl shadow-md">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Formulario Editar Recurso Chatbot (Con previsualización del archivo/URL actual) -->
<div id="modal-contenido-editar-form" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-100">
        <div class="bg-amber-700 text-white p-5 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-white">Editar Recurso Educativo</h3>
            <button onclick="cerrarModalEditarContenidoForm()" class="text-white hover:text-gray-300 font-bold text-lg">✕</button>
        </div>
        <form action="~/admin/chatbot/contenidos/editar" method="POST" enctype="multipart/form-data" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit-id" name="id" value="" />

            <!-- SECCIÓN 1: Información Básica -->
            <div class="border border-gray-200 rounded-2xl p-4 bg-gray-50/50 space-y-3">
                <h4 class="text-[11px] font-black text-gray-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <span class="text-amber-500">📝</span> Información Básica
                </h4>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Cultivo Asignado</label>
                        <select id="edit-cultivoId" name="cultivoId" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm">
                            @foreach (var cu in cultivos)
                            {
                                <option value="@cu.Id">@cu.Icono @cu.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Tema del Chatbot</label>
                        <select id="edit-tema" name="tema" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm">
                            <option value="Siembra">🌱 Siembra</option>
                            <option value="Cosecha">🌾 Cosecha</option>
                            <option value="AbonadoNutricion">🧪 Abonado - Nutrición</option>
                            <option value="PlagasEnfermedades">🐛 Plagas y enfermedades</option>
                            <option value="PodasManejo">✂️ Podas - Manejo</option>
                            <option value="Riego">💧 Riego</option>
                            <option value="PostcosechaAlmacenamiento">📦 Postcosecha - Almacenamiento</option>
                            <option value="Comercializacion">🏷️ Comercialización</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-gray-700 mb-1">Título del Recurso</label>
                    <input type="text" id="edit-titulo" name="titulo" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                </div>
            </div>

            <!-- SECCIÓN 2: Multimedia -->
            <div class="border border-gray-200 rounded-2xl p-4 bg-gray-50/50 space-y-3">
                <h4 class="text-[11px] font-black text-gray-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <span class="text-blue-500">🎬</span> Archivo o Enlace Web
                </h4>
                
                <!-- Indicador del Archivo o Enlace Actual Cargado -->
                <div id="edit-info-actual" class="p-3 bg-blue-50 border border-blue-200 rounded-xl text-xs space-y-1">
                    <span class="font-extrabold text-blue-900 block">📌 Recurso Guardado Actualmente:</span>
                    <div id="edit-info-actual-detalle" class="text-blue-800 font-bold truncate"></div>
                </div>

                <div class="bg-white p-3 rounded-xl border border-gray-200 space-y-3 relative">
                    <span class="text-[10px] font-extrabold text-gray-500 block uppercase tracking-wider">Reemplazar Recurso (Elige solo uno)</span>
                    
                    <div id="editar-file-container" class="transition-opacity duration-300">
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">1. Cargar Nuevo Archivo Local</label>
                        <input type="file" id="editar-archivo" name="archivo" accept=".pdf,.png,.jpg,.jpeg,.mp4,.webm,.mkv" onchange="toggleMutuamenteExcluyente('editar')" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-gray-50 shadow-inner" />
                        <span id="editar-file-msg" class="text-[10px] text-gray-500 block mt-1">Si subes un archivo, el enlace web será ignorado y el actual descartado.</span>
                    </div>

                    <div id="editar-url-container" class="pt-2 border-t border-gray-100 transition-opacity duration-300">
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">2. O Actualizar Enlace Externo</label>
                        <input type="url" id="editar-url" name="url" placeholder="https://www.youtube.com/watch?v=..." oninput="toggleMutuamenteExcluyente('editar')" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-gray-50 shadow-inner" />
                        <span id="editar-url-msg" class="text-[10px] text-gray-500 block mt-1 hidden"></span>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: Atribución y Configuración -->
            <div class="border border-gray-200 rounded-2xl p-4 bg-gray-50/50 space-y-3">
                <h4 class="text-[11px] font-black text-gray-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <span class="text-emerald-500">⚙️</span> Atribución y Configuración
                </h4>
                
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Fuente (Opcional)</label>
                        <input type="text" id="edit-nombrefuente" name="nombreFuente" placeholder="Ej: Universidad Nacional" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Enlace de Fuente (Opcional)</label>
                        <input type="url" id="edit-enlacefuente" name="enlaceFuente" placeholder="https://unal.edu.co" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-amber-600 bg-white shadow-sm" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 items-center pt-2 border-t border-gray-200/60 mt-2">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-700 mb-1">Orden de Presentación</label>
                        <input type="number" id="edit-orden" name="orden" min="1" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-white shadow-sm" />
                    </div>
                    <div class="pt-4 flex justify-end">
                        <label class="inline-flex items-center gap-2 text-xs font-bold text-gray-700 cursor-pointer bg-white px-3 py-2 rounded-xl border border-gray-200 shadow-sm hover:bg-gray-50 transition-colors">
                            <input type="checkbox" id="edit-activo" name="activo" value="true" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4" />
                            <span>Recurso Activo</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="cerrarModalEditarContenidoForm()" class="px-4 py-2 bg-gray-100 text-gray-700 font-bold text-xs rounded-xl">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-amber-700 text-white font-bold text-xs rounded-xl shadow-md">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar Eliminar -->
<div id="modal-eliminar-contenido" class="fixed inset-0 z-50 hidden bg-gray-900/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-gray-100 space-y-4">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto font-bold">
            🗑️
        </div>
        <h3 class="font-black text-lg text-gray-900">¿Confirmar Eliminación?</h3>
        <p class="text-xs text-gray-500">
            ¿Estás seguro de eliminar el recurso <strong id="contenido-nombre-eliminar" class="text-gray-800"></strong>?
        </p>
        <form action="~/admin/chatbot/contenidos/eliminar" method="POST" class="pt-2 flex justify-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="contenido-id-eliminar" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarContenido()" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow-md hover:bg-rose-700">Sí, Eliminar</button>
        </form>
    </div>
</div>

<script>
    function abrirModalCrearContenido() {
        document.getElementById('crear-archivo').value = '';
        document.getElementById('crear-url').value = '';
        toggleMutuamenteExcluyente('crear');
        document.getElementById('modal-contenido-form').classList.remove('hidden');
    }
    function cerrarModalContenidoForm() {
        document.getElementById('modal-contenido-form').classList.add('hidden');
    }

    function toggleMutuamenteExcluyente(prefix) {
        const fileInput = document.getElementById(`${prefix}-archivo`);
        const urlInput = document.getElementById(`${prefix}-url`);
        const fileContainer = document.getElementById(`${prefix}-file-container`);
        const urlContainer = document.getElementById(`${prefix}-url-container`);
        const urlMsg = document.getElementById(`${prefix}-url-msg`);
        const fileMsg = document.getElementById(`${prefix}-file-msg`);

        // Si hay archivo cargado
        if (fileInput.files.length > 0) {
            urlInput.disabled = true;
            urlContainer.classList.add('opacity-40');
            urlMsg.classList.remove('hidden');
            urlMsg.innerText = "Deshabilitado porque has seleccionado subir un archivo. Borra el archivo si quieres usar un enlace.";
            urlMsg.classList.add('text-rose-500', 'font-bold');
        } else {
            urlInput.disabled = false;
            urlContainer.classList.remove('opacity-40');
            urlMsg.classList.add('hidden');
            urlMsg.classList.remove('text-rose-500', 'font-bold');
        }

        // Si hay URL escrita (y no hay archivo que ya haya bloqueado la URL)
        if (urlInput.value.trim().length > 0 && fileInput.files.length === 0) {
            fileInput.disabled = true;
            fileContainer.classList.add('opacity-40');
            fileMsg.innerText = "Deshabilitado porque has ingresado un enlace web. Borra el enlace si quieres subir un archivo.";
            fileMsg.classList.add('text-rose-500', 'font-bold');
        } else {
            fileInput.disabled = false;
            fileContainer.classList.remove('opacity-40');
            if (prefix === 'crear') {
                fileMsg.innerText = "El sistema detectará automáticamente el tipo de recurso.";
            } else {
                fileMsg.innerText = "Si subes un archivo, el enlace web será ignorado.";
            }
            fileMsg.classList.remove('text-rose-500', 'font-bold');
        }
    }

    function abrirModalEditarContenido(recurso) {
        document.getElementById('edit-id').value = recurso.Id;
        document.getElementById('edit-cultivoId').value = recurso.CultivoId;
        
        // Mapeo Tema
        let temaVal = 'Siembra';
        if (recurso.Tema === 1 || recurso.Tema === 'Siembra' || recurso.Tema === 'CuandoSembrar') temaVal = 'Siembra';
        else if (recurso.Tema === 2 || recurso.Tema === 'Cosecha' || recurso.Tema === 'CuandoCosechar') temaVal = 'Cosecha';
        else if (recurso.Tema === 3 || recurso.Tema === 'AbonadoNutricion' || recurso.Tema === 'Abonado') temaVal = 'AbonadoNutricion';
        else if (recurso.Tema === 4 || recurso.Tema === 'PlagasEnfermedades') temaVal = 'PlagasEnfermedades';
        else if (recurso.Tema === 5 || recurso.Tema === 'PodasManejo' || recurso.Tema === 'PodaMantenimiento' || recurso.Tema === 'ManejoAgroecologico') temaVal = 'PodasManejo';
        else if (recurso.Tema === 6 || recurso.Tema === 'Riego' || recurso.Tema === 'RiegoDrenaje') temaVal = 'Riego';
        else if (recurso.Tema === 7 || recurso.Tema === 'PostcosechaAlmacenamiento' || recurso.Tema === 'PostcosechaManejo') temaVal = 'PostcosechaAlmacenamiento';
        else if (recurso.Tema === 8 || recurso.Tema === 'Comercializacion' || recurso.Tema === 'ComercializacionCalidad') temaVal = 'Comercializacion';
        else temaVal = recurso.Tema;
        document.getElementById('edit-tema').value = temaVal;

        document.getElementById('edit-titulo').value = recurso.Titulo || '';
        document.getElementById('editar-url').value = recurso.Url || '';
        document.getElementById('edit-orden').value = recurso.Orden || 1;
        document.getElementById('edit-activo').checked = recurso.Activo;
        document.getElementById('edit-nombrefuente').value = recurso.NombreFuente || '';
        document.getElementById('edit-enlacefuente').value = recurso.EnlaceFuente || '';

        document.getElementById('editar-archivo').value = '';
        toggleMutuamenteExcluyente('editar');

        // Mostrar información del contenido actual
        const detalleEl = document.getElementById('edit-info-actual-detalle');
        if (recurso.TieneArchivoEnBd) {
            const tamMb = (recurso.TamanoBytes / (1024 * 1024)).toFixed(1);
            detalleEl.innerHTML = `📦 Archivo almacenado: <span>${recurso.ArchivoNombre || 'recurso'}</span> (${tamMb} MB) — <span class="text-xs text-gray-500 font-normal">Se conservará este archivo a menos que subas uno nuevo a continuación.</span>`;
        } else if (recurso.Url) {
            detalleEl.innerHTML = `🔗 Enlace Web actual: <a href="${recurso.Url}" target="_blank" class="underline">${recurso.Url}</a>`;
        } else {
            detalleEl.innerHTML = `⚠️ Sin archivo ni enlace registrado.`;
        }

        document.getElementById('modal-contenido-editar-form').classList.remove('hidden');
    }

    function cerrarModalEditarContenidoForm() {
        document.getElementById('modal-contenido-editar-form').classList.add('hidden');
    }

    function confirmarEliminarContenido(id, titulo) {
        document.getElementById('contenido-id-eliminar').value = id;
        document.getElementById('contenido-nombre-eliminar').innerText = titulo;
        document.getElementById('modal-eliminar-contenido').classList.remove('hidden');
    }
    function cerrarModalEliminarContenido() {
        document.getElementById('modal-eliminar-contenido').classList.add('hidden');
    }

    function abrirVistaPrevia(recurso) {
        const titleEl = document.getElementById('preview-title');
        const iconEl = document.getElementById('preview-icon');
        const filenameEl = document.getElementById('preview-filename');
        const directLinkEl = document.getElementById('preview-direct-link');
        const container = document.getElementById('preview-content-container');

        titleEl.innerText = recurso.Titulo;
        container.innerHTML = '';

        let fileUrl = '';
        if (recurso.TieneArchivoEnBd) {
            fileUrl = `/admin/chatbot/contenidos/${recurso.Id}/archivo`;
            filenameEl.innerText = `Archivo: ${recurso.ArchivoNombre || 'recurso'} (${(recurso.TamanoBytes / (1024 * 1024)).toFixed(1)} MB)`;
        } else {
            fileUrl = recurso.Url;
            filenameEl.innerText = `Enlace: ${recurso.Url}`;
        }
        directLinkEl.href = fileUrl;

        // Tipo Recurso: 1 = Video, 2 = Infografía, 3 = Documento
        if (recurso.TipoRecurso === 1 || (recurso.ArchivoMimeType && recurso.ArchivoMimeType.includes('video'))) {
            iconEl.innerText = '🎬';
            if (recurso.TieneArchivoEnBd || (recurso.Url && (recurso.Url.endsWith('.mp4') || recurso.Url.endsWith('.webm')))) {
                container.innerHTML = `<video controls autoplay class="max-h-[65vh] w-full max-w-3xl rounded-2xl shadow-2xl bg-black"><source src="${fileUrl}" type="${recurso.ArchivoMimeType || 'video/mp4'}">Tu navegador no soporta reproducción de video.</video>`;
            } else if (recurso.Url && (recurso.Url.includes('youtube.com') || recurso.Url.includes('youtu.be'))) {
                let embedUrl = recurso.Url;
                if (recurso.Url.includes('watch?v=')) {
                    embedUrl = recurso.Url.replace('watch?v=', 'embed/');
                } else if (recurso.Url.includes('youtu.be/')) {
                    embedUrl = recurso.Url.replace('youtu.be/', 'www.youtube.com/embed/');
                }
                container.innerHTML = `<iframe src="${embedUrl}" class="w-full h-[60vh] max-w-3xl rounded-2xl shadow-2xl border-0" allowfullscreen></iframe>`;
            } else {
                container.innerHTML = `<iframe src="${fileUrl}" class="w-full h-[60vh] max-w-3xl rounded-2xl shadow-2xl border-0"></iframe>`;
            }
        } else if (recurso.TipoRecurso === 2 || (recurso.ArchivoMimeType && recurso.ArchivoMimeType.includes('image'))) {
            iconEl.innerText = '🖼️';
            container.innerHTML = `<img src="${fileUrl}" alt="${recurso.Titulo}" class="max-h-[65vh] max-w-full object-contain rounded-2xl shadow-2xl border border-gray-800" />`;
        } else {
            iconEl.innerText = '📄';
            container.innerHTML = `<iframe src="${fileUrl}" class="w-full h-[65vh] max-w-4xl rounded-2xl shadow-2xl border-0 bg-white"></iframe>`;
        }

        document.getElementById('modal-vista-previa').classList.remove('hidden');
    }

    function cerrarVistaPrevia() {
        const container = document.getElementById('preview-content-container');
        container.innerHTML = ''; // Detiene el audio/video al cerrar
        document.getElementById('modal-vista-previa').classList.add('hidden');
    }
</script>
