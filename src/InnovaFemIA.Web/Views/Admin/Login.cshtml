@{
    ViewData["Title"] = "Iniciar Sesión — Panel de Administración";
    var returnUrl = ViewBag.ReturnUrl as string;
    var error = ViewBag.Error as string;
}

<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
        
        <div class="text-center">
            <div class="w-16 h-16 rounded-2xl bg-emerald-900 text-emerald-300 flex items-center justify-center text-3xl mx-auto mb-4 font-bold shadow-md">
                🔐
            </div>
            <h2 class="text-2xl font-black text-gray-900">Panel de Administración</h2>
            <p class="mt-1 text-xs text-gray-500">InnovaFemIA · Universidad ICESI & ASCAMPESINA</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-2xl text-xs flex items-center gap-2">
                <span>⚠️</span>
                <span>@error</span>
            </div>
        }

        <form class="mt-6 space-y-5" action="/admin/login" method="POST">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div>
                <label for="usuario" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Usuario Administrador
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">👤</span>
                    <input type="text"
                           id="usuario"
                           name="usuario"
                           required
                           placeholder="Ingresa tu usuario"
                           class="w-full pl-9 pr-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:bg-white transition-all" />
                </div>
            </div>

            <div>
                <label for="contrasena" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Contraseña
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🔑</span>
                    <input type="password"
                           id="contrasena"
                           name="contrasena"
                           required
                           placeholder="••••••••"
                           class="w-full pl-9 pr-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:bg-white transition-all" />
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 px-4 bg-emerald-800 hover:bg-emerald-900 text-white text-sm font-extrabold rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2">
                <span>Acceder al Panel</span> →
            </button>
        </form>

        <div class="pt-4 border-t border-gray-100 text-center text-[11px] text-gray-400">
            Acceso restringido únicamente para personal autorizado del proyecto InnovaFemIA.
        </div>
    </div>
</div>
