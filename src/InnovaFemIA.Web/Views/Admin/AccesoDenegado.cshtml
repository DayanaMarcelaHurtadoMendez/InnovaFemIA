@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="max-w-md w-full text-center bg-white p-8 rounded-3xl shadow-xl border border-gray-100 space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-3xl mx-auto font-bold">
            🚫
        </div>
        <h2 class="text-2xl font-black text-gray-900">Acceso Denegado</h2>
        <p class="text-xs text-gray-600 leading-relaxed">
            No tienes los permisos necesarios de administrador para acceder a esta sección. Por favor inicia sesión con una cuenta autorizada.
        </p>
        <div class="pt-4 flex justify-center gap-3">
            <a href="/admin/login" class="px-5 py-2.5 bg-verde text-white text-xs font-bold rounded-xl hover:bg-verde transition-all">
                Ir al Login
            </a>
            <a href="/" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl hover:bg-gray-200 transition-all">
                Inicio Público
            </a>
        </div>
    </div>
</div>
